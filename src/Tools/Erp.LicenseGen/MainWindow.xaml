<Window x:Class="Erp.LicenseGen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Erp.LicenseGen"
        Title="ErpLicenseGen · Generator de licențe (intern)" Width="1180" Height="780" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:InverseBooleanConverter x:Key="Not"/>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#FAFBFC" Padding="30,14">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="🔑 Chei" Command="{Binding ManageKeysCommand}"/>
                    <Button Content="📂 Deschide o licență" Command="{Binding OpenLicenseCommand}"/>
                    <Button Content="📋 Registrul licențelor" Command="{Binding OpenRegistryCommand}"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Margin="0" Content="Generează licența…" Command="{Binding GenerateCommand}"/>
                <TextBlock Text="{Binding KeyStatus}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,24">
                    <TextBlock Text="Licență nouă" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,16"
                               Text="Fișierul .lic se criptează (AES-256-GCM) și se semnează (ECDSA P-256) cu cheia din acest calculator. Aplicația aceasta nu se livrează niciodată clienților."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Label}" Text="Denumire client *"/>
                            <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Label}" Text="Număr licență"/>
                            <TextBox Text="{Binding LicenseNumber, Mode=OneWay}" IsReadOnly="True" Background="#F3F5F9" FontFamily="Cascadia Mono, Consolas"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Label}" Margin="0,14,0,4"
                               Text="CUI-uri * (câte unul pe rând, sau separate prin virgulă, spațiu ori „:”; cu sau fără RO)"/>
                    <TextBox Text="{Binding FiscalCodesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="104"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas"/>
                    <Border Margin="0,12,0,0" Padding="14,10" Background="#FAFBFC" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Rezultatul validării: " FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding FiscalCodeSummary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LicenseType}" Foreground="#2459C9" Margin="0,4,0,0"/>
                            <TextBlock Text="Se scrie în licență, doar cifre, separate prin „:”" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,2"/>
                            <TextBlock Text="{Binding NormalizedFiscalCodes}" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" Foreground="#2459C9"/>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource Label}" Text="Valabilă până la"/>
                            <DatePicker SelectedDate="{Binding ValidUntil}" IsEnabled="{Binding IsUnlimited, Converter={StaticResource Not}}"/>
                            <CheckBox Content="Nelimitat" IsChecked="{Binding IsUnlimited}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource Label}" Text="Actualizări incluse până la"/>
                            <DatePicker SelectedDate="{Binding UpdatesUntil}" IsEnabled="{Binding UpdatesUnlimited, Converter={StaticResource Not}}"/>
                            <CheckBox Content="Fără limită" IsChecked="{Binding UpdatesUnlimited}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="Tip"/>
                            <TextBox Text="{Binding LicenseType, Mode=OneWay}" IsReadOnly="True" Background="#F3F5F9"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="1" Background="#FBFCFE" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <StackPanel Margin="30,24">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Module" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{Binding ModulesSummary, StringFormat=' · {0}'}" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Modules}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsLocked, Converter={StaticResource Not}}" Margin="0,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Limite" FontWeight="Bold" FontSize="14" Margin="0,20,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource Label}" Text="Utilizatori"/>
                            <TextBox Text="{Binding Users}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource Label}" Text="Angajați salarizare"/>
                            <TextBox Text="{Binding PayrollEmployees}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="Case POS"/>
                            <TextBox Text="{Binding PosTerminals}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
