    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Setup\Erp.Setup.Sql\Erp.Setup.Sql.csproj" />
    <ProjectReference Include="..\..\Shared\Erp.Security.Passwords\Erp.Security.Passwords.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Erp.Setup.Tests" />
  </ItemGroup>

</Project>
