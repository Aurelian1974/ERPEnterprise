<Project Sdk="Microsoft.NET.Sdk">

  <!-- Baza de dezvoltare care se tine singura la zi (07, „Mediul de dezvoltare”): aceiasi pasi SQL ca installer-ul
       (Erp.Setup.Sql), aplicati doar scripturilor schimbate, cu reconstruire cand o migrare aplicata s-a modificat.
       Numai pentru dezvoltare: Erp.Host o refera doar in Debug, deci nu ajunge in kit (Release). -->
