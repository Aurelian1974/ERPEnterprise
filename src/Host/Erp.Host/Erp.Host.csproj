<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UserSecretsId>erp-development</UserSecretsId>
  </PropertyGroup>

  <!-- Configurarea de dezvoltare nu ajunge in kit: in productie configurarea vine din instalare (8.10). -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Erp.Hosting\Erp.Hosting.csproj" />
    <ProjectReference Include="..\..\Auth\Erp.Auth\Erp.Auth.csproj" />
    <ProjectReference Include="..\..\Modules\Core\Erp.Core.Api\Erp.Core.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Core\Erp.Core.Infrastructure\Erp.Core.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Baza de dezvoltare care se tine singura la zi (07, „Mediul de dezvoltare”): numai in Debug. Kitul se publica in
       Release (package-kit.ps1), deci biblioteca si dependentele ei de installer nu ajung niciodata la client. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\..\Tools\Erp.DevDatabase.Sync\Erp.DevDatabase.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <!-- wwwroot e produs de interfata React (src/Web/erp-web, npm run build); nu se pastreaza in Git. Comprimarea se face la
       servire (/assets), deci fara copiile .br/.gz generate la publicare. -->
  <PropertyGroup>
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
