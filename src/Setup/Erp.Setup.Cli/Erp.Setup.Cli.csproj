<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ErpSetup.Cli</AssemblyName>
    <RootNamespace>Erp.Setup.Cli</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Publicat self-contained, single-file, win-x64 (numai la dotnet publish, ca proiectul sa poata fi referit din teste). -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Cheile publice ale kitului (08, 7): -p:KitPublicKey1File=<activa, PEM> si, optional, -p:KitPublicKey2File=<de rezerva, PEM>. -->
  <ItemGroup>
    <EmbeddedResource Include="$(KitPublicKey1File)" LogicalName="Erp.Setup.Cli.KitPublicKey.1.pem" Condition="'$(KitPublicKey1File)' != ''" />
    <EmbeddedResource Include="$(KitPublicKey2File)" LogicalName="Erp.Setup.Cli.KitPublicKey.2.pem" Condition="'$(KitPublicKey2File)' != ''" />
  </ItemGroup>

  <Target Name="RequireKitPublicKeyForRelease" BeforeTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(_IsPublishing)' == 'true' and '$(KitPublicKey1File)' == ''">
    <Error Text="Publicarea Release cere -p:KitPublicKey1File=&lt;cheia publica activa a kitului, PEM&gt;." />
  </Target>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Erp.Setup.Engine\Erp.Setup.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Erp.Setup.Tests" />
  </ItemGroup>

</Project>
