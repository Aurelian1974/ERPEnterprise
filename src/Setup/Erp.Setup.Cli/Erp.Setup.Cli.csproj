<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ErpSetup.Cli</AssemblyName>
    <RootNamespace>Erp.Setup.Cli</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Publicat self-contained, single-file, win-x64 (numai la dotnet publish, ca proiectul sa poata fi referit din teste). -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Cheia publica a kitului (08, 7). Se da la build: -p:KitPublicKeyFile=<cale PEM>. -->
  <ItemGroup Condition="'$(KitPublicKeyFile)' != ''">
    <EmbeddedResource Include="$(KitPublicKeyFile)" LogicalName="Erp.Setup.Cli.KitPublicKey.pem" />
  </ItemGroup>

  <Target Name="RequireKitPublicKeyForRelease" BeforeTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(_IsPublishing)' == 'true' and '$(KitPublicKeyFile)' == ''">
    <Error Text="Publicarea Release a ErpSetup.Cli cere -p:KitPublicKeyFile=&lt;cheia publica a kitului, PEM&gt;." />
  </Target>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Erp.Setup.Engine\Erp.Setup.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Erp.Setup.Tests" />
  </ItemGroup>

</Project>
