<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ErpSetup.exe (08, 5.2): fereastra installer-ului, doar XAML si legaturi; logica e in Erp.Setup.Presentation si Erp.Setup.Engine,
    testabile pe Linux. Kit/templates contine sabloanele copiate in kit (answers.example.json, maintenance.html, app_offline.template.htm).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>ErpSetup</AssemblyName>
    <RootNamespace>Erp.Setup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Cheile publice ale kitului (08, 7): -p:KitPublicKey1File=<activa, PEM> si, optional, -p:KitPublicKey2File=<de rezerva, PEM>. -->
  <ItemGroup>
    <EmbeddedResource Include="$(KitPublicKey1File)" LogicalName="Erp.Setup.KitPublicKey.1.pem" Condition="'$(KitPublicKey1File)' != ''" />
    <EmbeddedResource Include="$(KitPublicKey2File)" LogicalName="Erp.Setup.KitPublicKey.2.pem" Condition="'$(KitPublicKey2File)' != ''" />
  </ItemGroup>

  <Target Name="RequireKitPublicKeyForRelease" BeforeTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(_IsPublishing)' == 'true' and '$(KitPublicKey1File)' == ''">
    <Error Text="Publicarea Release cere -p:KitPublicKey1File=&lt;cheia publica activa a kitului, PEM&gt;." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Erp.Setup.Presentation\Erp.Setup.Presentation.csproj" />
  </ItemGroup>

</Project>
