{
  "name": "erp-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "postinstall": "node scripts/activate-syncfusion.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "api": "node scripts/fetch-openapi.mjs && openapi-typescript openapi/erp-api.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.6",
    "@syncfusion/ej2-base": "35.1.37",
    "@syncfusion/ej2-react-buttons": "35.1.41",
    "@syncfusion/ej2-react-dropdowns": "35.1.46",
    "@syncfusion/ej2-react-grids": "35.1.42",
    "@syncfusion/ej2-react-inputs": "35.1.43",
    "@syncfusion/ej2-react-navigations": "35.1.46",
    "@syncfusion/ej2-react-notifications": "35.1.37",
    "@syncfusion/ej2-react-splitbuttons": "35.1.37",
    "@syncfusion/ej2-tailwind3-theme": "35.1.46",
    "@tanstack/react-query": "5.107.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
