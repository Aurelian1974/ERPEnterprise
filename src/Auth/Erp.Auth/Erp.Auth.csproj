<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Autentificarea (08, 8.7): ASP.NET Core Identity cu store-uri Dapper pe schema ids, cookie, pagini Razor /account/*.
       Database\ = scripturile schemei ids din kit. -->
  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Paleta temei (ST5) are o singura sursa: fisierul aplicatiei React. De aici ajunge activ static al
       bibliotecii si e servit paginilor /account/* ca _content/Erp.Auth/tokens.css, deci nu exista doua palete. -->
  <!-- Un Content cu Link nu are fisier fizic in wwwroot, iar in dezvoltare Host-ul il serveste de acolo (404); de aceea se copiaza
       fizic (wwwroot\tokens.css, ignorat de Git) inainte de descoperirea resurselor statice. -->
  <Target Name="SyncThemeTokens" BeforeTargets="ResolveProjectStaticWebAssets;BeforeBuild">
    <Copy SourceFiles="..\..\Web\erp-web\src\theme\tokens.css" DestinationFiles="wwwroot\tokens.css" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Remove="wwwroot\tokens.css" />
      <Content Include="wwwroot\tokens.css" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Core\Erp.Core.Contracts\Erp.Core.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Erp.Auth.Tests" />
  </ItemGroup>

</Project>
