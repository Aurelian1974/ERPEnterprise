@page "/account/password"
@model PasswordModel
@{
    ViewData["Title"] = T["Password.PageTitle"];
}
@section Left {
    <div class="flow">
        <div class="fs done"><span class="b">✓</span><div><h2>@T["FlowPwd.Step1.Title"]</h2><p>@T["FlowPwd.Step1.Text"]</p></div></div>
        <div class="fs cur"><span class="b">2</span><div><h2>@T["FlowPwd.Step2.Title"]</h2><p>@T["FlowPwd.Step2.Text"]</p></div></div>
        <div class="fs"><span class="b">3</span><div><h2>@T["FlowPwd.Step3.Title"]</h2><p>@T["FlowPwd.Step3.Text"]</p></div></div>
    </div>
    <div class="lm"><p class="lm-title">@T["LeftPwd.Title"]</p><p>@T["LeftPwd.Text"]</p></div>
}
<h1>@T["Password.Title"]</h1>
<p class="sub">@(Model.Forced ? T["Password.SubtitleForced"] : T["Password.Subtitle"])</p>

@if (Model.Errors.Count > 0)
{
    <div class="alert error" role="alert"><ul>@foreach (var error in Model.Errors) { <li>@error</li> }</ul></div>
}

<form method="post" novalidate data-single-submit data-user="@Model.AccountUserName">
    @if (!Model.Forced)
    {
        <div class="field">
            <label for="CurrentPassword">@T["Field.CurrentPassword"]</label>
            <div class="input">
                <input asp-for="CurrentPassword" id="CurrentPassword" type="password" value="" autocomplete="current-password" required>
                <button type="button" class="eye" data-toggle-password="CurrentPassword" data-show="@T["Common.Show"]" data-hide="@T["Common.Hide"]">@T["Common.Show"]</button>
            </div>
            <p class="caps" data-caps-for="CurrentPassword" role="status">@T["Login.CapsLock"]</p>
        </div>
    }
    <div class="field">
        <label for="NewPassword">@T["Field.NewPassword"]</label>
        <div class="input">
            <input asp-for="NewPassword" id="NewPassword" type="password" value="" autocomplete="new-password" required autofocus aria-describedby="password-rules">
            <button type="button" class="eye" data-toggle-password="NewPassword" data-show="@T["Common.Show"]" data-hide="@T["Common.Hide"]">@T["Common.Show"]</button>
        </div>
        <div class="meter" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <div class="mt" id="strength" aria-live="polite" data-weak="@T["Strength.Weak"]" data-medium="@T["Strength.Medium"]" data-strong="@T["Strength.Strong"]"></div>
    </div>
    <ul class="rules" id="password-rules">
        <li data-rule="length">@T["Rule.Length"]</li>
        <li data-rule="case">@T["Rule.Case"]</li>
        <li data-rule="digit">@T["Rule.Digit"]</li>
        <li data-rule="user">@T["Rule.UserName"]</li>
        <li>@T["Rule.History"]</li>
    </ul>
    <div class="field">
        <label for="ConfirmPassword">@T["Field.ConfirmPassword"]</label>
        <div class="input"><input asp-for="ConfirmPassword" id="ConfirmPassword" type="password" value="" autocomplete="new-password" required></div>
    </div>
    <button type="submit" class="btn primary">@T["Password.Submit"]</button>
</form>
<form method="post" asp-page="/Account/Logout"><p class="help">@T["Password.Help"] <button type="submit" class="link-btn">@T["Common.SignOut"]</button></p></form>

@section Scripts {
<script>
    (function () {
        var input = document.getElementById('NewPassword');
        var user = (document.querySelector('[data-user]').getAttribute('data-user') || '').toLowerCase();
        var strength = document.getElementById('strength');
        var checks = {
            length: function (p) { return p.length >= 12; },
            'case': function (p) { return /[a-z]/.test(p) && /[A-Z]/.test(p); },
            digit: function (p) { return /[0-9]/.test(p); },
            user: function (p) { return p.length > 0 && (user.length === 0 || p.toLowerCase().indexOf(user) < 0); }
        };
        input.addEventListener('input', function () {
            var p = input.value, passed = 0;
            Object.keys(checks).forEach(function (rule) {
                var ok = checks[rule](p);
                if (ok) { passed++; }
                var item = document.querySelector('[data-rule="' + rule + '"]');
                item.className = p.length === 0 ? '' : (ok ? 'y' : 'n');
            });
            document.querySelectorAll('.meter i').forEach(function (bar, i) { bar.className = i < passed ? 'on' : ''; });
            strength.textContent = p.length === 0 ? '' : strength.getAttribute(passed === 4 ? 'data-strong' : passed >= 2 ? 'data-medium' : 'data-weak');
        });
    })();
</script>
}
