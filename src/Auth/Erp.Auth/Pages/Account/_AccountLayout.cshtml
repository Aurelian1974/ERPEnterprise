@using Erp.Core.Contracts
@inject ILicenseInfo License
<!doctype html>
<html lang="ro">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="#0b1f3a">
    <meta name="robots" content="noindex">
    <title>@ViewData["Title"]</title>
    @* Paleta temei (ST5): acelasi fisier ca al aplicatiei React, adus ca activ static al bibliotecii. *@
    <link rel="stylesheet" href="/_content/Erp.Auth/tokens.css">
    <style>
        /* Culorile vin numai din tokens.css (UI-13); aici nicio culoare directa (UI-14). */
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { min-height: 100%; font-family: "Inter", "Segoe UI", system-ui, sans-serif; color: var(--ink); background: var(--surface-app); }
        .screen { display: flex; min-height: 100vh; }
        .left { flex: 0 0 60%; position: relative; overflow: hidden; color: var(--on-dark); padding: 56px 64px; display: flex; flex-direction: column;
            background: radial-gradient(1200px 700px at 20% 10%, var(--navy-600) 0%, var(--navy-800) 45%, var(--navy-900) 100%); }
        .grid-bg { position: absolute; inset: 0; z-index: 0; background-size: 48px 48px;
            background-image: linear-gradient(var(--navy-700) 1px, transparent 1px), linear-gradient(90deg, var(--navy-700) 1px, transparent 1px); opacity: .5; }
        .brand { display: flex; align-items: center; gap: 12px; font-weight: 700; font-size: 20px; z-index: 2; }
        .brand .mark { width: 36px; height: 36px; border-radius: 9px; background: linear-gradient(135deg, var(--action), var(--action-hover)); display: grid; place-items: center; font-size: 15px; }
        /* Banda de brand pentru ecrane inguste, unde panoul din stanga nu incape. */
        .brand-band { display: none; align-items: center; gap: 10px; background: var(--navy-800); color: var(--on-dark); padding: 12px 24px; font-weight: 700; }
        .brand-band .mark { width: 28px; height: 28px; border-radius: 8px; background: linear-gradient(135deg, var(--action), var(--action-hover)); display: grid; place-items: center; font-size: 13px; }
        .message { margin-top: auto; z-index: 2; max-width: 640px; }
        .message .headline { font-size: 40px; margin-top: 0; color: var(--on-dark); line-height: 1.15; font-weight: 700; letter-spacing: -.5px; }
        .message p { margin-top: 14px; font-size: 17px; line-height: 1.55; color: var(--on-dark-muted); }
        .badges { display: flex; flex-wrap: wrap; gap: 22px; margin-top: 22px; font-size: 14px; color: var(--on-dark-muted); }
        .badges span::before { content: "✓"; color: var(--ok-on-dark); font-weight: 700; margin-right: 7px; }
        /* Ilustratia decorativa a panoului de brand (macheta 01). */
        .illustration { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
        .ill-card { position: absolute; background: var(--surface-card); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; color: var(--muted); font-size: 12px; box-shadow: var(--shadow-float); }
        .ill-card h3 { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .7px; color: var(--muted); }
        /* Cardurile stau in jumatatea de sus a panoului; jumatatea de jos e a mesajului. */
        .ill-kpi { position: absolute; right: 6%; top: 14%; width: 270px; }
        .ill-kpi .value { color: var(--ink); font-size: 21px; font-weight: 700; margin-top: 8px; }
        .ill-kpi .value small { color: var(--ok); font-size: 12px; font-weight: 700; margin-left: 8px; }
        .ill-kpi .bars { display: flex; align-items: flex-end; gap: 7px; height: 68px; margin-top: 12px; }
        .ill-kpi .bars i { flex: 1; background: var(--line-strong); border-radius: 3px 3px 0 0; }
        .ill-kpi .bars i.hi { background: var(--action); }
        .ill-stock { right: 44%; top: 14%; width: 165px; }
        .ill-ring { width: 74px; height: 74px; border-radius: 50%; margin: 10px auto 0; display: grid; place-items: center; font-weight: 700;
            background: conic-gradient(var(--action) 0 86%, var(--surface-sunken) 86% 100%); }
        .ill-ring span { width: 54px; height: 54px; border-radius: 50%; background: var(--surface-card); color: var(--ink); display: grid; place-items: center; font-size: 13px; }
        .ill-docs { right: 6%; top: 44%; width: 280px; }
        .ill-docs .row { display: flex; justify-content: space-between; gap: 10px; margin-top: 8px; color: var(--ink); }
        .ill-docs .pill { border-radius: 999px; padding: 1px 8px; font-size: 11px; font-weight: 700; background: var(--warn-bg); color: var(--warn); }
        .ill-docs .pill.ok { background: var(--ok-bg); color: var(--ok); }
        .ill-modules { right: 44%; top: 44%; width: 230px; }
        .ill-modules .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
        .ill-modules .chips span { background: var(--info-bg); color: var(--action-hover); border-radius: 999px; padding: 2px 9px; font-size: 11px; font-weight: 600; }
        /* Panoul fluid: sub aceste dimensiuni cardurile ar intra peste text, deci dispar. */
        @@media (max-width: 1320px), (max-height: 760px) { .illustration { display: none; } }
        .lm { margin-top: auto; z-index: 2; max-width: 600px; }
        .lm .lm-title { font-size: 36px; margin-top: 0; color: var(--on-dark); line-height: 1.18; font-weight: 700; letter-spacing: -.5px; }
        .lm p { margin-top: 14px; font-size: 16px; line-height: 1.55; color: var(--on-dark-muted); }
        .flow { z-index: 2; margin-top: 90px; display: flex; flex-direction: column; gap: 14px; max-width: 520px; }
        .fs { display: flex; gap: 16px; align-items: flex-start; background: var(--navy-700); border: 1px solid var(--navy-600); border-radius: 14px; padding: 16px 18px; }
        .fs .b { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; background: var(--navy-600); flex: none; }
        .fs.done .b { background: var(--ok); }
        .fs.cur { background: var(--surface-card); color: var(--ink); border-color: var(--line-strong); }
        .fs.cur .b { background: var(--action); color: var(--on-dark); }
        .fs h2 { font-size: 15px; }
        .fs p { font-size: 13px; color: var(--on-dark-muted); margin-top: 3px; line-height: 1.45; }
        .fs.cur p { color: var(--muted); }
        .right { flex: 1 1 40%; display: flex; flex-direction: column; padding: 40px 64px; min-width: 0; }
        .lang { align-self: flex-end; font-size: 13px; color: var(--muted); background: var(--surface-card); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 6px 10px; }
        .form-wrap { margin: auto 0; width: 100%; max-width: 460px; padding: 24px 0; }
        /* Sigla clientului (macheta 01); fara fisier de siglă, initiala numelui din licenta. */
        .client-logo { width: 104px; min-height: 52px; margin-bottom: 14px; display: grid; place-items: center; background: var(--surface-card); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
        .client-logo img { max-width: 88px; max-height: 44px; display: block; }
        .client-logo .initial { font-size: 22px; font-weight: 700; color: var(--action-hover); }
        .client-name { font-size: 14px; color: var(--muted); margin-bottom: 6px; }
        .form-wrap h1 { font-size: 28px; font-weight: 700; letter-spacing: -.3px; }
        .sub { font-size: 15px; color: var(--muted); margin-top: 6px; margin-bottom: 26px; line-height: 1.45; }
        label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 7px; }
        .field { margin-bottom: 18px; }
        .input { position: relative; }
        .input input { width: 100%; height: 46px; background: var(--surface-input); border: 1px solid var(--line-strong); border-radius: var(--radius); padding: 0 64px 0 14px; font: inherit; font-size: 15px; color: var(--ink); }
        .input input:focus { outline: none; border-color: var(--focus); box-shadow: 0 0 0 3px var(--info-bg); }
        .input .eye { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: 0; color: var(--muted); font: inherit; font-size: 13px; cursor: pointer; }
        /* Avertismentul de Caps Lock: contează la 5 incercari si blocare. */
        .caps { display: none; margin-top: 7px; font-size: 13px; font-weight: 600; color: var(--warn); background: var(--warn-bg); border-radius: var(--radius-sm); padding: 6px 10px; box-shadow: inset 3px 0 0 var(--warn); }
        .caps.on { display: block; }
        .between { display: flex; justify-content: space-between; align-items: center; font-size: 14px; margin: 4px 0 24px; gap: 12px; }
        .check { display: flex; align-items: center; gap: 8px; font-weight: 400; font-size: 14px; margin: 0; cursor: pointer; }
        .check input { width: 18px; height: 18px; accent-color: var(--action); }
        a { color: var(--action-hover); text-decoration: none; font-weight: 600; }
        a:hover, a:focus { text-decoration: underline; }
        .btn { width: 100%; height: 48px; border-radius: var(--radius); display: grid; place-items: center; font: inherit; font-size: 15px; font-weight: 600; border: 0; cursor: pointer; }
        .btn:focus-visible, .eye:focus-visible, .link-btn:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
        .btn[disabled] { cursor: progress; }
        .primary { background: var(--action); color: var(--on-dark); }
        .primary:hover { background: var(--action-hover); }
        .primary[disabled] { background: var(--line-strong); }
        .secondary { background: var(--surface-card); border: 1px solid var(--line-strong); color: var(--ink); }
        .link-btn { background: none; border: 0; color: var(--action-hover); font: inherit; font-weight: 600; cursor: pointer; padding: 0; }
        .help { font-size: 13px; color: var(--muted); margin-top: 26px; text-align: center; line-height: 1.5; }
        /* O stare nu se vede numai din fundal: banda de 3 px o duce (UI-16). */
        .alert { border-radius: var(--radius); padding: 12px 14px; font-size: 14px; margin-bottom: 20px; line-height: 1.45; }
        .alert.error { background: var(--error-bg); color: var(--error); box-shadow: inset 3px 0 0 var(--error); }
        .alert.info { background: var(--info-bg); color: var(--info); box-shadow: inset 3px 0 0 var(--info); }
        .alert ul { margin-left: 18px; }
        .rules { background: var(--surface-input); border: 1px solid var(--line); border-radius: var(--radius); padding: 12px 14px; display: grid; grid-template-columns: 1fr 1fr; gap: 6px 12px; font-size: 13px; margin: 2px 0 20px; list-style: none; }
        .rules li::before { content: "○ "; color: var(--muted); }
        .rules li.y { color: var(--ok); } .rules li.y::before { content: "✓ "; color: var(--ok); }
        .rules li.n { color: var(--error); } .rules li.n::before { content: "✗ "; color: var(--error); }
        .meter { display: flex; gap: 5px; margin-top: 8px; } .meter i { flex: 1; height: 5px; border-radius: 3px; background: var(--surface-sunken); } .meter i.on { background: var(--ok); }
        .mt { font-size: 12px; color: var(--ok); margin-top: 5px; font-weight: 600; min-height: 15px; }
        .stp { font-size: 12px; font-weight: 700; color: var(--action-hover); text-transform: uppercase; letter-spacing: .6px; margin: 18px 0 8px; }
        .qrrow { display: flex; gap: 20px; align-items: flex-start; }
        .qr { width: 150px; height: 150px; padding: 8px; background: var(--surface-input); border: 1px solid var(--line); border-radius: var(--radius); flex: none; }
        .qr svg { width: 100%; height: 100%; }
        .key { font-family: ui-monospace, Consolas, monospace; font-size: 13px; background: var(--surface-input); border-radius: var(--radius-sm); padding: 8px 10px; letter-spacing: 1px; margin-top: 6px; word-break: break-all; }
        /* Selector mai specific decât „.input input”, ca să nu fie nevoie de !important (UI-17). */
        .input input.code-input { letter-spacing: 6px; font-size: 20px; font-weight: 700; }
        .bk { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; font-family: ui-monospace, Consolas, monospace; font-size: 14px; margin-bottom: 14px; }
        .bk span { background: var(--surface-input); border-radius: 6px; padding: 8px 0; text-align: center; }
        .actions { display: flex; gap: 10px; margin-bottom: 14px; }
        .actions .btn { height: 42px; }
        .small { font-size: 13px; color: var(--muted); line-height: 1.5; }
        .footer { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); gap: 12px; }
        .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
        @@media (max-width: 960px) { .left { display: none; } .brand-band { display: flex; } .right { padding: 28px 24px; } .form-wrap { margin: 24px auto; } }
        @@media print { .left, .brand-band, .lang, .footer, .actions, form { display: none !important; } .bk span { border: 1px solid var(--line-strong); } }
    </style>
</head>
<body>
<div class="brand-band"><div class="mark" aria-hidden="true">E</div>@T["Brand"]</div>
<div class="screen">
    <section class="left" aria-hidden="true">
        <div class="grid-bg"></div>
        <div class="brand"><div class="mark">E</div>@T["Brand"]</div>
        @RenderSection("Left", required: false)
        @if (!IsSectionDefined("Left"))
        {
            <div class="message">
                <p class="headline">@T["Left.Headline1"]<br>@T["Left.Headline2"]</p>
                <p>@T["Left.Text"]</p>
                <div class="badges"><span>@T["Left.Badge1"]</span><span>@T["Left.Badge2"]</span><span>@T["Left.Badge3"]</span></div>
            </div>
        }
    </section>
    <main class="right">
        <div class="lang">🌐 @T["Language"]</div>
        <div class="form-wrap">
            @await Html.PartialAsync("_ClientBrand")
            @RenderBody()
        </div>
        <div class="footer"><span>@T["Footer.Version", DateTime.UtcNow.Year, ProductInfo.Version]</span></div>
    </main>
</div>
<script>
    document.querySelectorAll('[data-toggle-password]').forEach(function (button) {
        button.addEventListener('click', function () {
            var input = document.getElementById(button.getAttribute('data-toggle-password'));
            var show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            button.textContent = show ? button.getAttribute('data-hide') : button.getAttribute('data-show');
        });
    });
    // Caps Lock aprins: avertisment la camp de parola, ca o incercare greșită sa nu se consume degeaba.
    document.querySelectorAll('[data-caps-for]').forEach(function (warning) {
        var input = document.getElementById(warning.getAttribute('data-caps-for'));
        if (!input) { return; }
        var update = function (event) {
            if (typeof event.getModifierState !== 'function') { return; }
            warning.classList.toggle('on', event.getModifierState('CapsLock'));
        };
        input.addEventListener('keydown', update);
        input.addEventListener('keyup', update);
        input.addEventListener('blur', function () { warning.classList.remove('on'); });
    });
    // Trimitere o singura data: un dublu clic consuma doua din cele 5 incercari permise.
    document.querySelectorAll('form[data-single-submit]').forEach(function (form) {
        form.addEventListener('submit', function () {
            var button = form.querySelector('button[type=submit]');
            if (!button) { return; }
            button.disabled = true;
            var busy = button.getAttribute('data-busy');
            if (busy) { button.textContent = busy; }
        });
    });
</script>
@RenderSection("Scripts", required: false)
</body>
</html>
