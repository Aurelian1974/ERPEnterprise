<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Installer (INSTALARE_ACTUALIZARE.md, sectiunea 5)">
    <PackageVersion Include="System.CommandLine" Version="2.0.15" />
    <PackageVersion Include="dbup-sqlserver" Version="7.2.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Microsoft.Web.Administration" Version="11.1.0" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="Host si Worker">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <!-- Versiunea Hangfire = scriptul din src/Worker/Erp.Worker/Database/Migrations (test HangfireMigrationMatchesPinnedPackage). -->
    <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
    <PackageVersion Include="Hangfire.SqlServer" Version="1.8.25" />
  </ItemGroup>
  <ItemGroup Label="Teste">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
  </ItemGroup>
</Project>
