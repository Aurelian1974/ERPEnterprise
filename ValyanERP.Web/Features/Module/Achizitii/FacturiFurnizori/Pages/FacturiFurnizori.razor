@page "/module/achizitii/facturi-furnizori"
@inject NavigationManager Navigation

<PageTitle>Facturi Furnizori - ValyanERP</PageTitle>

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>Facturi Furnizori</span>
                </h1>
                <p class="page-subtitle">Gestionați facturile primite de la furnizori</p>
            </div>
            <div class="page-actions">
                <button class="btn btn-primary" @onclick="NavigateToCreate">
                    <i class="bi bi-plus-circle"></i>
                    <span>Factură Nouă</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Page Content -->
    <div class="page-content">
        <div class="content-card">
            <div class="card-body">
                <p class="text-muted">Funcționalitatea pentru gestionarea facturilor furnizori va fi implementată în curând.</p>
            </div>
        </div>
    </div>
</div>

@code {
    private void NavigateToCreate()
    {
        // TODO: Navigate to create form
        Navigation.NavigateTo("/module/achizitii/facturi-furnizori/create");
    }
}