@using ValyanERP.Web.Features.Administrare.TipuriArticole.Models
@using System.ComponentModel.DataAnnotations
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Popups
@using Microsoft.AspNetCore.Components.Forms

<SfDialog Width="400px" IsModal="true" ShowCloseIcon="true" Visible="@IsOpen" Content="DialogContent">
</SfDialog>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public ItemType Model { get; set; } = new ItemType();

    [Parameter]
    public EventCallback<ItemType> OnValidSubmit { get; set; }

    private RenderFragment DialogContent => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "dialog-form-container");

        builder.OpenComponent<EditForm>(seq++);
        builder.AddAttribute(seq++, "Model", Model);
        builder.AddAttribute(seq++, "OnValidSubmit", EventCallback.Factory.Create(this, HandleValidSubmit));
        builder.AddAttribute(seq++, "ChildContent", (RenderFragment)((formBuilder) =>
        {
            var s = 0;
            formBuilder.OpenComponent<DataAnnotationsValidator>(s++);
            formBuilder.CloseComponent();

            // ItemTypeCode
            formBuilder.OpenElement(s++, "div");
            formBuilder.AddAttribute(s++, "class", "form-group");
            formBuilder.AddMarkupContent(s++, "<label class=\"form-label required-field\">Cod</label>");
            formBuilder.OpenComponent<SfTextBox>(s++);
            formBuilder.AddAttribute(s++, "@bind-Value", BindConverter.FormatValue(Model.ItemTypeCode));
            formBuilder.AddAttribute(s++, "ValueChanged", EventCallback.Factory.Create<string>(this, __value => Model.ItemTypeCode = __value));
            formBuilder.AddAttribute(s++, "Placeholder", "Introduceți codul");
            formBuilder.CloseComponent();
            formBuilder.CloseElement();

            // ItemTypeName
            formBuilder.OpenElement(s++, "div");
            formBuilder.AddAttribute(s++, "class", "form-group");
            formBuilder.AddMarkupContent(s++, "<label class=\"form-label required-field\">Denumire</label>");
            formBuilder.OpenComponent<SfTextBox>(s++);
            formBuilder.AddAttribute(s++, "@bind-Value", BindConverter.FormatValue(Model.ItemTypeName));
            formBuilder.AddAttribute(s++, "ValueChanged", EventCallback.Factory.Create<string>(this, __value => Model.ItemTypeName = __value));
            formBuilder.AddAttribute(s++, "Placeholder", "Introduceți denumirea");
            formBuilder.CloseComponent();
            formBuilder.CloseElement();

            // Footer buttons
            formBuilder.OpenElement(s++, "div");
            formBuilder.AddAttribute(s++, "class", "mt-3 text-end");
            formBuilder.OpenElement(s++, "button");
            formBuilder.AddAttribute(s++, "class", "btn btn-secondary me-2");
            formBuilder.AddAttribute(s++, "type", "button");
            formBuilder.AddAttribute(s++, "onclick", EventCallback.Factory.Create(this, Close));
            formBuilder.AddContent(s++, "Anulează");
            formBuilder.CloseElement();

            formBuilder.OpenElement(s++, "button");
            formBuilder.AddAttribute(s++, "class", "btn btn-primary");
            formBuilder.AddAttribute(s++, "type", "submit");
            formBuilder.AddContent(s++, "Salvează");
            formBuilder.CloseElement();

            formBuilder.CloseElement();
        }));
        builder.CloseComponent();

        builder.CloseElement();
    };

    private async Task HandleValidSubmit()
    {
        await OnValidSubmit.InvokeAsync(Model);
        await Close();
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
        StateHasChanged();
    }
}