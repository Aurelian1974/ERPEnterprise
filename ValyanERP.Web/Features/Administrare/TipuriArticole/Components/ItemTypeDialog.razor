@using ValyanERP.Web.Features.Administrare.TipuriArticole.Models
@using System.ComponentModel.DataAnnotations
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Buttons
@using Microsoft.AspNetCore.Components.Forms
@using Syncfusion.Blazor.Inputs.Internal

<SfDialog @bind-Visible="IsOpen"
          Width="450px"
          IsModal="true"
          ShowCloseIcon="true"
          Header="@GetDialogTitle()"
          CssClass="item-type-dialog">
    <DialogTemplates>
        <Content>
            @if (IsLoading)
            {
                <div class="text-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Se încarcă...</span>
                    </div>
                    <p class="mt-2 text-muted">Se salvează...</p>
                </div>
            }
            else
            {
                <EditForm Model="Model" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit" Context="editContext">
                    <DataAnnotationsValidator />

                    <div class="dialog-form-container">
                        @* ItemTypeCode *@
                        <div class="form-group @(GetValidationClass(editContext, Model, nameof(ItemType.ItemTypeCode)))">
                            <label class="form-label required-field">
                                <i class="bi bi-hash me-1"></i>Cod
                            </label>
                            <SfTextBox @bind-Value="@Model.ItemTypeCode"
                                       Placeholder="Introduceți codul tipului de articol"
                                       FloatLabelType="FloatLabelType.Always"
                                       CssClass="@(CombineFieldCss(editContext, Model, nameof(ItemType.ItemTypeCode)))"
                                       Enabled="!IsLoading">
                                <SfTextBoxEvents ValueChange="OnCodeChanged"></SfTextBoxEvents>
                            </SfTextBox>
                            <ValidationMessage For="@(() => Model.ItemTypeCode)" class="validation-error" />
                            @if (IsCodeTaken)
                            {
                                <div class="validation-error">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>Codul este deja folosit
                                </div>
                            }
                        </div>

                        @* ItemTypeName *@
                        <div class="form-group @(GetValidationClass(editContext, Model, nameof(ItemType.ItemTypeName)))">
                            <label class="form-label required-field">
                                <i class="bi bi-card-text me-1"></i>Denumire
                            </label>
                            <SfTextBox @bind-Value="@Model.ItemTypeName"
                                       Placeholder="Introduceți denumirea tipului de articol"
                                       FloatLabelType="FloatLabelType.Always"
                                       CssClass="@(CombineFieldCss(editContext, Model, nameof(ItemType.ItemTypeName)))"
                                       Enabled="!IsLoading">
                            </SfTextBox>
                            <ValidationMessage For="@(() => Model.ItemTypeName)" class="validation-error" />
                        </div>

                        @* Preview *@
                        @if (!string.IsNullOrWhiteSpace(Model.ItemTypeCode) || !string.IsNullOrWhiteSpace(Model.ItemTypeName))
                        {
                            <div class="preview-section">
                                <label class="form-label">
                                    <i class="bi bi-eye me-1"></i>Previzualizare
                                </label>
                                <div class="preview-card">
                                    <div class="preview-code">@(string.IsNullOrWhiteSpace(Model.ItemTypeCode) ? "COD" : Model.ItemTypeCode.ToUpper())</div>
                                    <div class="preview-name">@(string.IsNullOrWhiteSpace(Model.ItemTypeName) ? "Denumire tip articol" : Model.ItemTypeName)</div>
                                </div>
                            </div>
                        }
                    </div>
                </EditForm>
            }
        </Content>
        <FooterTemplate>
            <div class="dialog-footer">
                <SfButton CssClass="e-outline" @onclick="CloseDialog" Disabled="IsLoading">Anulează</SfButton>
                <SfButton CssClass="e-primary" IsPrimary="true" @onclick="SubmitForm" Disabled="IsLoading || IsCodeTaken">
                    @GetSaveButtonText()
                </SfButton>
            </div>
        </FooterTemplate>
    </DialogTemplates>
    <DialogEvents Closed="OnDialogClosed" />
</SfDialog>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public ItemType Model { get; set; } = new ItemType();

    [Parameter]
    public EventCallback<ItemType> OnValidSubmit { get; set; }

    [Parameter]
    public IEnumerable<ItemType> ExistingItems { get; set; } = new List<ItemType>();

    private bool IsLoading { get; set; }
    private bool IsCodeTaken { get; set; }
    private EditContext? editContext;

    private string GetDialogTitle()
    {
        return Model.Id == Guid.Empty ? "Adăugare Tip Articol" : "Editare Tip Articol";
    }

    private string GetSaveButtonText()
    {
        if (IsLoading) return "Se salvează...";
        return Model.Id == Guid.Empty ? "Adaugă" : "Salvează";
    }

    private string GetValidationClass(EditContext editContext, ItemType model, string fieldName)
    {
        var field = editContext.Field(fieldName);
        if (!editContext.IsValid(field))
        {
            return "has-error";
        }
        return string.Empty;
    }

    private string CombineFieldCss(EditContext editContext, ItemType model, string fieldName)
    {
        var baseCss = "form-control";
        var validationClass = GetValidationClass(editContext, model, fieldName);
        return string.IsNullOrEmpty(validationClass) ? baseCss : $"{baseCss} {validationClass}";
    }

    private void OnCodeChanged(string value)
    {
        Model.ItemTypeCode = value?.ToUpper() ?? string.Empty;
        CheckCodeAvailability();
    }

    private void CheckCodeAvailability()
    {
        if (string.IsNullOrWhiteSpace(Model.ItemTypeCode))
        {
            IsCodeTaken = false;
            return;
        }

        IsCodeTaken = ExistingItems.Any(x =>
            x.Id != Model.Id &&
            x.ItemTypeCode.Equals(Model.ItemTypeCode, StringComparison.OrdinalIgnoreCase));
    }

    private async Task HandleValidSubmit()
    {
        if (IsCodeTaken) return;

        IsLoading = true;
        StateHasChanged();

        try
        {
            await OnValidSubmit.InvokeAsync(Model);
            await CloseDialog();
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleInvalidSubmit()
    {
        // Validation failed - stay open
    }

    private async Task SubmitForm()
    {
        if (editContext == null) return;

        var isValid = editContext.Validate();
        if (isValid && !IsCodeTaken)
        {
            await HandleValidSubmit();
        }
    }

    private async Task CloseDialog()
    {
        IsOpen = false;
        IsLoading = false;
        IsCodeTaken = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    private void OnDialogClosed()
    {
        // Reset state if needed
        IsLoading = false;
        IsCodeTaken = false;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        CheckCodeAvailability();
    }
}