@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Buttons

<SfDialog @bind-Visible="IsOpen"
          Width="350px"
          IsModal="true"
          ShowCloseIcon="true"
          Header="@Title"
          CssClass="delete-confirm-dialog">
    <DialogTemplates>
        <Content>
            <div class="confirm-content">
                <div class="confirm-icon">
                    <i class="bi bi-exclamation-triangle-fill text-danger"></i>
                </div>
                <p>@Message</p>
                <div class="confirm-details">
                    <small class="text-muted">Această acțiune nu poate fi anulată.</small>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="dialog-footer">
                <SfButton CssClass="e-outline" @onclick="Cancel">Anulează</SfButton>
                <SfButton CssClass="e-danger" IsPrimary="true" @onclick="Confirm">
                    <i class="bi bi-trash me-1"></i>Șterge
                </SfButton>
            </div>
        </FooterTemplate>
    </DialogTemplates>
    <DialogEvents Closed="OnDialogClosed" />
</SfDialog>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public string Title { get; set; } = "Confirmare ștergere";

    [Parameter]
    public string Message { get; set; } = "Sunteți sigur că doriți să ștergeți această înregistrare?";

    [Parameter]
    public EventCallback<bool> OnConfirmed { get; set; }

    private async Task Confirm()
    {
        await OnConfirmed.InvokeAsync(true);
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    private async Task Cancel()
    {
        await OnConfirmed.InvokeAsync(false);
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    private void OnDialogClosed()
    {
        // Reset state if needed
    }
}