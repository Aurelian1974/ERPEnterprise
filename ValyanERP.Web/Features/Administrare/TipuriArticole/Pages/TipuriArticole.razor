@page "/administrare/tipuri-articole"
@attribute [Authorize]
@rendermode InteractiveServer

@using ValyanERP.Web.Features.Administrare.TipuriArticole.Models
@using ItemTypeModel = ValyanERP.Web.Features.Administrare.TipuriArticole.Models.ItemType
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data

@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Navigations
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using ValyanERP.Web.Features.Administrare.TipuriArticole.Adaptors

@using ValyanERP.Web.Features.Administrare.TipuriArticole.Components

<PageTitle>Tipuri de articole</PageTitle>

<h3>Tipuri de articole</h3>

<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="mb-3 d-flex justify-content-between align-items-center">
            <div>
                <button class="btn btn-primary" @onclick="ShowCreateDialog">Adaugă tip articol</button>
            </div>
            <div>
                <button class="btn btn-outline-secondary me-2" @onclick="CheckDb">Verifică DB</button>
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success mb-0">@successMessage</div>
                }
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mb-0">@errorMessage</div>
                }
                @if (!string.IsNullOrEmpty(debugMessage))
                {
                    <div class="alert alert-info mt-1 mb-0">@debugMessage</div>
                }
            </div>
        </div>
    </Authorized>
</AuthorizeView>

<SfGrid @ref="grid" TValue="ItemTypeModel" DataSource="data" AllowPaging="true" AllowSorting="true" AllowFiltering="true" AllowGrouping="true" AllowResizing="true" EnableHover="true" EnableAltRow="true" Height="calc(100vh - 280px)">

    <GridPageSettings PageSize="10"></GridPageSettings>

    <GridColumns>
        <GridColumn Field="Id" HeaderText="Id" IsPrimaryKey="true" Visible="false"></GridColumn>
        <GridColumn Field="ItemTypeCode" HeaderText="Cod" Width="120"></GridColumn>
        <GridColumn Field="ItemTypeName" HeaderText="Denumire" Width="300"></GridColumn>
        <GridColumn HeaderText="Acțiuni" Width="150">
            <Template>
                <button class="btn btn-sm btn-outline-secondary me-2" @onclick="() => OnEdit(context)">Edit</button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => OnDelete(context)">Delete</button>
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<ItemTypeDialog IsOpen="@dialogOpen" IsOpenChanged="@((bool v) => dialogOpen = v)" Model="@dialogModel" OnValidSubmit="OnDialogSubmit" ExistingItems="@data"></ItemTypeDialog>

<DeleteConfirmDialog IsOpen="@deleteDialogOpen" IsOpenChanged="@((bool v) => deleteDialogOpen = v)" Title="Șterge tip articol" Message="Sunteți sigur că doriți să ștergeți tipul de articol selectat?" OnConfirmed="OnDeleteConfirmed"></DeleteConfirmDialog>