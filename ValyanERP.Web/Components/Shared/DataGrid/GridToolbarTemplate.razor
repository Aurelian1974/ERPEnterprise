@*
    GridToolbarTemplate - Reusable toolbar template for SfGrid
    Features:
    - Standard CRUD buttons (Add, Edit, Delete)
    - Search box
    - Column chooser
    - Excel/PDF export
    - Print
    - Refresh
    - Grid state manager
    
    ⚠️ ALL LOGIC in GridToolbarTemplate.razor.cs (code-behind)
*@

@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs

<div class="grid-toolbar d-flex justify-content-between align-items-center flex-wrap gap-2 p-2">
    @* Left side - Action buttons *@
    <div class="toolbar-left d-flex align-items-center gap-2">
        @if (ShowAddButton)
        {
            <SfButton CssClass="e-small e-primary" IconCss="e-icons e-add" 
                      OnClick="OnAdd" Title="Adaugă înregistrare nouă">
                @if (ShowButtonLabels)
                {
                    <span class="ms-1">Adaugă</span>
                }
            </SfButton>
        }
        
        @if (ShowEditButton)
        {
            <SfButton CssClass="e-small e-outline" IconCss="e-icons e-edit" 
                      OnClick="OnEdit" Title="Editează înregistrarea selectată" Disabled="@(!HasSelection)">
                @if (ShowButtonLabels)
                {
                    <span class="ms-1">Editează</span>
                }
            </SfButton>
        }
        
        @if (ShowDeleteButton)
        {
            <SfButton CssClass="e-small e-outline e-danger" IconCss="e-icons e-delete" 
                      OnClick="OnDelete" Title="Șterge înregistrarea selectată" Disabled="@(!HasSelection)">
                @if (ShowButtonLabels)
                {
                    <span class="ms-1">Șterge</span>
                }
            </SfButton>
        }
        
        @if (ShowRefreshButton)
        {
            <span class="toolbar-separator"></span>
            <SfButton CssClass="e-small e-outline" IconCss="e-icons e-refresh" 
                      OnClick="OnRefresh" Title="Reîmprospătează datele">
            </SfButton>
        }
        
        @* Custom left content *@
        @LeftContent
    </div>
    
    @* Right side - Search and utilities *@
    <div class="toolbar-right d-flex align-items-center gap-2">
        @* Custom right content *@
        @RightContent
        
        @if (ShowSearch)
        {
            <SfTextBox @bind-Value="searchText" Placeholder="Caută..." 
                       CssClass="grid-search-box" Width="200px"
                       @onkeyup="OnSearchKeyUp">
            </SfTextBox>
            <SfButton CssClass="e-small e-outline" IconCss="e-icons e-search" 
                      OnClick="OnSearch" Title="Caută">
            </SfButton>
        }
        
        @if (ShowExcelExport)
        {
            <SfButton CssClass="e-small e-outline" IconCss="e-icons e-export-excel" 
                      OnClick="OnExcelExport" Title="Exportă în Excel">
            </SfButton>
        }
        
        @if (ShowPdfExport)
        {
            <SfButton CssClass="e-small e-outline" IconCss="e-icons e-export-pdf" 
                      OnClick="OnPdfExport" Title="Exportă în PDF">
            </SfButton>
        }
        
        @if (ShowPrint)
        {
            <SfButton CssClass="e-small e-outline" IconCss="e-icons e-print" 
                      OnClick="OnPrint" Title="Imprimă">
            </SfButton>
        }
        
        @if (ShowColumnChooser)
        {
            <SfButton CssClass="e-small e-outline" IconCss="e-icons e-columns" 
                      OnClick="OnColumnChooser" Title="Selectează coloanele">
            </SfButton>
        }
    </div>
</div>
