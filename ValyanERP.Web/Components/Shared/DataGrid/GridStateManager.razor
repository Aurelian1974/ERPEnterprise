@* 
    GridStateManager - Reusable component for managing SfGrid state persistence
    Features:
    - Save/Load grid configuration per user
    - Column visibility, order, width persistence
    - Filter, sort, group state persistence
    - Multiple named configurations support
    
    ⚠️ ALL LOGIC in GridStateManager.razor.cs (code-behind)
*@

@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.DropDowns

<div class="grid-state-manager d-flex align-items-center gap-2">
    @if (ShowConfigurationSelector)
    {
        <SfDropDownList TValue="string" TItem="GridConfiguration" 
                        @bind-Value="selectedConfigName"
                        DataSource="@configurations"
                        Placeholder="Configurație salvată"
                        Width="200px"
                        CssClass="grid-config-dropdown">
            <DropDownListFieldSettings Text="Name" Value="Name"></DropDownListFieldSettings>
            <DropDownListEvents TValue="string" TItem="GridConfiguration" ValueChange="OnConfigurationSelected"></DropDownListEvents>
        </SfDropDownList>
    }
    
    <SfButton CssClass="e-small e-outline" IconCss="e-icons e-save" 
              OnClick="OnSaveConfiguration" Title="Salvează configurația">
        @if (ShowButtonLabels)
        {
            <span class="ms-1">Salvează</span>
        }
    </SfButton>
    
    <SfButton CssClass="e-small e-outline" IconCss="e-icons e-reset" 
              OnClick="OnResetConfiguration" Title="Resetează la implicit">
        @if (ShowButtonLabels)
        {
            <span class="ms-1">Resetează</span>
        }
    </SfButton>
    
    @if (ShowExportButton)
    {
        <SfButton CssClass="e-small e-outline" IconCss="e-icons e-export" 
                  OnClick="OnExportConfiguration" Title="Exportă configurația">
            @if (ShowButtonLabels)
            {
                <span class="ms-1">Export</span>
            }
        </SfButton>
    }
</div>

@* Save Configuration Dialog *@
<SfDialog @bind-Visible="showSaveDialog" Width="400px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header>
            <span class="e-icons e-save me-2"></span>Salvează Configurația
        </Header>
        <Content>
            <div class="mb-3">
                <label class="form-label">Nume configurație</label>
                <input type="text" class="form-control" @bind="newConfigName" 
                       placeholder="ex: Vizualizare simplificată" />
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" @bind="setAsDefault" id="defaultCheck">
                <label class="form-check-label" for="defaultCheck">
                    Setează ca implicit
                </label>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Salvează" IsPrimary="true" OnClick="SaveConfiguration"></DialogButton>
        <DialogButton Content="Anulează" OnClick="CloseSaveDialog"></DialogButton>
    </DialogButtons>
</SfDialog>

