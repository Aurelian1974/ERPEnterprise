@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Buttons

<SfDialog @bind-Visible="@IsVisible" 
          Width="400px" 
          IsModal="true" 
          ShowCloseIcon="true"
          Header="@Title"
          CssClass="@GetDialogCssClass()">
    <DialogTemplates>
        <Content>
            <div class="confirm-content">
                @if (!string.IsNullOrEmpty(IconClass))
                {
                    <div class="confirm-icon">
                        <i class="@IconClass"></i>
                    </div>
                }
                <p>@Message</p>
                @if (!string.IsNullOrEmpty(Details))
                {
                    <div class="confirm-details">
                        <small>@Details</small>
                    </div>
                }
            </div>
        </Content>
        <FooterTemplate>
            <div class="dialog-footer">
                <SfButton CssClass="e-outline" @onclick="OnCancelClick">@CancelText</SfButton>
                <SfButton CssClass="@ConfirmButtonClass" IsPrimary="true" @onclick="OnConfirmClick">@ConfirmText</SfButton>
            </div>
        </FooterTemplate>
    </DialogTemplates>
    <DialogEvents Closed="OnDialogClosed" />
</SfDialog>

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    [Parameter]
    public string Title { get; set; } = "Confirmare";

    [Parameter]
    public string Message { get; set; } = "Sunteți sigur?";

    [Parameter]
    public string? Details { get; set; }

    [Parameter]
    public string ConfirmText { get; set; } = "Da";

    [Parameter]
    public string CancelText { get; set; } = "Anulează";

    [Parameter]
    public string IconClass { get; set; } = "bi bi-question-circle";

    [Parameter]
    public string CssClass { get; set; } = "";

    [Parameter]
    public string ConfirmButtonClass { get; set; } = "e-primary";

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string GetDialogCssClass() => $"confirm-dialog {CssClass}".Trim();

    private async Task OnConfirmClick()
    {
        await OnConfirm.InvokeAsync();
        await CloseDialog();
    }

    private async Task OnCancelClick()
    {
        await OnCancel.InvokeAsync();
        await CloseDialog();
    }

    private async Task CloseDialog()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    private void OnDialogClosed()
    {
        // Reset state if needed
    }
}
