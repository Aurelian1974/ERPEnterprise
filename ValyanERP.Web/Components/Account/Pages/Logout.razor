@page "/Account/Logout"
@inject Microsoft.AspNetCore.Identity.SignInManager<ValyanERP.Web.Infrastructure.Identity.ApplicationUser> SignInManager
@inject NavigationManager NavigationManager
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject ValyanERP.Web.Features.Infrastructure.Sessions.ISessionService SessionService

<PageTitle>Ieșire - ValyanERP</PageTitle>

<div class="d-flex justify-content-center align-items-center" style="min-height:200px;">
    <div>
        <p class="text-muted">Se închide sesiunea...</p>
    </div>
</div>

@code {
    [Inject] private IJSRuntime JSRuntime { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await SignInManager.SignOutAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine("ERROR signing out: " + ex);
        }

        // Invalidate session server-side if cookie present
        try
        {
            var httpContext = HttpContextAccessor?.HttpContext;
            if (httpContext != null)
            {
                var cookie = httpContext.Request.Cookies["ValyanERP.Session"];
                if (!string.IsNullOrWhiteSpace(cookie) && Guid.TryParse(cookie, out var token))
                {
                    await SessionService.InvalidateByTokenAsync(token);
                }

                httpContext.Response.Cookies.Delete("ValyanERP.Session");
            }
            else
            {
                // Fallback: try calling API server-side via HttpClient if needed (omitted for brevity)
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("ERROR invalidating session server-side: " + ex);
        }

        // Redirect to login page
        NavigationManager.NavigateTo("/Account/Login", forceLoad: true);
    }
}