@rendermode InteractiveServer
@using ValyanERP.Web.Features.Infrastructure.Security.Services
@inject IWorkingContextService WorkingContext
@inject IJSRuntime JS

<aside class="@SidebarClass" id="sidebar-wrapper">
    <!-- Sidebar Header with Toggle -->
    <div class="sidebar-header">
        <div class="sidebar-brand">
            <div class="brand-icon">
                <i class="bi bi-layers"></i>
            </div>
            <span class="brand-text">ValyanERP</span>
        </div>
        <button type="button" class="sidebar-toggle" @onclick="ToggleSidebar" title="@(sidebarCollapsed ? "Expand" : "Collapse")">
            <i class="bi @(sidebarCollapsed ? "bi-chevron-right" : "bi-chevron-left")"></i>
        </button>
    </div>

    <!-- Sidebar Navigation -->
    <nav class="sidebar-nav">
        <!-- Dashboard -->
        <NavLink class="nav-item" href="/" Match="NavLinkMatch.All" title="Dashboard">
            <span class="nav-icon">
                <i class="bi bi-grid-fill"></i>
            </span>
            <span class="nav-text">Dashboard</span>
        </NavLink>

        <!-- Administrare Section -->
        <div class="nav-section">
            <button type="button" class="nav-section-header" @onclick="ToggleAdministrare">
                <span class="nav-icon">
                    <i class="bi bi-gear-fill"></i>
                </span>
                <span class="nav-text">Administrare</span>
                <i class="chevron-icon bi @(administrareExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
            </button>
            <div class="nav-submenu @(administrareExpanded ? "expanded" : "")">
                <NavLink class="nav-item submenu-item" href="administrare/utilizatori">
                    <span class="nav-icon">
                        <i class="bi bi-people-fill"></i>
                    </span>
                    <span class="nav-text">Utilizatori</span>
                </NavLink>
                <NavLink class="nav-item submenu-item" href="administrare/persoane">
                    <span class="nav-icon">
                        <i class="bi bi-person-vcard-fill"></i>
                    </span>
                    <span class="nav-text">Persoane</span>
                </NavLink>
                <NavLink class="nav-item submenu-item" href="administrare/parteneri">
                    <span class="nav-icon">
                        <i class="bi bi-people-fill"></i>
                    </span>
                    <span class="nav-text">Parteneri</span>
                </NavLink>

                <!-- Articole Sub-section -->
                <button type="button" class="nav-subsection-header" @onclick="ToggleArticole">
                    <span class="nav-icon">
                        <i class="bi bi-card-text"></i>
                    </span>
                    <span class="nav-text">Articole</span>
                    <i class="chevron-icon bi @(articoleExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                </button>
                <div class="nav-submenu nested @(articoleExpanded ? "expanded" : "")">
                    <NavLink class="nav-item submenu-item" href="administrare/articole">
                        <span class="nav-icon">
                            <i class="bi bi-card-text"></i>
                        </span>
                        <span class="nav-text">Articole</span>
                    </NavLink>
                    <NavLink class="nav-item submenu-item" href="administrare/tipuri-articole">
                        <span class="nav-icon">
                            <i class="bi bi-tags"></i>
                        </span>
                        <span class="nav-text">Tipuri de Articole</span>
                    </NavLink>
                </div>

                <NavLink class="nav-item submenu-item" href="administrare/societatea-proprie">
                    <span class="nav-icon">
                        <i class="bi bi-building-fill"></i>
                    </span>
                    <span class="nav-text">Societatea Proprie</span>
                </NavLink>
                <NavLink class="nav-item submenu-item" href="administrare/parametri-sistem">
                    <span class="nav-icon">
                        <i class="bi bi-sliders"></i>
                    </span>
                    <span class="nav-text">Parametri Sistem</span>
                </NavLink>
                <NavLink class="nav-item submenu-item" href="administrare/audit-logs">
                    <span class="nav-icon">
                        <i class="bi bi-shield-check"></i>
                    </span>
                    <span class="nav-text">Audit Logs</span>
                </NavLink>
                <NavLink class="nav-item submenu-item" href="administrare/permisiuni-organizationale">
                    <span class="nav-icon">
                        <i class="bi bi-diagram-3"></i>
                    </span>
                    <span class="nav-text">Permisiuni Organizaționale</span>
                </NavLink>
            </div>
        </div>

        <!-- Module Section (Placeholder) -->
        <div class="nav-section">
            <button type="button" class="nav-section-header" @onclick="ToggleModule">
                <span class="nav-icon">
                    <i class="bi bi-box-seam-fill"></i>
                </span>
                <span class="nav-text">Module</span>
                <i class="chevron-icon bi @(moduleExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
            </button>
            <div class="nav-submenu @(moduleExpanded ? "expanded" : "")">
                <NavLink class="nav-item submenu-item" href="#">
                    <span class="nav-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </span>
                    <span class="nav-text">Documente</span>
                </NavLink>
                <NavLink class="nav-item submenu-item" href="#">
                    <span class="nav-icon">
                        <i class="bi bi-cash-stack"></i>
                    </span>
                    <span class="nav-text">Financiar</span>
                </NavLink>
            </div>
        </div>

        <!-- Reports -->
        <NavLink class="nav-item" href="#" title="Rapoarte">
            <span class="nav-icon">
                <i class="bi bi-graph-up"></i>
            </span>
            <span class="nav-text">Rapoarte</span>
        </NavLink>

        <!-- Settings -->
        <NavLink class="nav-item" href="#" title="Setări">
            <span class="nav-icon">
                <i class="bi bi-gear"></i>
            </span>
            <span class="nav-text">Setări</span>
        </NavLink>
    </nav>

    <!-- Sidebar Footer -->
    <div class="sidebar-footer">
        @* Working Context Display *@
        @if (WorkingContext.HasContext)
        {
            <div class="working-context-section">
                <div class="working-context-icon">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <div class="working-context-details">
                    <div class="working-context-label">Punct de lucru</div>
                    <div class="working-context-value" title="@WorkingContext.Current.ContextSummary">
                        @WorkingContext.Current.ContextSummary
                    </div>
                </div>
            </div>
        }
        <AuthorizeView>
            <Authorized>
                <div class="user-info">
                    <div class="user-avatar">
                        <i class="bi bi-person-circle"></i>
                    </div>
                    <div class="user-details">
                        <div class="user-name">@context.User.Identity?.Name</div>
                        <a href="Account/Logout" class="logout-link" title="Deconectare">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Ieșire</span>
                        </a>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</aside>

@code {
    private bool sidebarCollapsed = false;
    private bool administrareExpanded = true;
    private bool moduleExpanded = false;
    private bool _contextInitialized = false;

    private string SidebarClass => sidebarCollapsed ? "collapsed" : "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_contextInitialized)
        {
            _contextInitialized = true;
            
            try
            {
                var cookieValue = await JS.InvokeAsync<string?>("getCookie", "ValyanERP.WorkingContext");
                
                if (!string.IsNullOrEmpty(cookieValue))
                {
                    var success = await WorkingContext.InitializeFromCookieAsync(cookieValue);
                    if (success)
                    {
                        await InvokeAsync(StateHasChanged);
                    }
                }
            }
            catch
            {
                // Silently ignore
            }
        }
    }

    private void ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
    }

    private void ToggleAdministrare()
    {
        administrareExpanded = !administrareExpanded;
    }

    private void ToggleModule()
    {
        moduleExpanded = !moduleExpanded;
    }

    // Articole subsection
    private bool articoleExpanded = false;
    private void ToggleArticole()
    {
        articoleExpanded = !articoleExpanded;
    }
}
