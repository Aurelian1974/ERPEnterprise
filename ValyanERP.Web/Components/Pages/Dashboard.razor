@page "/dashboard"
@attribute [Authorize]

<PageTitle>Dashboard - ValyanERP</PageTitle>

<SfDashboardLayout>
    <DashboardLayoutPanels>
        <DashboardLayoutPanel SizeX="6" SizeY="2" Row="0" Col="0">
            <div class="p-3">
                <SfCard>
                    <CardHeader Title="Vânzări" />
                    <CardContent>
                        <span class="fs-4 fw-bold text-primary">0 RON</span>
                    </CardContent>
                </SfCard>
            </div>
        </DashboardLayoutPanel>
        <DashboardLayoutPanel SizeX="6" SizeY="2" Row="0" Col="1">
            <div class="p-3">
                <SfCard>
                    <CardHeader Title="Clienți" />
                    <CardContent>
                        <span class="fs-4 fw-bold text-success">0</span>
                    </CardContent>
                </SfCard>
            </div>
        </DashboardLayoutPanel>
        <DashboardLayoutPanel SizeX="6" SizeY="2" Row="1" Col="0">
            <div class="p-3">
                <SfCard>
                    <CardHeader Title="Produse" />
                    <CardContent>
                        <span class="fs-4 fw-bold text-warning">0</span>
                    </CardContent>
                </SfCard>
            </div>
        </DashboardLayoutPanel>
        <DashboardLayoutPanel SizeX="6" SizeY="2" Row="1" Col="1">
            <div class="p-3">
                <SfCard>
                    <CardHeader Title="Comenzi" />
                    <CardContent>
                        <span class="fs-4 fw-bold text-info">0</span>
                    </CardContent>
                </SfCard>
            </div>
        </DashboardLayoutPanel>
    </DashboardLayoutPanels>
</SfDashboardLayout>

@code {
    // Poți adăuga logica de încărcare date aici
}
