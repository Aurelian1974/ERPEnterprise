@using ValyanERP.Web.Features.Administrare.SocietateaProprie.Models
@using Syncfusion.Blazor.Buttons

<div class="detail-card workplace-card">
    <div class="card-header">
        <div class="entity-icon workplace-icon">
            <i class="bi bi-geo-alt-fill"></i>
        </div>
        <div class="entity-info">
            <h4>@WorkPlace?.Denumire</h4>
            <span class="entity-type">
                @WorkPlace?.TipPunctLucruDescriere
                @if (WorkPlace?.EsteSediuSocial == true)
                {
                    <span class="badge bg-primary ms-2">Sediu Social</span>
                }
            </span>
        </div>
    </div>
    
    <div class="card-body">
        <div class="info-grid">
            @if (!string.IsNullOrEmpty(WorkPlace?.CodONRC))
            {
                <div class="info-item">
                    <label>Cod ONRC</label>
                    <span class="value-highlight">@WorkPlace.CodONRC</span>
                </div>
            }
            <div class="info-item">
                <label>Regim Juridic</label>
                <span>@WorkPlace?.RegimJuridicDescriere</span>
            </div>
        </div>
        
        <div class="info-section">
            <label>Adresa</label>
            <p>@WorkPlace?.AdresaCompleta</p>
        </div>
        
        <div class="info-item">
            <label>Companie</label>
            <span><i class="bi bi-bank me-1"></i>@WorkPlace?.CompanyName (@WorkPlace?.CompanyCUI)</span>
        </div>
        
        <div class="contact-section">
            @if (!string.IsNullOrEmpty(WorkPlace?.Telefon))
            {
                <div class="contact-item">
                    <i class="bi bi-telephone"></i>
                    <span>@WorkPlace.Telefon</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(WorkPlace?.Email))
            {
                <div class="contact-item">
                    <i class="bi bi-envelope"></i>
                    <a href="mailto:@WorkPlace.Email">@WorkPlace.Email</a>
                </div>
            }
        </div>
        
        @if (WorkPlace?.DataInregistrare.HasValue == true || WorkPlace?.DataRadiere.HasValue == true)
        {
            <div class="info-grid">
                @if (WorkPlace.DataInregistrare.HasValue)
                {
                    <div class="info-item">
                        <label>Data Înregistrării</label>
                        <span>@WorkPlace.DataInregistrare.Value.ToString("dd.MM.yyyy")</span>
                    </div>
                }
                @if (WorkPlace.DataRadiere.HasValue)
                {
                    <div class="info-item">
                        <label>Data Radierii</label>
                        <span class="text-danger">@WorkPlace.DataRadiere.Value.ToString("dd.MM.yyyy")</span>
                    </div>
                }
            </div>
        }
        
        <div class="stats-grid">
            <div class="stat-item">
                <i class="bi bi-pin-map"></i>
                <span class="stat-value">@(WorkPlace?.LocationCount ?? 0)</span>
                <span class="stat-label">Locații</span>
            </div>
        </div>
    </div>
    
    <AuthorizeView Roles="Admin">
        <Authorized>
            <div class="card-actions">
                <SfButton CssClass="e-outline e-primary" IconCss="bi bi-pencil" @onclick="OnEdit">
                    Editează
                </SfButton>
                <SfButton CssClass="e-outline" IconCss="bi bi-pin-map-fill" @onclick="OnAddLocation">
                    Adaugă Locație
                </SfButton>
                <SfButton CssClass="e-outline e-danger" IconCss="bi bi-trash" @onclick="OnDelete">
                    Șterge
                </SfButton>
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    [Parameter]
    public WorkPlace? WorkPlace { get; set; }

    [Parameter]
    public EventCallback OnEdit { get; set; }

    [Parameter]
    public EventCallback OnDelete { get; set; }

    [Parameter]
    public EventCallback OnAddLocation { get; set; }
}
