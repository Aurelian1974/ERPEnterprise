@using ValyanERP.Web.Features.Administrare.SocietateaProprie.Models
@using ValyanERP.Web.Features.Administrare.SocietateaProprie.Models.Enums
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.DropDowns

<SfDialog @bind-Visible="@IsVisible" 
          Width="700px" 
          IsModal="true" 
          ShowCloseIcon="true"
          Header="@DialogTitle"
          CssClass="entity-dialog company-dialog">
    <DialogTemplates>
        <Content>
            <div class="dialog-form">
                <div class="form-row">
                    <div class="form-group flex-2">
                        <label class="required">Denumire</label>
                        <SfTextBox @bind-Value="@Model.Denumire" 
                                   Placeholder="Denumirea completă a companiei"
                                   FloatLabelType="FloatLabelType.Never" />
                        @if (!string.IsNullOrEmpty(DenumireError))
                        {
                            <span class="validation-error">@DenumireError</span>
                        }
                    </div>
                    <div class="form-group flex-1">
                        <label>Denumire Scurtă</label>
                        <SfTextBox @bind-Value="@Model.DenumireScurta" 
                                   Placeholder="Abreviere"
                                   FloatLabelType="FloatLabelType.Never" />
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label class="required">CUI</label>
                        <SfTextBox @bind-Value="@Model.CUI" 
                                   Placeholder="RO12345678"
                                   FloatLabelType="FloatLabelType.Never" />
                        @if (!string.IsNullOrEmpty(CUIError))
                        {
                            <span class="validation-error">@CUIError</span>
                        }
                    </div>
                    <div class="form-group">
                        <label>Registrul Comerțului</label>
                        <SfTextBox @bind-Value="@Model.RegCom" 
                                   Placeholder="J40/1234/2020"
                                   FloatLabelType="FloatLabelType.Never" />
                    </div>
                    <div class="form-group">
                        <label>Capital Social (RON)</label>
                        <SfNumericTextBox @bind-Value="@Model.CapitalSocial" 
                                          Format="N2"
                                          Min="0"
                                          Placeholder="0.00" />
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label>Tip Companie</label>
                        <SfDropDownList TValue="TipCompanie" TItem="DropdownItem<TipCompanie>"
                                       @bind-Value="@Model.TipCompanie"
                                       DataSource="@TipCompanieOptions"
                                       Placeholder="Selectați tipul">
                            <DropDownListFieldSettings Text="Text" Value="Value" />
                        </SfDropDownList>
                    </div>
                    <div class="form-group">
                        <label>Grup</label>
                        <SfDropDownList TValue="Guid?" TItem="CompanyGroup"
                                       @bind-Value="@Model.GroupId"
                                       DataSource="@AvailableGroups"
                                       Placeholder="Selectați grupul (opțional)"
                                       AllowFiltering="true">
                            <DropDownListFieldSettings Text="Denumire" Value="Id" />
                        </SfDropDownList>
                    </div>
                </div>
                
                @if (Model.TipCompanie == TipCompanie.Subsidiary)
                {
                    <div class="form-row">
                        <div class="form-group">
                            <label>Companie Părinte</label>
                            <SfDropDownList TValue="Guid?" TItem="Company"
                                           @bind-Value="@Model.ParentCompanyId"
                                           DataSource="@AvailableParentCompanies"
                                           Placeholder="Selectați compania părinte"
                                           AllowFiltering="true">
                                <DropDownListFieldSettings Text="Denumire" Value="Id" />
                            </SfDropDownList>
                        </div>
                        <div class="form-group">
                            <label>Procent Deținere (%)</label>
                            <SfNumericTextBox @bind-Value="@Model.ProcentDetinere" 
                                              Format="N2"
                                              Min="0"
                                              Max="100"
                                              Placeholder="0.00" />
                        </div>
                    </div>
                }
                
                <div class="form-section-title">Contact</div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Telefon</label>
                        <SfTextBox @bind-Value="@Model.Telefon" 
                                   Placeholder="+40..."
                                   FloatLabelType="FloatLabelType.Never" />
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <SfTextBox @bind-Value="@Model.Email" 
                                   Placeholder="contact@company.ro"
                                   FloatLabelType="FloatLabelType.Never" />
                    </div>
                    <div class="form-group">
                        <label>Website</label>
                        <SfTextBox @bind-Value="@Model.Website" 
                                   Placeholder="https://..."
                                   FloatLabelType="FloatLabelType.Never" />
                    </div>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="dialog-footer">
                <SfButton CssClass="e-outline" @onclick="OnCancel">Anulează</SfButton>
                <SfButton CssClass="e-primary" IsPrimary="true" @onclick="OnSave">
                    @(IsEditMode ? "Salvează" : "Adaugă")
                </SfButton>
            </div>
        </FooterTemplate>
    </DialogTemplates>
    <DialogEvents Closed="OnDialogClosed" />
</SfDialog>

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    [Parameter]
    public Company? EditModel { get; set; }

    [Parameter]
    public Guid? PreselectedGroupId { get; set; }

    [Parameter]
    public List<CompanyGroup> AvailableGroups { get; set; } = new();

    [Parameter]
    public List<Company> AvailableParentCompanies { get; set; } = new();

    [Parameter]
    public EventCallback<Company> OnSaved { get; set; }

    private Company Model { get; set; } = new();
    private bool IsEditMode => EditModel?.Id != null && EditModel.Id != Guid.Empty;
    private string DialogTitle => IsEditMode ? "Editare Companie" : "Adaugă Companie Nouă";
    
    private string? DenumireError;
    private string? CUIError;

    private List<DropdownItem<TipCompanie>> TipCompanieOptions = new()
    {
        new() { Value = TipCompanie.Independent, Text = "Independentă" },
        new() { Value = TipCompanie.Holding, Text = "Holding" },
        new() { Value = TipCompanie.Subsidiary, Text = "Subsidiară" }
    };

    protected override void OnParametersSet()
    {
        if (IsVisible)
        {
            if (EditModel != null && EditModel.Id != Guid.Empty)
            {
                Model = new Company
                {
                    Id = EditModel.Id,
                    Denumire = EditModel.Denumire,
                    DenumireScurta = EditModel.DenumireScurta,
                    CUI = EditModel.CUI,
                    RegCom = EditModel.RegCom,
                    CapitalSocial = EditModel.CapitalSocial,
                    TipCompanie = EditModel.TipCompanie,
                    GroupId = EditModel.GroupId,
                    ParentCompanyId = EditModel.ParentCompanyId,
                    ProcentDetinere = EditModel.ProcentDetinere,
                    Telefon = EditModel.Telefon,
                    Email = EditModel.Email,
                    Website = EditModel.Website,
                    IsActive = EditModel.IsActive
                };
            }
            else
            {
                Model = new Company 
                { 
                    IsActive = true,
                    TipCompanie = TipCompanie.Independent,
                    GroupId = PreselectedGroupId
                };
            }
            ClearValidation();
        }
    }

    private bool Validate()
    {
        ClearValidation();
        var isValid = true;

        if (string.IsNullOrWhiteSpace(Model.Denumire))
        {
            DenumireError = "Denumirea este obligatorie";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(Model.CUI))
        {
            CUIError = "CUI este obligatoriu";
            isValid = false;
        }
        else if (!System.Text.RegularExpressions.Regex.IsMatch(Model.CUI, @"^(RO)?[0-9]{2,10}$"))
        {
            CUIError = "Format CUI invalid (ex: RO12345678)";
            isValid = false;
        }

        return isValid;
    }

    private void ClearValidation()
    {
        DenumireError = null;
        CUIError = null;
    }

    private async Task OnSave()
    {
        if (!Validate()) return;

        await OnSaved.InvokeAsync(Model);
        await CloseDialog();
    }

    private async Task OnCancel()
    {
        await CloseDialog();
    }

    private async Task CloseDialog()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    private void OnDialogClosed()
    {
        Model = new Company();
        ClearValidation();
    }

    public class DropdownItem<T>
    {
        public T Value { get; set; } = default!;
        public string Text { get; set; } = string.Empty;
    }
}
