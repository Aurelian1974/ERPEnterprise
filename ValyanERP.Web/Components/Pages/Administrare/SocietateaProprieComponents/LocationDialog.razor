@using ValyanERP.Web.Features.Administrare.SocietateaProprie.Models
@using ValyanERP.Web.Features.Administrare.SocietateaProprie.Models.Enums
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.DropDowns

<SfDialog @bind-Visible="@IsVisible" 
          Width="700px" 
          IsModal="true" 
          ShowCloseIcon="true"
          Header="@DialogTitle"
          CssClass="entity-dialog location-dialog">
    <DialogTemplates>
        <Content>
            <div class="dialog-form">
                <div class="form-row">
                    <div class="form-group flex-2">
                        <label class="required">Denumire</label>
                        <SfTextBox @bind-Value="@Model.Denumire" 
                                   Placeholder="Denumirea locației"
                                   FloatLabelType="FloatLabelType.Never" />
                        @if (!string.IsNullOrEmpty(DenumireError))
                        {
                            <span class="validation-error">@DenumireError</span>
                        }
                    </div>
                    <div class="form-group flex-1">
                        <label class="required">Cod Intern</label>
                        <SfTextBox @bind-Value="@Model.CodIntern" 
                                   Placeholder="LOC001"
                                   FloatLabelType="FloatLabelType.Never" />
                        @if (!string.IsNullOrEmpty(CodInternError))
                        {
                            <span class="validation-error">@CodInternError</span>
                        }
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label class="required">Companie</label>
                        <SfDropDownList TValue="Guid" TItem="Company"
                                       @bind-Value="@Model.CompanyId"
                                       DataSource="@AvailableCompanies"
                                       Placeholder="Selectați compania"
                                       AllowFiltering="true">
                            <DropDownListFieldSettings Text="Denumire" Value="Id" />
                            <DropDownListEvents TValue="Guid" TItem="Company" ValueChange="OnCompanyChanged" />
                        </SfDropDownList>
                        @if (!string.IsNullOrEmpty(CompanyError))
                        {
                            <span class="validation-error">@CompanyError</span>
                        }
                    </div>
                    <div class="form-group">
                        <label>Punct de Lucru</label>
                        <SfDropDownList TValue="Guid?" TItem="WorkPlace"
                                       @bind-Value="@Model.WorkPlaceId"
                                       DataSource="@FilteredWorkPlaces"
                                       Placeholder="Selectați punctul (opțional)"
                                       AllowFiltering="true">
                            <DropDownListFieldSettings Text="Denumire" Value="Id" />
                        </SfDropDownList>
                        <small class="form-hint">Lăsați gol pentru locație independentă (LOC-ONLY)</small>
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label>Tip Locație</label>
                        <SfDropDownList TValue="TipLocatie" TItem="DropdownItem<TipLocatie>"
                                       @bind-Value="@Model.TipLocatie"
                                       DataSource="@TipLocatieOptions"
                                       Placeholder="Selectați tipul">
                            <DropDownListFieldSettings Text="Text" Value="Value" />
                        </SfDropDownList>
                    </div>
                    <div class="form-group">
                        <label>Regim Juridic</label>
                        <SfDropDownList TValue="RegimJuridic" TItem="DropdownItem<RegimJuridic>"
                                       @bind-Value="@Model.RegimJuridic"
                                       DataSource="@RegimJuridicOptions"
                                       Placeholder="Selectați regimul">
                            <DropDownListFieldSettings Text="Text" Value="Value" />
                        </SfDropDownList>
                    </div>
                    <div class="form-group">
                        <label>Suprafață (m²)</label>
                        <SfNumericTextBox TValue="decimal?" @bind-Value="@Model.Suprafata" 
                                          Format="N2"
                                          Min="0"
                                          Placeholder="0.00" />
                    </div>
                </div>
                
                <div class="form-section-title">Adresă (opțional, dacă diferită de punct de lucru)</div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Adresa</label>
                        <SfTextBox @bind-Value="@Model.Adresa" 
                                   Placeholder="Strada, numărul, bloc, apartament"
                                   FloatLabelType="FloatLabelType.Never" />
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label>Localitate</label>
                        <SfTextBox @bind-Value="@Model.Localitate" 
                                   Placeholder="Oraș/Comună"
                                   FloatLabelType="FloatLabelType.Never" />
                    </div>
                    <div class="form-group">
                        <label>Județ</label>
                        <SfTextBox @bind-Value="@Model.Judet" 
                                   Placeholder="Județ"
                                   FloatLabelType="FloatLabelType.Never" />
                    </div>
                    <div class="form-group">
                        <label>Cod Poștal</label>
                        <SfTextBox @bind-Value="@Model.CodPostal" 
                                   Placeholder="000000"
                                   FloatLabelType="FloatLabelType.Never" />
                    </div>
                </div>
                
                <div class="form-group">
                    <label>Descriere</label>
                    <SfTextBox @bind-Value="@Model.Descriere" 
                               Placeholder="Descriere opțională a locației"
                               Multiline="true"
                               FloatLabelType="FloatLabelType.Never" />
                </div>
                
                <div class="form-section-title">Capabilități ERP</div>
                <div class="capabilities-checkboxes">
                    <div class="checkbox-item">
                        <SfCheckBox @bind-Checked="@Model.HasStock" Label="Gestionează Stoc" />
                        <small>Locația poate ține stoc de marfă</small>
                    </div>
                    <div class="checkbox-item">
                        <SfCheckBox @bind-Checked="@Model.CanSell" Label="Permite Vânzări" />
                        <small>Se pot emite facturi de vânzare</small>
                    </div>
                    <div class="checkbox-item">
                        <SfCheckBox @bind-Checked="@Model.CanPurchase" Label="Permite Achiziții" />
                        <small>Se pot înregistra achiziții</small>
                    </div>
                    <div class="checkbox-item">
                        <SfCheckBox @bind-Checked="@Model.CanManufacture" Label="Permite Producție" />
                        <small>Se poate desfășura producție</small>
                    </div>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="dialog-footer">
                <SfButton CssClass="e-outline" @onclick="OnCancel">Anulează</SfButton>
                <SfButton CssClass="e-primary" IsPrimary="true" @onclick="OnSave">
                    @(IsEditMode ? "Salvează" : "Adaugă")
                </SfButton>
            </div>
        </FooterTemplate>
    </DialogTemplates>
    <DialogEvents Closed="OnDialogClosed" />
</SfDialog>

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    [Parameter]
    public Location? EditModel { get; set; }

    [Parameter]
    public Guid? PreselectedCompanyId { get; set; }

    [Parameter]
    public Guid? PreselectedWorkPlaceId { get; set; }

    [Parameter]
    public List<Company> AvailableCompanies { get; set; } = new();

    [Parameter]
    public List<WorkPlace> AvailableWorkPlaces { get; set; } = new();

    [Parameter]
    public EventCallback<Location> OnSaved { get; set; }

    private Location Model { get; set; } = new();
    private List<WorkPlace> FilteredWorkPlaces => AvailableWorkPlaces
        .Where(wp => wp.CompanyId == Model.CompanyId)
        .ToList();
        
    private bool IsEditMode => EditModel?.Id != null && EditModel.Id != Guid.Empty;
    private string DialogTitle => IsEditMode ? "Editare Locație" : "Adaugă Locație Nouă";
    
    private string? DenumireError;
    private string? CodInternError;
    private string? CompanyError;

    private List<DropdownItem<TipLocatie>> TipLocatieOptions = new()
    {
        new() { Value = TipLocatie.Depozit, Text = "Depozit" },
        new() { Value = TipLocatie.Magazin, Text = "Magazin" },
        new() { Value = TipLocatie.Birou, Text = "Birou" },
        new() { Value = TipLocatie.Showroom, Text = "Showroom" },
        new() { Value = TipLocatie.Teren, Text = "Teren" },
        new() { Value = TipLocatie.Service, Text = "Service" },
        new() { Value = TipLocatie.Parcare, Text = "Parcare" },
        new() { Value = TipLocatie.Altele, Text = "Altele" }
    };

    private List<DropdownItem<RegimJuridic>> RegimJuridicOptions = new()
    {
        new() { Value = RegimJuridic.Proprietate, Text = "Proprietate" },
        new() { Value = RegimJuridic.Inchiriere, Text = "Închiriere" },
        new() { Value = RegimJuridic.Comodat, Text = "Comodat" },
        new() { Value = RegimJuridic.Leasing, Text = "Leasing" }
    };

    protected override void OnParametersSet()
    {
        if (IsVisible)
        {
            if (EditModel != null && EditModel.Id != Guid.Empty)
            {
                Model = new Location
                {
                    Id = EditModel.Id,
                    Denumire = EditModel.Denumire,
                    CodIntern = EditModel.CodIntern,
                    CompanyId = EditModel.CompanyId,
                    WorkPlaceId = EditModel.WorkPlaceId,
                    TipLocatie = EditModel.TipLocatie,
                    RegimJuridic = EditModel.RegimJuridic,
                    Suprafata = EditModel.Suprafata,
                    Adresa = EditModel.Adresa,
                    Localitate = EditModel.Localitate,
                    Judet = EditModel.Judet,
                    CodPostal = EditModel.CodPostal,
                    Descriere = EditModel.Descriere,
                    HasStock = EditModel.HasStock,
                    CanSell = EditModel.CanSell,
                    CanPurchase = EditModel.CanPurchase,
                    CanManufacture = EditModel.CanManufacture,
                    IsActive = EditModel.IsActive
                };
            }
            else
            {
                Model = new Location 
                { 
                    IsActive = true,
                    TipLocatie = TipLocatie.Depozit,
                    RegimJuridic = RegimJuridic.Proprietate,
                    HasStock = true,
                    CompanyId = PreselectedCompanyId ?? Guid.Empty,
                    WorkPlaceId = PreselectedWorkPlaceId
                };
            }
            ClearValidation();
        }
    }

    private void OnCompanyChanged(Syncfusion.Blazor.DropDowns.ChangeEventArgs<Guid, Company> args)
    {
        // Reset WorkPlaceId when company changes
        Model.WorkPlaceId = null;
    }

    private bool Validate()
    {
        ClearValidation();
        var isValid = true;

        if (string.IsNullOrWhiteSpace(Model.Denumire))
        {
            DenumireError = "Denumirea este obligatorie";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(Model.CodIntern))
        {
            CodInternError = "Codul intern este obligatoriu";
            isValid = false;
        }
        else if (Model.CodIntern.Length > 20)
        {
            CodInternError = "Codul intern nu poate depăși 20 caractere";
            isValid = false;
        }

        if (Model.CompanyId == Guid.Empty)
        {
            CompanyError = "Compania este obligatorie";
            isValid = false;
        }

        return isValid;
    }

    private void ClearValidation()
    {
        DenumireError = null;
        CodInternError = null;
        CompanyError = null;
    }

    private async Task OnSave()
    {
        if (!Validate()) return;

        await OnSaved.InvokeAsync(Model);
        await CloseDialog();
    }

    private async Task OnCancel()
    {
        await CloseDialog();
    }

    private async Task CloseDialog()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    private void OnDialogClosed()
    {
        Model = new Location();
        ClearValidation();
    }

    public class DropdownItem<T>
    {
        public T Value { get; set; } = default!;
        public string Text { get; set; } = string.Empty;
    }
}
