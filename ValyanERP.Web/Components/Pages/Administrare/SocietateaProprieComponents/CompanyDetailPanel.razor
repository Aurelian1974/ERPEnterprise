@using ValyanERP.Web.Features.Administrare.SocietateaProprie.Models
@using ValyanERP.Web.Features.Administrare.SocietateaProprie.Models.Enums
@using Syncfusion.Blazor.Buttons

<div class="detail-card company-card">
    <div class="card-header">
        <div class="entity-icon company-icon">
            <i class="bi bi-bank"></i>
        </div>
        <div class="entity-info">
            <h4>@Company?.Denumire</h4>
            <span class="entity-type">
                @GetTipCompanieLabel()
                @if (Company?.ProcentDetinere.HasValue == true)
                {
                    <span class="ownership">(@Company.ProcentDetinere%)</span>
                }
            </span>
        </div>
    </div>
    
    <div class="card-body">
        <div class="info-grid">
            <div class="info-item">
                <label>CUI</label>
                <span class="value-highlight">@Company?.CUI</span>
            </div>
            <div class="info-item">
                <label>Reg. Com.</label>
                <span>@(Company?.RegCom ?? "—")</span>
            </div>
            @if (!string.IsNullOrEmpty(Company?.DenumireScurta))
            {
                <div class="info-item">
                    <label>Denumire Scurtă</label>
                    <span>@Company.DenumireScurta</span>
                </div>
            }
            @if (Company?.CapitalSocial.HasValue == true)
            {
                <div class="info-item">
                    <label>Capital Social</label>
                    <span>@Company.CapitalSocial?.ToString("N2") RON</span>
                </div>
            }
        </div>
        
        <div class="info-section">
            <label>Sediu Social</label>
            <p>@(Company?.SediuSocialComplet ?? "Nedefinit - Adăugați un punct de lucru ca sediu social")</p>
        </div>
        
        @if (!string.IsNullOrEmpty(Company?.GroupName))
        {
            <div class="info-item">
                <label>Grup</label>
                <span><i class="bi bi-building me-1"></i>@Company.GroupName</span>
            </div>
        }
        
        @if (!string.IsNullOrEmpty(Company?.ParentCompanyName))
        {
            <div class="info-item">
                <label>Companie Părinte</label>
                <span><i class="bi bi-bank me-1"></i>@Company.ParentCompanyName</span>
            </div>
        }
        
        <div class="contact-section">
            @if (!string.IsNullOrEmpty(Company?.Telefon))
            {
                <div class="contact-item">
                    <i class="bi bi-telephone"></i>
                    <span>@Company.Telefon</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Company?.Email))
            {
                <div class="contact-item">
                    <i class="bi bi-envelope"></i>
                    <a href="mailto:@Company.Email">@Company.Email</a>
                </div>
            }
            @if (!string.IsNullOrEmpty(Company?.Website))
            {
                <div class="contact-item">
                    <i class="bi bi-globe"></i>
                    <a href="@Company.Website" target="_blank">@Company.Website</a>
                </div>
            }
        </div>
        
        <div class="stats-grid">
            <div class="stat-item">
                <i class="bi bi-geo-alt"></i>
                <span class="stat-value">@(Company?.WorkPlaceCount ?? 0)</span>
                <span class="stat-label">Puncte de lucru</span>
            </div>
            <div class="stat-item">
                <i class="bi bi-pin-map"></i>
                <span class="stat-value">@(Company?.LocationCount ?? 0)</span>
                <span class="stat-label">Locații</span>
            </div>
        </div>
    </div>
    
    <AuthorizeView Roles="Admin">
        <Authorized>
            <div class="card-actions">
                <SfButton CssClass="e-outline e-primary" IconCss="bi bi-pencil" @onclick="OnEdit">
                    Editează
                </SfButton>
                <SfButton CssClass="e-outline" IconCss="bi bi-geo-alt-fill" @onclick="OnAddWorkPlace">
                    Adaugă Punct Lucru
                </SfButton>
                <SfButton CssClass="e-outline" IconCss="bi bi-pin-map-fill" @onclick="OnAddLocation">
                    Adaugă Locație
                </SfButton>
                <SfButton CssClass="e-outline e-danger" IconCss="bi bi-trash" @onclick="OnDelete">
                    Șterge
                </SfButton>
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    [Parameter]
    public Company? Company { get; set; }

    [Parameter]
    public EventCallback OnEdit { get; set; }

    [Parameter]
    public EventCallback OnDelete { get; set; }

    [Parameter]
    public EventCallback OnAddWorkPlace { get; set; }

    [Parameter]
    public EventCallback OnAddLocation { get; set; }

    private string GetTipCompanieLabel() => Company?.TipCompanie switch
    {
        TipCompanie.Independent => "Companie Independentă",
        TipCompanie.Holding => "Holding",
        TipCompanie.Subsidiary => "Subsidiară",
        _ => "Companie"
    };
}
