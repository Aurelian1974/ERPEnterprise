@using ValyanERP.Web.Features.Administrare.Parteneri.Models
@using ValyanERP.Web.Features.Administrare.Parteneri.Models.Enums
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Buttons

<div class="partner-detail-panel">
    @* Header *@
    <div class="detail-header">
        <div class="header-info">
            <div class="partner-icon-large">
                <i class="bi @GetPartnerIcon()"></i>
            </div>
            <div class="header-text">
                <h4>@Partner.DenumireAfisare</h4>
                <div class="header-meta">
                    <span class="partner-code">@Partner.Cod</span>
                    <span class="partner-type">@TipuriEntitati.GetTipEntitate(Partner.TipEntitate)?.Denumire</span>
                </div>
            </div>
        </div>
        <div class="header-actions">
            @if (!string.IsNullOrEmpty(Partner.CUI))
            {
                <SfButton CssClass="e-outline" IconCss="bi bi-shield-check" @onclick="() => OnVerifyAnaf.InvokeAsync()">
                    Verifică ANAF
                </SfButton>
            }
            <SfButton CssClass="e-outline" IconCss="bi bi-pencil" @onclick="() => OnEdit.InvokeAsync()">
                Editează
            </SfButton>
            <SfButton CssClass="e-outline e-danger" IconCss="bi bi-trash" @onclick="() => OnDelete.InvokeAsync()">
                Șterge
            </SfButton>
        </div>
    </div>

    @* Status Badges *@
    <div class="status-badges">
        @if (Partner.EsteFurnizor)
        {
            <span class="badge bg-info">Furnizor</span>
        }
        @if (Partner.EsteClient)
        {
            <span class="badge bg-success">Client</span>
        }
        @if (Partner.RolPartener.HasFlag(RolPartener.Colaborator))
        {
            <span class="badge bg-warning">Colaborator</span>
        }
        @if (Partner.EstePlatitorTVA)
        {
            <span class="badge bg-primary">Plătitor TVA</span>
        }
        @if (!Partner.EsteActiv)
        {
            <span class="badge bg-secondary">Inactiv</span>
        }
        @if (Partner.EsteVerificat)
        {
            <span class="badge bg-success">
                <i class="bi bi-patch-check"></i> Verificat ANAF
            </span>
        }
    </div>

    @* Tabs *@
    <SfTab CssClass="detail-tabs">
        <TabItems>
            @* Tab: Date Generale *@
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Date Generale" IconCss="bi bi-info-circle"></TabHeader>
                </ChildContent>
                <ContentTemplate>
                    <div class="tab-content">
                        <div class="info-section">
                            <h6>Identificare</h6>
                            <div class="info-grid">
                                @if (!string.IsNullOrEmpty(Partner.Denumire))
                                {
                                    <div class="info-item">
                                        <label>Denumire</label>
                                        <span>@Partner.Denumire</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Partner.Nume))
                                {
                                    <div class="info-item">
                                        <label>Nume</label>
                                        <span>@Partner.Nume @Partner.Prenume</span>
                                    </div>
                                }
                                <div class="info-item">
                                    <label>Categorie</label>
                                    <span>@TipuriEntitati.GetCategorieName(Partner.Categoria)</span>
                                </div>
                                <div class="info-item">
                                    <label>Tip Entitate</label>
                                    <span>@TipuriEntitati.GetTipEntitate(Partner.TipEntitate)?.Denumire</span>
                                </div>
                            </div>
                        </div>

                        <div class="info-section">
                            <h6>Identificatori Fiscali</h6>
                            <div class="info-grid">
                                @if (!string.IsNullOrEmpty(Partner.CUI))
                                {
                                    <div class="info-item">
                                        <label>CUI</label>
                                        <span class="mono">@Partner.CUI</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Partner.CNP))
                                {
                                    <div class="info-item">
                                        <label>CNP</label>
                                        <span class="mono">@Partner.CNP</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Partner.CIF))
                                {
                                    <div class="info-item">
                                        <label>CIF</label>
                                        <span class="mono">@Partner.CIF</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Partner.VATID))
                                {
                                    <div class="info-item">
                                        <label>VAT ID</label>
                                        <span class="mono">@Partner.VATID</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Partner.RegCom))
                                {
                                    <div class="info-item">
                                        <label>Reg. Comerț</label>
                                        <span class="mono">@Partner.RegCom</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="info-section">
                            <h6>Contact</h6>
                            <div class="info-grid">
                                @if (!string.IsNullOrEmpty(Partner.Email))
                                {
                                    <div class="info-item">
                                        <label>Email</label>
                                        <span><a href="mailto:@Partner.Email">@Partner.Email</a></span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Partner.Telefon))
                                {
                                    <div class="info-item">
                                        <label>Telefon</label>
                                        <span>@Partner.Telefon</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Partner.Website))
                                {
                                    <div class="info-item">
                                        <label>Website</label>
                                        <span><a href="@Partner.Website" target="_blank">@Partner.Website</a></span>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (Partner.LimitaCredit.HasValue || Partner.TermenPlataDef.HasValue)
                        {
                            <div class="info-section">
                                <h6>Condiții Comerciale</h6>
                                <div class="info-grid">
                                    @if (Partner.LimitaCredit.HasValue)
                                    {
                                        <div class="info-item">
                                            <label>Limită Credit</label>
                                            <span>@Partner.LimitaCredit?.ToString("N2") RON</span>
                                        </div>
                                    }
                                    @if (Partner.TermenPlataDef.HasValue)
                                    {
                                        <div class="info-item">
                                            <label>Termen Plată</label>
                                            <span>@Partner.TermenPlataDef zile</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            @* Tab: Adrese *@
            <TabItem>
                <ChildContent>
                    <TabHeader Text="@AddressesTabText" IconCss="bi bi-geo-alt"></TabHeader>
                </ChildContent>
                <ContentTemplate>
                    <div class="tab-content">
                        <div class="tab-header-actions">
                            <SfButton CssClass="e-primary e-small" IconCss="bi bi-plus" @onclick="() => OnAddAddress.InvokeAsync()">
                                Adaugă Adresă
                            </SfButton>
                        </div>
                        
                        @if (!Partner.Addresses.Any())
                        {
                            <div class="empty-list">
                                <i class="bi bi-geo-alt"></i>
                                <p>Nu există adrese înregistrate.</p>
                            </div>
                        }
                        else
                        {
                            <div class="items-list">
                                @foreach (var address in Partner.Addresses.OrderByDescending(a => a.EstePrincipala))
                                {
                                    <div class="list-item @(address.EstePrincipala ? "primary" : "")">
                                        <div class="item-icon">
                                            <i class="bi bi-geo-alt-fill"></i>
                                        </div>
                                        <div class="item-content">
                                            <div class="item-header">
                                                <span class="item-type">@GetAddressTypeName(address.TipAdresa)</span>
                                                @if (address.EstePrincipala)
                                                {
                                                    <span class="badge bg-primary">Principală</span>
                                                }
                                            </div>
                                            <div class="item-text">@address.AdresaCompleta</div>
                                        </div>
                                        <div class="item-actions">
                                            <SfButton CssClass="e-flat e-small" IconCss="bi bi-pencil" 
                                                      @onclick="() => OnEditAddress.InvokeAsync(address)"></SfButton>
                                            <SfButton CssClass="e-flat e-small e-danger" IconCss="bi bi-trash" 
                                                      @onclick="() => OnDeleteAddress.InvokeAsync(address)"></SfButton>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            @* Tab: Contacte *@
            <TabItem>
                <ChildContent>
                    <TabHeader Text="@ContactsTabText" IconCss="bi bi-person-rolodex"></TabHeader>
                </ChildContent>
                <ContentTemplate>
                    <div class="tab-content">
                        <div class="tab-header-actions">
                            <SfButton CssClass="e-primary e-small" IconCss="bi bi-plus" @onclick="() => OnAddContact.InvokeAsync()">
                                Adaugă Contact
                            </SfButton>
                        </div>
                        
                        @if (!Partner.Contacts.Any())
                        {
                            <div class="empty-list">
                                <i class="bi bi-person-rolodex"></i>
                                <p>Nu există persoane de contact.</p>
                            </div>
                        }
                        else
                        {
                            <div class="items-list">
                                @foreach (var contact in Partner.Contacts.OrderByDescending(c => c.EstePrincipal))
                                {
                                    <div class="list-item @(contact.EstePrincipal ? "primary" : "")">
                                        <div class="item-icon">
                                            <i class="bi bi-person-circle"></i>
                                        </div>
                                        <div class="item-content">
                                            <div class="item-header">
                                                <span class="item-name">@contact.NumeComplet</span>
                                                @if (contact.EstePrincipal)
                                                {
                                                    <span class="badge bg-primary">Principal</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(contact.Functie))
                                            {
                                                <div class="item-subtitle">@contact.Functie</div>
                                            }
                                            <div class="item-details">
                                                @if (!string.IsNullOrEmpty(contact.Email))
                                                {
                                                    <span><i class="bi bi-envelope"></i> @contact.Email</span>
                                                }
                                                @if (!string.IsNullOrEmpty(contact.Telefon))
                                                {
                                                    <span><i class="bi bi-telephone"></i> @contact.Telefon</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="item-actions">
                                            <SfButton CssClass="e-flat e-small" IconCss="bi bi-pencil" 
                                                      @onclick="() => OnEditContact.InvokeAsync(contact)"></SfButton>
                                            <SfButton CssClass="e-flat e-small e-danger" IconCss="bi bi-trash" 
                                                      @onclick="() => OnDeleteContact.InvokeAsync(contact)"></SfButton>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            @* Tab: Conturi Bancare *@
            <TabItem>
                <ChildContent>
                    <TabHeader Text="@BankAccountsTabText" IconCss="bi bi-bank"></TabHeader>
                </ChildContent>
                <ContentTemplate>
                    <div class="tab-content">
                        <div class="tab-header-actions">
                            <SfButton CssClass="e-primary e-small" IconCss="bi bi-plus" @onclick="() => OnAddBankAccount.InvokeAsync()">
                                Adaugă Cont
                            </SfButton>
                        </div>
                        
                        @if (!Partner.BankAccounts.Any())
                        {
                            <div class="empty-list">
                                <i class="bi bi-bank"></i>
                                <p>Nu există conturi bancare.</p>
                            </div>
                        }
                        else
                        {
                            <div class="items-list">
                                @foreach (var account in Partner.BankAccounts.OrderByDescending(a => a.EstePrincipal))
                                {
                                    <div class="list-item @(account.EstePrincipal ? "primary" : "")">
                                        <div class="item-icon">
                                            <i class="bi bi-credit-card"></i>
                                        </div>
                                        <div class="item-content">
                                            <div class="item-header">
                                                <span class="item-name mono">@account.IBANFormatat</span>
                                                @if (account.EstePrincipal)
                                                {
                                                    <span class="badge bg-primary">Principal</span>
                                                }
                                                <span class="badge bg-secondary">@account.Moneda</span>
                                            </div>
                                            <div class="item-subtitle">@account.NumeBanca</div>
                                            @if (!string.IsNullOrEmpty(account.Sucursala))
                                            {
                                                <div class="item-details">
                                                    <span>Sucursala: @account.Sucursala</span>
                                                </div>
                                            }
                                        </div>
                                        <div class="item-actions">
                                            <SfButton CssClass="e-flat e-small" IconCss="bi bi-pencil" 
                                                      @onclick="() => OnEditBankAccount.InvokeAsync(account)"></SfButton>
                                            <SfButton CssClass="e-flat e-small e-danger" IconCss="bi bi-trash" 
                                                      @onclick="() => OnDeleteBankAccount.InvokeAsync(account)"></SfButton>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            @* Tab: Reprezentanți *@
            <TabItem>
                <ChildContent>
                    <TabHeader Text="@RepresentativesTabText" IconCss="bi bi-person-vcard"></TabHeader>
                </ChildContent>
                <ContentTemplate>
                    <div class="tab-content">
                        <div class="tab-header-actions">
                            <SfButton CssClass="e-primary e-small" IconCss="bi bi-plus" @onclick="() => OnAddRepresentative.InvokeAsync()">
                                Adaugă Reprezentant
                            </SfButton>
                        </div>
                        
                        @if (!Partner.Representatives.Any())
                        {
                            <div class="empty-list">
                                <i class="bi bi-person-vcard"></i>
                                <p>Nu există reprezentanți legali.</p>
                            </div>
                        }
                        else
                        {
                            <div class="items-list">
                                @foreach (var rep in Partner.Representatives.OrderBy(r => r.TipReprezentant))
                                {
                                    <div class="list-item @(rep.MandatActiv ? "" : "inactive")">
                                        <div class="item-icon">
                                            <i class="bi bi-person-badge"></i>
                                        </div>
                                        <div class="item-content">
                                            <div class="item-header">
                                                <span class="item-name">@rep.NumeComplet</span>
                                                <span class="badge bg-info">@GetRepresentativeTypeName(rep.TipReprezentant)</span>
                                                @if (!rep.MandatActiv)
                                                {
                                                    <span class="badge bg-secondary">Mandat Expirat</span>
                                                }
                                            </div>
                                            <div class="item-subtitle">@rep.Functie</div>
                                            @if (rep.DataNumire.HasValue || rep.DataExpirare.HasValue)
                                            {
                                                <div class="item-details">
                                                    @if (rep.DataNumire.HasValue)
                                                    {
                                                        <span>Din: @rep.DataNumire?.ToString("dd.MM.yyyy")</span>
                                                    }
                                                    @if (rep.DataExpirare.HasValue)
                                                    {
                                                        <span>Până: @rep.DataExpirare?.ToString("dd.MM.yyyy")</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        <div class="item-actions">
                                            <SfButton CssClass="e-flat e-small" IconCss="bi bi-pencil" 
                                                      @onclick="() => OnEditRepresentative.InvokeAsync(rep)"></SfButton>
                                            <SfButton CssClass="e-flat e-small e-danger" IconCss="bi bi-trash" 
                                                      @onclick="() => OnDeleteRepresentative.InvokeAsync(rep)"></SfButton>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>
        </TabItems>
    </SfTab>
</div>

<style>
    .partner-detail-panel {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .detail-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 20px;
        background: linear-gradient(135deg, #f0f9ff, #e0f2fe);
        border-bottom: 1px solid #bae6fd;
    }

    .header-info {
        display: flex;
        gap: 16px;
        align-items: center;
    }

    .partner-icon-large {
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #60a5fa, #3b82f6);
        border-radius: 12px;
        color: white;
        font-size: 24px;
    }

    .header-text h4 {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
        color: #1e3a5f;
    }

    .header-meta {
        display: flex;
        gap: 12px;
        margin-top: 4px;
    }

    .partner-code {
        font-family: 'Consolas', monospace;
        font-size: 13px;
        color: #64748b;
    }

    .partner-type {
        font-size: 13px;
        color: #64748b;
    }

    .header-actions {
        display: flex;
        gap: 8px;
    }

    .status-badges {
        display: flex;
        gap: 8px;
        padding: 12px 20px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        flex-wrap: wrap;
    }

    .detail-tabs {
        flex: 1;
        overflow: hidden;
    }

    .tab-content {
        padding: 16px;
        overflow-y: auto;
        max-height: calc(100vh - 400px);
    }

    .tab-header-actions {
        margin-bottom: 16px;
    }

    .info-section {
        margin-bottom: 24px;
    }

    .info-section h6 {
        font-size: 13px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid #e2e8f0;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
    }

    .info-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .info-item label {
        font-size: 12px;
        color: #64748b;
        font-weight: 500;
    }

    .info-item span {
        font-size: 14px;
        color: #1e293b;
    }

    .info-item .mono {
        font-family: 'Consolas', monospace;
    }

    .empty-list {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 40px;
        color: #64748b;
    }

    .empty-list i {
        font-size: 48px;
        color: #cbd5e1;
        margin-bottom: 16px;
    }

    .items-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .list-item {
        display: flex;
        gap: 12px;
        padding: 12px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        align-items: flex-start;
    }

    .list-item.primary {
        background: #f0f9ff;
        border-color: #93c5fd;
    }

    .list-item.inactive {
        opacity: 0.6;
    }

    .item-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e2e8f0;
        border-radius: 8px;
        color: #64748b;
        font-size: 18px;
        flex-shrink: 0;
    }

    .list-item.primary .item-icon {
        background: linear-gradient(135deg, #93c5fd, #60a5fa);
        color: white;
    }

    .item-content {
        flex: 1;
        min-width: 0;
    }

    .item-header {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .item-name,
    .item-type {
        font-weight: 600;
        font-size: 14px;
        color: #1e293b;
    }

    .item-subtitle {
        font-size: 13px;
        color: #64748b;
        margin-top: 2px;
    }

    .item-text {
        font-size: 14px;
        color: #374151;
        margin-top: 4px;
    }

    .item-details {
        display: flex;
        gap: 16px;
        margin-top: 6px;
        font-size: 12px;
        color: #64748b;
    }

    .item-details i {
        margin-right: 4px;
    }

    .item-actions {
        display: flex;
        gap: 4px;
        flex-shrink: 0;
    }
</style>

@code {
    [Parameter]
    public Partner Partner { get; set; } = default!;

    [Parameter]
    public EventCallback OnEdit { get; set; }

    [Parameter]
    public EventCallback OnDelete { get; set; }

    [Parameter]
    public EventCallback OnVerifyAnaf { get; set; }

    [Parameter]
    public EventCallback OnAddAddress { get; set; }

    [Parameter]
    public EventCallback<PartnerAddress> OnEditAddress { get; set; }

    [Parameter]
    public EventCallback<PartnerAddress> OnDeleteAddress { get; set; }

    [Parameter]
    public EventCallback OnAddContact { get; set; }

    [Parameter]
    public EventCallback<PartnerContact> OnEditContact { get; set; }

    [Parameter]
    public EventCallback<PartnerContact> OnDeleteContact { get; set; }

    [Parameter]
    public EventCallback OnAddBankAccount { get; set; }

    [Parameter]
    public EventCallback<PartnerBankAccount> OnEditBankAccount { get; set; }

    [Parameter]
    public EventCallback<PartnerBankAccount> OnDeleteBankAccount { get; set; }

    [Parameter]
    public EventCallback OnAddRepresentative { get; set; }

    [Parameter]
    public EventCallback<PartnerRepresentative> OnEditRepresentative { get; set; }

    [Parameter]
    public EventCallback<PartnerRepresentative> OnDeleteRepresentative { get; set; }

    // Computed properties for tab headers
    private string AddressesTabText => $"Adrese ({Partner.Addresses.Count})";
    private string ContactsTabText => $"Contacte ({Partner.Contacts.Count})";
    private string BankAccountsTabText => $"Conturi ({Partner.BankAccounts.Count})";
    private string RepresentativesTabText => $"Reprezentanți ({Partner.Representatives.Count})";

    private string GetPartnerIcon()
    {
        return Partner.Categoria switch
        {
            CategoriePartener.PF => "bi-person",
            CategoriePartener.PFA => "bi-person-badge",
            CategoriePartener.SC => "bi-building",
            CategoriePartener.NP => "bi-heart",
            CategoriePartener.IP => "bi-bank",
            CategoriePartener.DIP => "bi-globe",
            CategoriePartener.OI => "bi-globe2",
            CategoriePartener.STR => "bi-airplane",
            CategoriePartener.SP => "bi-star",
            _ => "bi-person-lines-fill"
        };
    }

    private static string GetAddressTypeName(TipAdresa tip)
    {
        return tip switch
        {
            TipAdresa.Sediu => "Sediu Social",
            TipAdresa.Corespondenta => "Corespondență",
            TipAdresa.Livrare => "Livrare",
            TipAdresa.Facturare => "Facturare",
            _ => tip.ToString()
        };
    }

    private static string GetRepresentativeTypeName(TipReprezentant tip)
    {
        return tip switch
        {
            TipReprezentant.Administrator => "Administrator",
            TipReprezentant.Asociat => "Asociat",
            TipReprezentant.Imputernicit => "Împuternicit",
            TipReprezentant.ReprezentantLegal => "Reprezentant Legal",
            _ => tip.ToString()
        };
    }
}
