@using ValyanERP.Web.Features.Administrare.Parteneri.Models
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Buttons

<SfDialog @bind-Visible="IsVisible" Width="600px" IsModal="true" ShowCloseIcon="true"
          CssClass="contact-dialog" AllowDragging="true">
    <DialogTemplates>
        <Header>
            <div class="dialog-header">
                <i class="bi bi-person-rolodex"></i>
                <span>@(IsEdit ? "Editează Contact" : "Adaugă Contact")</span>
            </div>
        </Header>
        <Content>
            <div class="dialog-content">
                <EditForm Model="Model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="form-row">
                        <div class="form-group col-6">
                            <label>Nume <span class="required">*</span></label>
                            <SfTextBox @bind-Value="Model.Nume" Placeholder="Popescu"></SfTextBox>
                        </div>
                        <div class="form-group col-6">
                            <label>Prenume <span class="required">*</span></label>
                            <SfTextBox @bind-Value="Model.Prenume" Placeholder="Ion"></SfTextBox>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-8">
                            <label>Funcție</label>
                            <SfTextBox @bind-Value="Model.Functie" Placeholder="Director Achiziții"></SfTextBox>
                        </div>
                        <div class="form-group col-4">
                            <label>&nbsp;</label>
                            <SfCheckBox @bind-Checked="Model.EstePrincipal" Label="Contact Principal"></SfCheckBox>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-6">
                            <label>Email</label>
                            <SfTextBox @bind-Value="Model.Email" Placeholder="ion.popescu@firma.ro" Type="InputType.Email"></SfTextBox>
                        </div>
                        <div class="form-group col-6">
                            <label>Telefon</label>
                            <SfTextBox @bind-Value="Model.Telefon" Placeholder="+40 721 123 456"></SfTextBox>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-12">
                            <label>Observații</label>
                            <SfTextBox @bind-Value="Model.Observatii" Placeholder="Notițe despre acest contact..."
                                       Multiline="true"></SfTextBox>
                        </div>
                    </div>
                </EditForm>
            </div>
        </Content>
        <FooterTemplate>
            <div class="dialog-footer">
                <SfButton CssClass="e-flat" @onclick="Cancel">Anulează</SfButton>
                <SfButton CssClass="e-primary" @onclick="HandleSubmit">
                    @(IsEdit ? "Salvează" : "Adaugă")
                </SfButton>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    [Parameter]
    public bool IsEdit { get; set; }

    [Parameter]
    public PartnerContact Model { get; set; } = new();

    [Parameter]
    public EventCallback<PartnerContact> OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private async Task HandleSubmit()
    {
        await OnSave.InvokeAsync(Model);
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    private async Task Cancel()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
        await OnCancel.InvokeAsync();
    }
}

<style>
    .contact-dialog .e-dlg-header-content {
        background: linear-gradient(135deg, #93c5fd, #60a5fa);
        padding: 16px 24px;
    }

    .dialog-header {
        display: flex;
        align-items: center;
        gap: 12px;
        color: white;
        font-size: 18px;
        font-weight: 600;
    }

    .dialog-content {
        padding: 20px;
    }

    .form-row {
        display: flex;
        gap: 16px;
        margin-bottom: 16px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .form-group.col-4 { flex: 0 0 calc(33.333% - 11px); }
    .form-group.col-6 { flex: 0 0 calc(50% - 8px); }
    .form-group.col-8 { flex: 0 0 calc(66.666% - 5px); }
    .form-group.col-12 { flex: 0 0 100%; }

    .form-group label {
        font-size: 13px;
        font-weight: 500;
        color: #374151;
    }

    .required { color: #ef4444; }

    .dialog-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 16px 24px;
        border-top: 1px solid #e2e8f0;
    }
</style>
