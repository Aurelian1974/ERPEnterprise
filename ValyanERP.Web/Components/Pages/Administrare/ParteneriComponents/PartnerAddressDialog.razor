@using ValyanERP.Web.Features.Administrare.Parteneri.Models
@using ValyanERP.Web.Features.Administrare.Parteneri.Models.Enums
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Buttons

<SfDialog @bind-Visible="IsVisible" Width="600px" IsModal="true" ShowCloseIcon="true"
          CssClass="address-dialog" AllowDragging="true">
    <DialogTemplates>
        <Header>
            <div class="dialog-header">
                <i class="bi bi-geo-alt"></i>
                <span>@(IsEdit ? "Editează Adresa" : "Adaugă Adresă")</span>
            </div>
        </Header>
        <Content>
            <div class="dialog-content">
                <EditForm Model="Model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="form-row">
                        <div class="form-group col-6">
                            <label>Tip Adresă <span class="required">*</span></label>
                            <SfDropDownList TValue="TipAdresa" TItem="TipAdresaOption"
                                            @bind-Value="Model.TipAdresa"
                                            DataSource="TipAdresaOptions"
                                            Placeholder="Selectează tipul">
                                <DropDownListFieldSettings Value="Value" Text="Text"></DropDownListFieldSettings>
                            </SfDropDownList>
                        </div>
                        <div class="form-group col-6">
                            <label>&nbsp;</label>
                            <SfCheckBox @bind-Checked="Model.EstePrincipala" Label="Adresă Principală"></SfCheckBox>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-12">
                            <label>Adresa Completă <span class="required">*</span></label>
                            <SfTextBox @bind-Value="Model.Adresa" Placeholder="Strada, număr, bloc, scară, etaj, apartament"
                                       Multiline="true"></SfTextBox>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-6">
                            <label>Localitate <span class="required">*</span></label>
                            <SfTextBox @bind-Value="Model.Localitate" Placeholder="București"></SfTextBox>
                        </div>
                        <div class="form-group col-6">
                            <label>Județ / Sector <span class="required">*</span></label>
                            <SfTextBox @bind-Value="Model.Judet" Placeholder="Sector 1"></SfTextBox>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-4">
                            <label>Cod Poștal</label>
                            <SfTextBox @bind-Value="Model.CodPostal" Placeholder="010101"></SfTextBox>
                        </div>
                        <div class="form-group col-8">
                            <label>Țara <span class="required">*</span></label>
                            <SfTextBox @bind-Value="Model.Tara" Placeholder="România"></SfTextBox>
                        </div>
                    </div>
                </EditForm>
            </div>
        </Content>
        <FooterTemplate>
            <div class="dialog-footer">
                <SfButton CssClass="e-flat" @onclick="Cancel">Anulează</SfButton>
                <SfButton CssClass="e-primary" @onclick="HandleSubmit">
                    @(IsEdit ? "Salvează" : "Adaugă")
                </SfButton>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    [Parameter]
    public bool IsEdit { get; set; }

    [Parameter]
    public PartnerAddress Model { get; set; } = new() { Tara = "România" };

    [Parameter]
    public EventCallback<PartnerAddress> OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private List<TipAdresaOption> TipAdresaOptions => Enum.GetValues<TipAdresa>()
        .Select(t => new TipAdresaOption
        {
            Value = t,
            Text = t switch
            {
                TipAdresa.Sediu => "Sediu Social",
                TipAdresa.Corespondenta => "Corespondență",
                TipAdresa.Livrare => "Livrare",
                TipAdresa.Facturare => "Facturare",
                _ => t.ToString()
            }
        })
        .ToList();

    private async Task HandleSubmit()
    {
        await OnSave.InvokeAsync(Model);
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    private async Task Cancel()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
        await OnCancel.InvokeAsync();
    }

    public class TipAdresaOption
    {
        public TipAdresa Value { get; set; }
        public string Text { get; set; } = string.Empty;
    }
}

<style>
    .address-dialog .e-dlg-header-content {
        background: linear-gradient(135deg, #93c5fd, #60a5fa);
        padding: 16px 24px;
    }

    .dialog-header {
        display: flex;
        align-items: center;
        gap: 12px;
        color: white;
        font-size: 18px;
        font-weight: 600;
    }

    .dialog-content {
        padding: 20px;
    }

    .form-row {
        display: flex;
        gap: 16px;
        margin-bottom: 16px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .form-group.col-4 { flex: 0 0 calc(33.333% - 11px); }
    .form-group.col-6 { flex: 0 0 calc(50% - 8px); }
    .form-group.col-8 { flex: 0 0 calc(66.666% - 5px); }
    .form-group.col-12 { flex: 0 0 100%; }

    .form-group label {
        font-size: 13px;
        font-weight: 500;
        color: #374151;
    }

    .required { color: #ef4444; }

    .dialog-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 16px 24px;
        border-top: 1px solid #e2e8f0;
    }
</style>
