@using ValyanERP.Web.Features.Administrare.Parteneri.Models

<SfDialog @bind-Visible="@IsVisible" Width="800px" IsModal="true" ShowCloseIcon="true"
          CssClass="anaf-compare-dialog" AllowDragging="true"
          Header="@GetDialogHeader()">
    <DialogTemplates>
        <Content>
            @if (IsLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Se verifică...</span>
                    </div>
                    <p class="mt-3 text-muted">Se verifică datele la ANAF...</p>
                </div>
            }
            else if (ErrorMessage != null)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @ErrorMessage
                </div>
            }
            else if (AnafData != null)
            {
                <div class="compare-container">
                    @* Header cu status general *@
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="status-badges d-flex flex-wrap gap-2">
                                @if (AnafData.ScpTVA)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Plătitor TVA</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-dash-circle me-1"></i>Neplătitor TVA</span>
                                }
                                
                                @if (AnafData.StatusSplitTVA)
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-scissors me-1"></i>Split TVA</span>
                                }
                                
                                @if (AnafData.StatusInactivi)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>INACTIV FISCAL</span>
                                }
                                else
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Activ</span>
                                }
                                
                                @if (AnafData.StatusRoEfactura)
                                {
                                    <span class="badge bg-info"><i class="bi bi-file-earmark-text me-1"></i>RO e-Factura</span>
                                }
                                
                                @if (AnafData.StatusInsolventa)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i>INSOLVENȚĂ</span>
                                }
                            </div>
                        </div>
                    </div>

                    @* Tabel comparativ *@
                    <div class="table-responsive">
                        <table class="table table-hover compare-table">
                            <thead>
                                <tr>
                                    <th style="width: 30%">Câmp</th>
                                    <th style="width: 35%">Date ERP</th>
                                    <th style="width: 35%">Date ANAF</th>
                                </tr>
                            </thead>
                            <tbody>
                                @* Denumire *@
                                <tr class="@GetRowClass(ErpDenumire, AnafData.Denumire)">
                                    <td><strong>Denumire</strong></td>
                                    <td>@(ErpDenumire ?? "-")</td>
                                    <td>@(AnafData.Denumire ?? "-")</td>
                                </tr>
                                
                                @* Adresă Sediu Social (structurată) *@
                                <tr class="@GetRowClass(ErpAdresa, FormatAnafAddress())">
                                    <td><strong>Adresă Sediu</strong></td>
                                    <td class="text-wrap">@(ErpAdresa ?? "-")</td>
                                    <td class="text-wrap">@(FormatAnafAddress())</td>
                                </tr>
                                
                                @* Localitate *@
                                <tr class="@GetRowClass(ErpLocalitate, AnafData.SediuLocalitate)">
                                    <td><strong>Localitate</strong></td>
                                    <td>@(ErpLocalitate ?? "-")</td>
                                    <td>@(AnafData.SediuLocalitate ?? "-")</td>
                                </tr>
                                
                                @* Județ *@
                                <tr class="@GetRowClass(ErpJudet, AnafData.SediuJudet)">
                                    <td><strong>Județ</strong></td>
                                    <td>@(ErpJudet ?? "-")</td>
                                    <td>@(AnafData.SediuJudet ?? "-")</td>
                                </tr>
                                
                                @* Nr. Reg. Com. *@
                                <tr class="@GetRowClass(ErpRegCom, AnafData.NrRegCom)">
                                    <td><strong>Nr. Reg. Comerț</strong></td>
                                    <td>@(ErpRegCom ?? "-")</td>
                                    <td>@(AnafData.NrRegCom ?? "-")</td>
                                </tr>
                                
                                @* Telefon *@
                                <tr class="@GetRowClass(ErpTelefon, AnafData.Telefon)">
                                    <td><strong>Telefon</strong></td>
                                    <td>@(ErpTelefon ?? "-")</td>
                                    <td>@(AnafData.Telefon ?? "-")</td>
                                </tr>
                                
                                @* Plătitor TVA *@
                                <tr class="@GetBoolRowClass(ErpPlatitorTVA, AnafData.ScpTVA)">
                                    <td><strong>Plătitor TVA</strong></td>
                                    <td>
                                        @if (ErpPlatitorTVA)
                                        {
                                            <span class="text-success"><i class="bi bi-check-circle-fill"></i> Da</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted"><i class="bi bi-dash-circle"></i> Nu</span>
                                        }
                                    </td>
                                    <td>
                                        @if (AnafData.ScpTVA)
                                        {
                                            <span class="text-success"><i class="bi bi-check-circle-fill"></i> Da</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted"><i class="bi bi-dash-circle"></i> Nu</span>
                                        }
                                    </td>
                                </tr>
                                
                                @* Data înregistrare TVA *@
                                @if (AnafData.DataInregistrareTVA.HasValue)
                                {
                                    <tr>
                                        <td><strong>Data înreg. TVA</strong></td>
                                        <td>@(ErpDataTVA?.ToString("dd.MM.yyyy") ?? "-")</td>
                                        <td>@AnafData.DataInregistrareTVA.Value.ToString("dd.MM.yyyy")</td>
                                    </tr>
                                }
                                
                                @* Split TVA *@
                                <tr class="@GetBoolRowClass(ErpSplitTVA, AnafData.StatusSplitTVA)">
                                    <td><strong>Split TVA</strong></td>
                                    <td>
                                        @if (ErpSplitTVA)
                                        {
                                            <span class="text-warning"><i class="bi bi-scissors"></i> Da</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted"><i class="bi bi-dash-circle"></i> Nu</span>
                                        }
                                    </td>
                                    <td>
                                        @if (AnafData.StatusSplitTVA)
                                        {
                                            <span class="text-warning"><i class="bi bi-scissors"></i> Da</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted"><i class="bi bi-dash-circle"></i> Nu</span>
                                        }
                                    </td>
                                </tr>
                                
                                @* Status Activ/Inactiv *@
                                <tr class="@GetActiveRowClass()">
                                    <td><strong>Status Fiscal</strong></td>
                                    <td>
                                        @if (ErpInactiv)
                                        {
                                            <span class="text-danger"><i class="bi bi-x-circle-fill"></i> Inactiv</span>
                                        }
                                        else
                                        {
                                            <span class="text-success"><i class="bi bi-check-circle-fill"></i> Activ</span>
                                        }
                                    </td>
                                    <td>
                                        @if (AnafData.StatusInactivi)
                                        {
                                            <span class="text-danger"><i class="bi bi-x-circle-fill"></i> INACTIV</span>
                                        }
                                        else
                                        {
                                            <span class="text-success"><i class="bi bi-check-circle-fill"></i> Activ</span>
                                        }
                                    </td>
                                </tr>
                                
                                @* RO e-Factura *@
                                <tr>
                                    <td><strong>RO e-Factura</strong></td>
                                    <td class="text-muted">-</td>
                                    <td>
                                        @if (AnafData.StatusRoEfactura)
                                        {
                                            <span class="text-info"><i class="bi bi-check-circle-fill"></i> Da</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted"><i class="bi bi-dash-circle"></i> Nu</span>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    @* Legendă *@
                    <div class="legend mt-3 d-flex gap-3 justify-content-end">
                        <small><span class="legend-box legend-match"></span> Date identice</small>
                        <small><span class="legend-box legend-diff"></span> Diferențe</small>
                    </div>

                    @* Mesaj dacă sunt diferențe *@
                    @if (HasDifferences)
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Atenție:</strong> Au fost detectate diferențe între datele din ERP și cele de la ANAF.
                            Apăsați <strong>Actualizează din ANAF</strong> pentru a sincroniza datele.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success mt-3 mb-0">
                            <i class="bi bi-check-circle me-2"></i>
                            Datele din ERP sunt sincronizate cu ANAF.
                        </div>
                    }
                </div>
            }
        </Content>
    </DialogTemplates>
    <DialogButtons>
        @if (!IsLoading && AnafData != null)
        {
            <DialogButton Content="Reîncarcă din ANAF" CssClass="e-flat" IconCss="bi bi-arrow-clockwise"
                          OnClick="@RefreshFromAnaf" />
            <DialogButton Content="Actualizează din ANAF" CssClass="e-primary" IsPrimary="true" 
                          OnClick="@ApplyAnafData" Disabled="@(!HasDifferences)" />
        }
        <DialogButton Content="Închide" CssClass="e-flat" OnClick="@Close" />
    </DialogButtons>
</SfDialog>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    
    // Date de la ANAF
    [Parameter] public AnafVerificationCache? AnafData { get; set; }
    
    // Date din ERP pentru comparare
    [Parameter] public string? ErpDenumire { get; set; }
    [Parameter] public string? ErpAdresa { get; set; }
    [Parameter] public string? ErpLocalitate { get; set; }
    [Parameter] public string? ErpJudet { get; set; }
    [Parameter] public string? ErpRegCom { get; set; }
    [Parameter] public string? ErpTelefon { get; set; }
    [Parameter] public bool ErpPlatitorTVA { get; set; }
    [Parameter] public DateTime? ErpDataTVA { get; set; }
    [Parameter] public bool ErpSplitTVA { get; set; }
    [Parameter] public bool ErpInactiv { get; set; }
    
    [Parameter] public string? CUI { get; set; }
    [Parameter] public string? DataSource { get; set; }
    
    [Parameter] public EventCallback OnApplyData { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }

    private bool HasDifferences => AnafData != null && (
        !StringEquals(ErpDenumire, AnafData.Denumire) ||
        !StringEquals(ErpRegCom, AnafData.NrRegCom) ||
        !StringEquals(ErpLocalitate, AnafData.SediuLocalitate) ||
        !StringEquals(ErpJudet, AnafData.SediuJudet) ||
        ErpPlatitorTVA != AnafData.ScpTVA ||
        ErpSplitTVA != AnafData.StatusSplitTVA ||
        ErpInactiv != AnafData.StatusInactivi
    );

    private string GetDialogHeader()
    {
        var source = DataSource == "Cache" ? " (din cache)" : "";
        return $"Verificare ANAF - CUI {CUI}{source}";
    }

    private string GetRowClass(string? erp, string? anaf)
    {
        if (StringEquals(erp, anaf)) return "row-match";
        return "row-diff";
    }

    private string GetBoolRowClass(bool erp, bool anaf)
    {
        return erp == anaf ? "row-match" : "row-diff";
    }

    private string GetActiveRowClass()
    {
        return ErpInactiv == AnafData?.StatusInactivi ? "row-match" : "row-diff";
    }

    private bool StringEquals(string? a, string? b)
    {
        if (string.IsNullOrWhiteSpace(a) && string.IsNullOrWhiteSpace(b)) return true;
        return string.Equals(a?.Trim(), b?.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Formatează adresa sediu social din datele ANAF structurate.
    /// </summary>
    private string FormatAnafAddress()
    {
        if (AnafData == null) return "-";
        
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(AnafData.SediuStrada))
            parts.Add(AnafData.SediuStrada);
        if (!string.IsNullOrWhiteSpace(AnafData.SediuNumar))
            parts.Add($"Nr. {AnafData.SediuNumar}");
        if (!string.IsNullOrWhiteSpace(AnafData.SediuDetalii))
            parts.Add(AnafData.SediuDetalii);
        
        return parts.Count > 0 ? string.Join(", ", parts) : (AnafData.Adresa ?? "-");
    }

    private async Task ApplyAnafData()
    {
        await OnApplyData.InvokeAsync();
    }

    private async Task RefreshFromAnaf()
    {
        await OnRefresh.InvokeAsync();
    }

    private async Task Close()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }
}
