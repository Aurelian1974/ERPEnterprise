@page "/administrare/tipuri-documente"
@attribute [Authorize]
@rendermode InteractiveServer

@using ValyanERP.Web.Features.Administrare.TipuriDocumente.Models
@using ValyanERP.Web.Features.Administrare.TipuriDocumente.Services
@using ValyanERP.Web.Components.Shared.DataGrid

@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Navigations

<PageTitle>Administrare Tipuri Documente</PageTitle>

<div class="tipuri-documente-page">
    @* Page Header *@
    <div class="page-header">
        <div class="header-content">
            <h3 class="page-title">
                <i class="bi bi-file-earmark-text me-2"></i>Tipuri Documente
            </h3>
            <span class="record-count">@totalRecords înregistrări</span>
        </div>

        @* Grid State Manager - for saving/loading configurations *@
        <GridStateManager @ref="gridStateManager"
                          GridId="TipuriDocumente"
                          GridReference="@grid"
                          ShowConfigurationSelector="true"
                          ShowButtonLabels="false"
                          OnStateSaved="OnGridStateSaved"
                          OnStateLoaded="OnGridStateLoaded"
                          OnStateReset="OnGridStateReset" />
    </div>

    @* Error Alert *@
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
            <button type="button" class="btn-close" @onclick="ClearError"></button>
        </div>
    }

    @* Loading Indicator *@
    @if (isLoading)
    {
        <div class="text-center py-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Se încarcă...</span>
            </div>
            <div class="mt-2">Se încarcă datele...</div>
        </div>
    }
    else
    {
        @* Main Grid *@
        <SfGrid @ref="grid"
                DataSource="@tipuriDocumente"
                AllowPaging="true"
                AllowSorting="true"
                AllowFiltering="true"
                AllowGrouping="true"
                AllowExcelExport="true"
                AllowPdfExport="true"
                Toolbar="@(new List<string>() { "Add", "Edit", "Delete", "ExcelExport", "PdfExport" })"
                Height="600px"
                RowDataBound="RowDataBound">

            <GridPageSettings PageSize="20" PageSizes="@pageSizeOptions"></GridPageSettings>

            <GridEvents OnToolbarClick="OnToolbarClick"
                       TValue="TipDocument"></GridEvents>

            <GridColumns>
                <GridColumn Field="@nameof(TipDocument.TipDocumentCode)" HeaderText="Cod" Width="120" IsPrimaryKey="true"></GridColumn>
                <GridColumn Field="@nameof(TipDocument.TipDocumentName)" HeaderText="Nume" Width="200"></GridColumn>
                <GridColumn Field="@nameof(TipDocument.Description)" HeaderText="Descriere" Width="300"></GridColumn>
                <GridColumn Field="@nameof(TipDocument.IsActive)" HeaderText="Activ" Width="80" DisplayAsCheckBox="true"></GridColumn>
                <GridColumn Field="@nameof(TipDocument.CreatedAt)" HeaderText="Creat la" Width="150" Format="dd.MM.yyyy HH:mm"></GridColumn>
                <GridColumn Field="@nameof(TipDocument.UpdatedAt)" HeaderText="Modificat la" Width="150" Format="dd.MM.yyyy HH:mm"></GridColumn>
            </GridColumns>

            <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true" Mode="Syncfusion.Blazor.Grids.EditMode.Dialog">
                <Template>
                    @{
                        var tipDocument = (context as TipDocument)!;
                    }
                    <div class="edit-form">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <SfTextBox @bind-Value="@tipDocument.TipDocumentCode"
                                              Placeholder="Cod tip document"
                                              FloatLabelType="FloatLabelType.Always"
                                              Required="true">
                                        <SfTextBoxEvents ValueChange="OnCodeChanged"></SfTextBoxEvents>
                                    </SfTextBox>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <SfTextBox @bind-Value="@tipDocument.TipDocumentName"
                                              Placeholder="Nume tip document"
                                              FloatLabelType="FloatLabelType.Always"
                                              Required="true">
                                        <SfTextBoxEvents ValueChange="OnNameChanged"></SfTextBoxEvents>
                                    </SfTextBox>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <div class="mb-3">
                                    <SfTextBox @bind-Value="@tipDocument.Description"
                                              Placeholder="Descriere (opțional)"
                                              FloatLabelType="FloatLabelType.Always"
                                              Multiline="true"
                                              Rows="3">
                                    </SfTextBox>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <SfCheckBox @bind-Checked="@tipDocument.IsActive"
                                               Label="Activ">
                                    </SfCheckBox>
                                </div>
                            </div>
                        </div>
                    </div>
                </Template>
            </GridEditSettings>
        </SfGrid>
    }
</div>

