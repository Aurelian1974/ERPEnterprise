@page "/administrare/articole"
@attribute [Authorize]
@rendermode InteractiveServer

@pageTitle "Administrare Articole"

<PageTitle>Administrare - Articole</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <div class="header-content">
            <h3 class="page-title">
                <i class="bi bi-card-text me-2"></i>Articole
            </h3>
            <span class="page-subtitle">Gestionați articolele din catalog</span>
        </div>
    </div>

    <div class="page-body">
        <p>Pagina va conține lista de articole, filtrare și operațiuni CRUD (în lucru).</p>
    </div>
</div>