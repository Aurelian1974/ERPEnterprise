@page "/administrare/audit-logs"
@rendermode InteractiveServer
@using ValyanERP.Web.Features.Infrastructure.Audit.Models
@using ValyanERP.Web.Features.Infrastructure.Audit.Services
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Notifications
@using Syncfusion.Blazor.Popups
@attribute [Authorize]

<PageTitle>Audit Logs - Istoric Modificări</PageTitle>

<div class="audit-logs-container">
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h3>
                <i class="bi bi-shield-check"></i> Audit Logs
            </h3>
            <p class="text-muted mb-0">Istoric complet al modificărilor în sistem</p>
        </div>
        <button class="btn btn-outline-primary" @onclick="RefreshDataAsync" disabled="@isLoading">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
    </div>

    <SfToast @ref="ToastObj" 
             ID="toast_auditlogs" 
             ShowCloseButton="true"
             Timeout="5000"
             NewestOnTop="true">
        <ToastPosition X="Right" Y="Top"></ToastPosition>
    </SfToast>

    <!-- Filters Section -->
    <div class="filters-card">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">TIP ENTITATE</label>
                <SfDropDownList TValue="string" 
                                TItem="string"
                                @bind-Value="filterEntityType"
                                DataSource="@entityTypes"
                                Placeholder="Selectează entitate"
                                CssClass="e-outline"
                                FloatLabelType="FloatLabelType.Never">
                </SfDropDownList>
            </div>

            <div class="col-md-3">
                <label class="form-label">OPERAȚIE</label>
                <SfDropDownList TValue="string" 
                                TItem="string"
                                @bind-Value="filterOperationType"
                                DataSource="@operationTypes"
                                Placeholder="Selectează operație"
                                CssClass="e-outline"
                                FloatLabelType="FloatLabelType.Never">
                </SfDropDownList>
            </div>

            <div class="col-md-3">
                <label class="form-label">DATA START</label>
                <SfDatePicker TValue="DateTime?" 
                              @bind-Value="filterStartDate"
                              Placeholder="Selectează data start"
                              CssClass="e-outline"
                              Format="dd.MM.yyyy"
                              FloatLabelType="FloatLabelType.Never">
                </SfDatePicker>
            </div>

            <div class="col-md-3">
                <label class="form-label">DATA SFÂRȘIT</label>
                <SfDatePicker TValue="DateTime?" 
                              @bind-Value="filterEndDate"
                              Placeholder="Selectează data sfârșit"
                              CssClass="e-outline"
                              Format="dd.MM.yyyy"
                              FloatLabelType="FloatLabelType.Never">
                </SfDatePicker>
            </div>

            <div class="col-md-9">
                <label class="form-label">CĂUTARE</label>
                <SfTextBox @bind-Value="filterSearchTerm" 
                           Placeholder="Caută după user, email, entitate..."
                           CssClass="e-outline"
                           FloatLabelType="FloatLabelType.Never">
                </SfTextBox>
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <SfButton CssClass="e-primary w-100" OnClick="LoadAuditLogsAsync">
                    <i class="bi bi-search me-1"></i> Filtrează
                </SfButton>
            </div>
        </div>
    </div>

    @if (auditLogs != null)
    {
        <div class="card shadow-sm mt-3">
            <div class="card-body p-0">
                <SfGrid @ref="auditGrid" 
                        TValue="AuditLog" 
                        DataSource="@auditLogs.Items"
                        AllowPaging="true" 
                        AllowSorting="true" 
                        AllowFiltering="true"
                        AllowExcelExport="true"
                        AllowPdfExport="true"
                        AllowTextWrap="true"
                        Toolbar="@(new List<string>() { "ExcelExport", "PdfExport", "Search", "ColumnChooser" })"
                        OnToolbarClick="ToolbarClickHandler">
                    
                    <GridPageSettings PageSize="@pageSize" PageSizes="@(new int[] { 10, 20, 50, 100 })"></GridPageSettings>
                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                    
                    <GridColumns>
                        <GridColumn Field=@nameof(AuditLog.Id) IsPrimaryKey="true" Visible="false"></GridColumn>
                        
                        <GridColumn Field=@nameof(AuditLog.Timestamp) 
                                    HeaderText="TIMESTAMP" 
                                    Width="150"
                                    Format="dd.MM.yyyy HH:mm:ss"
                                    Type="ColumnType.DateTime">
                        </GridColumn>
                        
                        <GridColumn Field=@nameof(AuditLog.UserFullName) 
                                    HeaderText="UTILIZATOR" 
                                    Width="200">
                            <Template>
                                @{
                                    var log = context as AuditLog;
                                }
                                <div class="user-info">
                                    <strong>@log.UserFullName</strong>
                                    <small class="text-muted d-block">@log.UserEmail</small>
                                </div>
                            </Template>
                        </GridColumn>
                        
                        <GridColumn Field=@nameof(AuditLog.OperationType) 
                                    HeaderText="OPERAȚIE" 
                                    Width="120"
                                    TextAlign="TextAlign.Center">
                            <Template>
                                @{
                                    var log = context as AuditLog;
                                }
                                <span class="badge operation-@log.OperationType.ToLower()">
                                    @log.OperationType
                                </span>
                            </Template>
                        </GridColumn>
                        
                        <GridColumn Field=@nameof(AuditLog.EntityType) 
                                    HeaderText="ENTITATE" 
                                    Width="180">
                            <Template>
                                @{
                                    var log = context as AuditLog;
                                }
                                <div class="entity-info">
                                    <strong>@log.EntityType</strong>
                                    <small class="text-muted d-block">ID: @log.EntityId</small>
                                    @if (!string.IsNullOrEmpty(log.TableName))
                                    {
                                        <small class="text-muted d-block">Tabelă: @log.TableName</small>
                                    }
                                </div>
                            </Template>
                        </GridColumn>
                        
                        <GridColumn Field=@nameof(AuditLog.ChangedFieldsCount) 
                                    HeaderText="MODIFICĂRI" 
                                    Width="120"
                                    TextAlign="TextAlign.Center">
                            <Template>
                                @{
                                    var log = context as AuditLog;
                                }
                                <span class="badge bg-info">@log.ChangedFieldsCount câmpuri</span>
                            </Template>
                        </GridColumn>
                        
                        <GridColumn Field=@nameof(AuditLog.IPAddress) 
                                    HeaderText="IP ADDRESS" 
                                    Width="130">
                            <Template>
                                @{
                                    var log = context as AuditLog;
                                }
                                <small class="text-muted">@(log.IPAddress ?? "N/A")</small>
                            </Template>
                        </GridColumn>
                        
                        <GridColumn HeaderText="ACȚIUNI" Width="120" TextAlign="TextAlign.Center">
                            <Template>
                                @{
                                    var log = context as AuditLog;
                                }
                                <button class="btn btn-sm btn-outline-primary" 
                                        @onclick="@(async () => await ShowDetailsAsync(log!.Id))">
                                    <i class="bi bi-eye me-1"></i> Detalii
                                </button>
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
            </div>
        </div>
        
        <!-- Pagination Info -->
        <div class="pagination-info-bar mt-3">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    Pagina @auditLogs.CurrentPage din @auditLogs.TotalPages 
                    (Total: @auditLogs.TotalCount înregistrări)
                </span>
                <div>
                    <button class="btn btn-sm btn-outline-secondary me-1" 
                            @onclick="() => GoToPage(auditLogs.CurrentPage - 1)"
                            disabled="@(!auditLogs.HasPreviousPage)">
                        <i class="bi bi-chevron-left"></i> Anterior
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" 
                            @onclick="() => GoToPage(auditLogs.CurrentPage + 1)"
                            disabled="@(!auditLogs.HasNextPage)">
                        Următor <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info mt-3">
            <i class="bi bi-info-circle"></i> Nu au fost găsite înregistrări audit pentru criteriile selectate.
        </div>
    }
</div>

<!-- Details Modal - Syncfusion Dialog -->
<SfDialog @ref="detailsDialog"
          Width="900px" 
          IsModal="true" 
          Visible="false"
          ShowCloseIcon="true"
          AllowDragging="true"
          EnableResize="true"
          Closed="OnDialogClose">
    <DialogTemplates>
        <Header>
            <div class="d-flex align-items-center">
                <i class="bi bi-info-circle me-2"></i> Detalii Audit Log
            </div>
        </Header>
        <Content>
            @if (selectedLog != null)
            {
                <div class="audit-details-content">
                    <!-- Log Header Info -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-uppercase text-muted mb-2">Utilizator</h6>
                            <p class="mb-0"><strong>@selectedLog.UserFullName</strong></p>
                            <p class="text-muted mb-0">@selectedLog.UserEmail</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-uppercase text-muted mb-2">Timestamp</h6>
                            <p class="mb-0">@selectedLog.Timestamp.ToString("dd.MM.yyyy HH:mm:ss")</p>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-4">
                            <h6 class="text-uppercase text-muted mb-2">Operație</h6>
                            <span class="badge operation-@selectedLog.OperationType.ToLower()">
                                @selectedLog.OperationType
                            </span>
                        </div>
                        <div class="col-md-4">
                            <h6 class="text-uppercase text-muted mb-2">Entitate</h6>
                            <p class="mb-0">@selectedLog.EntityType</p>
                            <small class="text-muted">ID: @selectedLog.EntityId</small>
                        </div>
                        <div class="col-md-4">
                            <h6 class="text-uppercase text-muted mb-2">IP Address</h6>
                            <p class="mb-0">@(selectedLog.IPAddress ?? "N/A")</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(selectedLog.UserAgent))
                    {
                        <div class="mb-4">
                            <h6 class="text-uppercase text-muted mb-2">User Agent</h6>
                            <p class="mb-0 text-break"><small>@selectedLog.UserAgent</small></p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(selectedLog.Notes))
                    {
                        <div class="mb-4">
                            <h6 class="text-uppercase text-muted mb-2">Note</h6>
                            <p class="mb-0">@selectedLog.Notes</p>
                        </div>
                    }

                    <!-- Field Changes -->
                    @if (selectedLog.Details != null && selectedLog.Details.Any())
                    {
                        <h6 class="text-uppercase text-muted mb-3">Modificări Câmpuri (@selectedLog.Details.Count)</h6>
                        <div class="table-responsive">
                            <table class="table table-bordered audit-details-table">
                                <thead>
                                    <tr>
                                        <th>CÂMP</th>
                                        <th>VALOARE VECHE</th>
                                        <th>VALOARE NOUĂ</th>
                                        <th>TIP</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var detail in selectedLog.Details)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@detail.FieldName</strong>
                                                @if (detail.IsSensitive)
                                                {
                                                    <i class="bi bi-lock-fill text-warning ms-1" 
                                                       title="Date sensibile (mascate)"></i>
                                                }
                                            </td>
                                            <td class="old-value">
                                                <code>@(detail.OldValue ?? "NULL")</code>
                                            </td>
                                            <td class="new-value">
                                                <code>@(detail.NewValue ?? "NULL")</code>
                                            </td>
                                            <td>
                                                <small class="text-muted">@detail.DataType</small>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> Nu există detalii despre modificările câmpurilor.
                        </div>
                    }
                </div>
            }
        </Content>
        <FooterTemplate>
            <button type="button" class="btn btn-secondary" @onclick="CloseDetailsModal">
                <i class="bi bi-x-circle me-1"></i> Închide
            </button>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>
