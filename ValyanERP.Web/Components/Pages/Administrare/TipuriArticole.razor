@page "/administrare/tipuri-articole"
@attribute [Authorize]
@rendermode InteractiveServer

@using ValyanERP.Web.Features.Administrare.TipuriArticole.Models
@using ValyanERP.Web.Features.Administrare.TipuriArticole
@using ValyanERP.Web.Features.Administrare.TipuriArticole.Services
@using ValyanERP.Web.Components.Shared.DataGrid

@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Navigations

<PageTitle>Administrare Tipuri Articole</PageTitle>

<div class="tipuri-articole-page">
    @* Page Header *@
    <div class="page-header">
        <div class="header-content">
            <h3 class="page-title">
                <i class="bi bi-tags-fill me-2"></i>Tipuri Articole
            </h3>
            <span class="record-count">@totalRecords înregistrări</span>
        </div>

        @* Grid State Manager - for saving/loading configurations *@
        <GridStateManager @ref="gridStateManager"
                          GridId="TipuriArticole"
                          GridReference="@grid"
                          ShowConfigurationSelector="true"
                          ShowButtonLabels="false"
                          OnStateSaved="OnGridStateSaved"
                          OnStateLoaded="OnGridStateLoaded"
                          OnStateReset="OnGridStateReset" />
    </div>

    @* Error Alert *@
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
            <button type="button" class="btn-close" @onclick="ClearError"></button>
        </div>
    }

    @* Loading Indicator *@
    @if (isLoading)
    {
        <div class="alert alert-info" role="alert">
            <div class="d-flex align-items-center">
                <div class="spinner-border spinner-border-sm me-2" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <span>Se încarcă datele...</span>
            </div>
        </div>
    }

    @* Success Alert *@
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
            <button type="button" class="btn-close" @onclick="ClearSuccess"></button>
        </div>
    }

    @* Main Grid *@
    <SfGrid @ref="grid"
            TValue="ValyanERP.Web.Features.Administrare.TipuriArticole.Models.ItemType"
            ID="TipuriArticoleGrid"
            AllowPaging="true"
            AllowSorting="true"
            AllowMultiSorting="true"
            AllowFiltering="true"
            AllowGrouping="true"
            AllowResizing="true"
            AllowReordering="true"
            AllowSelection="true"
            AllowExcelExport="true"
            AllowPdfExport="true"
            ShowColumnChooser="true"
            ShowColumnMenu="true"
            EnablePersistence="true"
            EnableStickyHeader="true"
            EnableHover="true"
            EnableAltRow="true"
            Height="calc(100vh - 280px)"
            Toolbar="@toolbar">

        @* Custom Data Adaptor for server-side operations *@
        <SfDataManager AdaptorInstance="@typeof(ItemTypesAdaptor)" Adaptor="Adaptors.CustomAdaptor"></SfDataManager>

        @* Page Settings - Server-side pagination *@
        <GridPageSettings PageSize="@pageSize"
                          PageSizes="@pageSizeOptions"
                          PageCount="5">
        </GridPageSettings>

        @* Filter Settings - Advanced filtering *@
        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"
                            EnableCaseSensitivity="false"
                            ImmediateModeDelay="300">
        </GridFilterSettings>

        @* Group Settings - Server-side lazy load grouping *@
        @* LazyLoad grouping loads child rows on-demand when expanding groups *@
        <GridGroupSettings ShowDropArea="true"
                           ShowGroupedColumn="true"
                           ShowToggleButton="true"
                           ShowUngroupButton="true"
                           AllowReordering="true"
                           EnableLazyLoading="true">
        </GridGroupSettings>

        @* Sort Settings *@
        <GridSortSettings AllowUnsort="true">
        </GridSortSettings>

        @* Selection Settings *@
        <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Single"
                               Mode="Syncfusion.Blazor.Grids.SelectionMode.Row"
                               EnableToggle="true">
        </GridSelectionSettings>

        @* Search Settings *@
        <GridSearchSettings IgnoreCase="true"
                            Operator="Syncfusion.Blazor.Operator.Contains">
        </GridSearchSettings>

        @* Edit Settings - Dialog mode for better UX *@
        <GridEditSettings AllowAdding="false"
                          AllowEditing="false"
                          AllowDeleting="true"
                          Mode="Syncfusion.Blazor.Grids.EditMode.Dialog"
                          ShowDeleteConfirmDialog="true"
                          ShowConfirmDialog="true">
        </GridEditSettings>

        @* Grid Columns *@
        <GridColumns>
            @* Primary Key - Hidden *@
            <GridColumn Field="@nameof(ValyanERP.Web.Features.Administrare.TipuriArticole.Models.ItemType.Id)"
                        IsPrimaryKey="true"
                        Visible="false"
                        AllowEditing="false">
            </GridColumn>

            @* ItemTypeCode *@
            <GridColumn Field="@nameof(ValyanERP.Web.Features.Administrare.TipuriArticole.Models.ItemType.ItemTypeCode)"
                        HeaderText="Cod Tip"
                        Width="120"
                        MinWidth="100"
                        ClipMode="ClipMode.EllipsisWithTooltip"
                        AllowSearching="true"
                        AllowFiltering="true"
                        AllowSorting="true"
                        AllowGrouping="true">
                <Template>
                    @{
                        var data = context as ValyanERP.Web.Features.Administrare.TipuriArticole.Models.ItemType;
                    }
                    <div class="item-type-code-cell" @key="data?.Id">
                        <i class="bi bi-tag-fill me-2 text-primary"></i>
                        <span class="item-type-code-text">@data?.ItemTypeCode</span>
                    </div>
                </Template>
            </GridColumn>

            @* ItemTypeName *@
            <GridColumn Field="@nameof(ValyanERP.Web.Features.Administrare.TipuriArticole.Models.ItemType.ItemTypeName)"
                        HeaderText="Denumire Tip"
                        Width="250"
                        MinWidth="150"
                        ClipMode="ClipMode.EllipsisWithTooltip"
                        AllowSearching="true"
                        AllowFiltering="true"
                        AllowSorting="true"
                        AllowGrouping="true">
            </GridColumn>

            @* Description *@
            <GridColumn Field="@nameof(ValyanERP.Web.Features.Administrare.TipuriArticole.Models.ItemType.Description)"
                        HeaderText="Descriere"
                        Width="300"
                        MinWidth="150"
                        ClipMode="ClipMode.EllipsisWithTooltip"
                        AllowSearching="true"
                        AllowFiltering="true"
                        AllowSorting="true">
            </GridColumn>

            @* Created Date *@
            <GridColumn Field="@nameof(ValyanERP.Web.Features.Administrare.TipuriArticole.Models.ItemType.CreatedAt)"
                        HeaderText="Creat La"
                        Format="dd.MM.yyyy HH:mm"
                        Type="ColumnType.DateTime"
                        Width="160"
                        AllowEditing="false"
                        AllowFiltering="true"
                        AllowSorting="true"
                        TextAlign="TextAlign.Center">
            </GridColumn>

            @* Is Active *@
            <GridColumn Field="@nameof(ValyanERP.Web.Features.Administrare.TipuriArticole.Models.ItemType.IsActive)"
                        HeaderText="Activ"
                        Width="100"
                        DisplayAsCheckBox="true"
                        AllowFiltering="true"
                        AllowSorting="true"
                        TextAlign="TextAlign.Center"
                        Type="ColumnType.Boolean">
                <FilterTemplate>
                    @{
                        var filterContext = context as PredicateModel;
                        var selectedValue = filterContext?.Value as string ?? "";
                    }
                    <SfDropDownList TValue="string"
                                    TItem="StatusItem"
                                    @bind-Value="selectedValue"
                                    DataSource="@statusOptions"
                                    Placeholder="Selectează status">
                        <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
                    </SfDropDownList>
                </FilterTemplate>
            </GridColumn>
        </GridColumns>

        @* Grid Events *@
        <GridEvents TValue="ValyanERP.Web.Features.Administrare.TipuriArticole.Models.ItemType"
                    OnActionBegin="ActionBeginHandler"
                    OnActionComplete="ActionCompleteHandler"
                    RowSelected="OnRowSelected"
                    RowDeselected="OnRowDeselected"
                    RowDataBound="OnRowDataBound"
                    DataBound="OnDataBound"
                    OnToolbarClick="@(async args => await OnToolbarClick(args))">
        </GridEvents>

        @* Grid Aggregates for footer summary *@
        <GridAggregates>
            <GridAggregate>
                <GridAggregateColumns>
                    <GridAggregateColumn Field="@nameof(ValyanERP.Web.Features.Administrare.TipuriArticole.Models.ItemType.ItemTypeCode)" Type="AggregateType.Count">
                        <FooterTemplate>
                            @{
                                var aggregate = (context as AggregateTemplateContext);
                            }
                            <span class="aggregate-footer">
                                Total: <strong>@aggregate?.Count</strong> tipuri articole
                            </span>
                        </FooterTemplate>
                    </GridAggregateColumn>
                </GridAggregateColumns>
            </GridAggregate>
        </GridAggregates>
    </SfGrid>
</div>

@* View Dialog - Read-only details *@
@if (showViewDialog && selectedItemType != null)
{
    <SfDialog @ref="viewDialog"
              Width="600px"
              Height="auto"
              IsModal="true"
              ShowCloseIcon="true"
              @bind-Visible="showViewDialog"
              Header="Detalii Tip Articol">
        <DialogTemplates>
            <Header>
                <div class="d-flex align-items-center">
                    <i class="bi bi-tag-fill me-2 text-primary"></i>
                    <span>Detalii Tip Articol: @selectedItemType.ItemTypeCode</span>
                </div>
            </Header>
            <Content>
                <div class="view-dialog-content">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="detail-item">
                                <label class="detail-label">Cod Tip:</label>
                                <span class="detail-value">@selectedItemType.ItemTypeCode</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-item">
                                <label class="detail-label">Denumire:</label>
                                <span class="detail-value">@selectedItemType.ItemTypeName</span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="detail-item">
                                <label class="detail-label">Descriere:</label>
                                <span class="detail-value">@(string.IsNullOrEmpty(selectedItemType.Description) ? "N/A" : selectedItemType.Description)</span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="detail-item">
                                <label class="detail-label">Status:</label>
                                <span class="detail-value @(selectedItemType.IsActive ? "text-success" : "text-danger")">
                                    @(selectedItemType.IsActive ? "Activ" : "Inactiv")
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-item">
                                <label class="detail-label">Creat La:</label>
                                <span class="detail-value">@selectedItemType.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </Content>
            <FooterTemplate>
                <div class="d-flex justify-content-end gap-2">
                    <SfButton CssClass="e-outline" @onclick="CloseViewDialog">Închide</SfButton>
                </div>
            </FooterTemplate>
        </DialogTemplates>
    </SfDialog>
}

@* Delete Confirmation Dialog *@
@if (showDeleteConfirm && selectedItemType != null)
{
    <SfDialog @ref="deleteDialog"
              Width="450px"
              Height="auto"
              IsModal="true"
              ShowCloseIcon="true"
              @bind-Visible="showDeleteConfirm"
              CssClass="delete-confirm-dialog">
        <DialogTemplates>
            <Header>
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>
                    <span>Confirmare Ștergere</span>
                </div>
            </Header>
            <Content>
                <div class="delete-confirm-content">
                    <p>Sunteți sigur că doriți să ștergeți tipul de articol <strong>@selectedItemType.ItemTypeCode - @selectedItemType.ItemTypeName</strong>?</p>
                    <div class="alert alert-warning">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <strong>Atenție:</strong> Această acțiune nu poate fi anulată. Tipul de articol va fi marcat ca inactiv și nu va mai putea fi folosit.
                    </div>
                </div>
            </Content>
            <FooterTemplate>
                <div class="d-flex justify-content-end gap-2">
                    <SfButton CssClass="e-outline" @onclick="CancelDelete">Anulează</SfButton>
                    <SfButton CssClass="e-danger" @onclick="ConfirmDelete">Șterge</SfButton>
                </div>
            </FooterTemplate>
        </DialogTemplates>
    </SfDialog>
}

@* Add Dialog *@
@if (showAddDialog)
{
    <SfDialog Width="500px" 
              IsModal="true" 
              ShowCloseIcon="true" 
              CloseOnEscape="true"
              @bind-Visible="showAddDialog">
        <DialogTemplates>
            <Header>
                <div class="d-flex align-items-center">
                    <i class="bi bi-tag-plus me-2 text-primary"></i>
                    <span>Adăugare Tip Articol Nou</span>
                </div>
            </Header>
            <Content>
                <div class="edit-form-container">
                    @* ItemTypeCode & ItemTypeName - side by side *@
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label required-field">Cod Tip Articol</label>
                            <SfTextBox @bind-Value="newItemType.ItemTypeCode" 
                                       Placeholder="Introduceți codul tipului de articol"
                                       FloatLabelType="FloatLabelType.Never">
                            </SfTextBox>
                        </div>
                        <div class="form-group">
                            <label class="form-label required-field">Nume Tip Articol</label>
                            <SfTextBox @bind-Value="newItemType.ItemTypeName" 
                                       Placeholder="Introduceți numele tipului de articol"
                                       FloatLabelType="FloatLabelType.Never">
                            </SfTextBox>
                        </div>
                    </div>

                    @* Description - full width *@
                    <div class="form-group">
                        <label class="form-label">Descriere</label>
                        <SfTextBox @bind-Value="newItemType.Description" 
                                   Placeholder="Introduceți descrierea (opțional)"
                                   FloatLabelType="FloatLabelType.Never"
                                   Multiline="true">
                        </SfTextBox>
                    </div>

                    @* Is Active *@
                    <div class="form-group">
                        <SfCheckBox @bind-Checked="newItemType.IsActive" 
                                    Label="Tip Articol Activ">
                        </SfCheckBox>
                    </div>
                </div>
            </Content>
            <FooterTemplate>
                <div class="d-flex justify-content-end gap-2">
                    <SfButton Content="Anulare" 
                              CssClass="e-flat" 
                              @onclick="CloseAddDialog">
                    </SfButton>
                    <SfButton Content="Salvare" 
                              CssClass="e-primary" 
                              @onclick="SaveNewItemType">
                    </SfButton>
                </div>
            </FooterTemplate>
        </DialogTemplates>
    </SfDialog>
}

@* Edit Dialog *@
@if (showEditDialog && editingItemType != null)
{
    <SfDialog Width="500px" 
              IsModal="true" 
              ShowCloseIcon="true" 
              CloseOnEscape="true"
              @bind-Visible="showEditDialog">
        <DialogTemplates>
            <Header>
                <div class="d-flex align-items-center">
                    <i class="bi bi-tag me-2 text-warning"></i>
                    <span>Editare Tip Articol</span>
                </div>
            </Header>
            <Content>
                <div class="edit-form-container">
                    @* ItemTypeCode & ItemTypeName - side by side *@
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label required-field">Cod Tip Articol</label>
                            <SfTextBox @bind-Value="editingItemType.ItemTypeCode" 
                                       Placeholder="Introduceți codul tipului de articol"
                                       FloatLabelType="FloatLabelType.Never">
                            </SfTextBox>
                        </div>
                        <div class="form-group">
                            <label class="form-label required-field">Nume Tip Articol</label>
                            <SfTextBox @bind-Value="editingItemType.ItemTypeName" 
                                       Placeholder="Introduceți numele tipului de articol"
                                       FloatLabelType="FloatLabelType.Never">
                            </SfTextBox>
                        </div>
                    </div>

                    @* Description - full width *@
                    <div class="form-group">
                        <label class="form-label">Descriere</label>
                        <SfTextBox @bind-Value="editingItemType.Description" 
                                   Placeholder="Introduceți descrierea (opțional)"
                                   FloatLabelType="FloatLabelType.Never"
                                   Multiline="true">
                        </SfTextBox>
                    </div>

                    @* Is Active *@
                    <div class="form-group">
                        <SfCheckBox @bind-Checked="editingItemType.IsActive" 
                                    Label="Tip Articol Activ">
                        </SfCheckBox>
                    </div>
                </div>
            </Content>
            <FooterTemplate>
                <div class="d-flex justify-content-end gap-2">
                    <SfButton Content="Anulare" 
                              CssClass="e-flat" 
                              @onclick="CloseEditDialog">
                    </SfButton>
                    <SfButton Content="Salvare" 
                              CssClass="e-primary" 
                              @onclick="SaveEditedItemType">
                    </SfButton>
                </div>
            </FooterTemplate>
        </DialogTemplates>
    </SfDialog>
}