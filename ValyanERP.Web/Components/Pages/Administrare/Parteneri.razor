@page "/administrare/parteneri"
@attribute [Authorize]
@rendermode InteractiveServer

@using ValyanERP.Web.Features.Administrare.Parteneri.Models
@using ValyanERP.Web.Features.Administrare.Parteneri.Models.DTOs
@using ValyanERP.Web.Features.Administrare.Parteneri.Models.Enums
@using ValyanERP.Web.Features.Administrare.Parteneri.Repositories
@using ValyanERP.Web.Components.Pages.Administrare.ParteneriComponents
@using ValyanERP.Web.Components.Shared
@using Microsoft.AspNetCore.Authorization
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Spinner
@using Syncfusion.Blazor.Navigations

<PageTitle>Parteneri - ValyanERP</PageTitle>

<div class="parteneri-page">
    @* Page Header *@
    <div class="page-header">
        <div class="header-content">
            <h3 class="page-title">
                <i class="bi bi-people-fill me-2"></i>Parteneri
            </h3>
            <span class="page-subtitle">Furnizori, Clienți, Colaboratori</span>
        </div>
        <div class="header-actions">
            <SfButton CssClass="e-primary" IconCss="bi bi-plus-lg" @onclick="ShowAddPartnerDialog">
                Partener Nou
            </SfButton>
        </div>
    </div>

    @* Alerts *@
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
            <button type="button" class="btn-close" @onclick="ClearError"></button>
        </div>
    }
    
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
            <button type="button" class="btn-close" @onclick="ClearSuccess"></button>
        </div>
    }

    @* Main Content *@
    <div class="parteneri-container">
        @* Left Panel - Partners List *@
        <div class="list-panel">
            <div class="list-header">
                <SfTextBox Placeholder="Caută partener (denumire, CUI, CNP, email)..." 
                           CssClass="search-box"
                           Value="@searchTerm"
                           Input="OnSearchInput"
                           ValueChange="OnSearchValueChanged"
                           ShowClearButton="true" />
                <SfButton CssClass="e-flat e-icon-btn" IconCss="bi bi-arrow-clockwise" 
                          @onclick="RefreshList" title="Reîncarcă lista">
                </SfButton>
            </div>
            
            @* Category Filters *@
            <div class="filter-chips">
                <button class="filter-chip @(selectedCategoryFilter == "ALL" ? "active" : "")" 
                        @onclick='() => SetCategoryFilter("ALL")'>Toate</button>
                <button class="filter-chip @(selectedCategoryFilter == "FURNIZOR" ? "active" : "")" 
                        @onclick='() => SetCategoryFilter("FURNIZOR")'>Furnizori</button>
                <button class="filter-chip @(selectedCategoryFilter == "CLIENT" ? "active" : "")" 
                        @onclick='() => SetCategoryFilter("CLIENT")'>Clienți</button>
                <button class="filter-chip @(selectedCategoryFilter == "PJ" ? "active" : "")" 
                        @onclick='() => SetCategoryFilter("PJ")'>PJ</button>
                <button class="filter-chip @(selectedCategoryFilter == "PF" ? "active" : "")" 
                        @onclick='() => SetCategoryFilter("PF")'>PF</button>
            </div>

            <div class="list-content">
                @if (isLoading)
                {
                    <div class="list-loading">
                        <SfSpinner Type="SpinnerType.Bootstrap5" />
                        <span>Se încarcă partenerii...</span>
                    </div>
                }
                else if (partnersList == null || !partnersList.Any())
                {
                    <div class="list-empty">
                        <i class="bi bi-person-x"></i>
                        <p>Nu există parteneri înregistrați.</p>
                        <SfButton CssClass="e-primary" @onclick="ShowAddPartnerDialog">
                            Adaugă primul partener
                        </SfButton>
                    </div>
                }
                else
                {
                    <div class="partners-list">
                        @foreach (var partner in partnersList)
                        {
                            <div class="partner-card @(selectedPartner?.Id == partner.Id ? "selected" : "") @(!partner.EsteActiv ? "inactive" : "")" 
                                 @onclick="() => SelectPartner(partner)">
                                <div class="partner-icon">
                                    <i class="bi @GetPartnerIcon(partner)"></i>
                                </div>
                                <div class="partner-info">
                                    <div class="partner-name">@partner.DenumireAfisare</div>
                                    <div class="partner-details">
                                        <span class="partner-id">@partner.IdentificatorFiscal</span>
                                        @if (!string.IsNullOrEmpty(partner.Localitate))
                                        {
                                            <span class="partner-location">
                                                <i class="bi bi-geo-alt"></i> @partner.Localitate
                                            </span>
                                        }
                                    </div>
                                    <div class="partner-roles">
                                        @if (partner.EsteFurnizor)
                                        {
                                            <span class="badge bg-info">Furnizor</span>
                                        }
                                        @if (partner.EsteClient)
                                        {
                                            <span class="badge bg-success">Client</span>
                                        }
                                        @if (!partner.EsteActiv)
                                        {
                                            <span class="badge bg-secondary">Inactiv</span>
                                        }
                                    </div>
                                </div>
                                <div class="partner-status">
                                    @if (partner.EsteVerificat)
                                    {
                                        <i class="bi bi-patch-check-fill text-success" title="Verificat ANAF"></i>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    
                    @* Pagination *@
                    @if (totalCount > pageSize)
                    {
                        <div class="list-pagination">
                            <span class="pagination-info">@((currentPage - 1) * pageSize + 1)-@Math.Min(currentPage * pageSize, totalCount) din @totalCount</span>
                            <div class="pagination-buttons">
                                <SfButton CssClass="e-flat e-small" IconCss="bi bi-chevron-left" 
                                          Disabled="@(currentPage <= 1)" @onclick="PreviousPage"></SfButton>
                                <SfButton CssClass="e-flat e-small" IconCss="bi bi-chevron-right" 
                                          Disabled="@(currentPage * pageSize >= totalCount)" @onclick="NextPage"></SfButton>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        
        @* Right Panel - Details *@
        <div class="detail-panel">
            @if (selectedPartner == null)
            {
                <div class="empty-state">
                    <i class="bi bi-cursor-fill"></i>
                    <h4>Selectați un partener</h4>
                    <p>Alegeți un partener din listă pentru a vedea și edita detaliile</p>
                </div>
            }
            else if (isLoadingDetails)
            {
                <div class="loading-state">
                    <SfSpinner Type="SpinnerType.Bootstrap5" />
                    <span>Se încarcă detaliile...</span>
                </div>
            }
            else if (selectedPartnerDetails != null)
            {
                <PartnerDetailPanel Partner="@selectedPartnerDetails"
                                    OnEdit="EditPartner"
                                    OnDelete="DeletePartner"
                                    OnVerifyAnaf="VerifyAnaf"
                                    IsVerifyingAnaf="@isVerifyingAnaf"
                                    OnAddAddress="ShowAddAddressDialog"
                                    OnEditAddress="ShowEditAddressDialog"
                                    OnDeleteAddress="DeleteAddress"
                                    OnAddContact="ShowAddContactDialog"
                                    OnEditContact="ShowEditContactDialog"
                                    OnDeleteContact="DeleteContact"
                                    OnAddBankAccount="ShowAddBankAccountDialog"
                                    OnEditBankAccount="ShowEditBankAccountDialog"
                                    OnDeleteBankAccount="DeleteBankAccount"
                                    OnAddRepresentative="ShowAddRepresentativeDialog"
                                    OnEditRepresentative="ShowEditRepresentativeDialog"
                                    OnDeleteRepresentative="DeleteRepresentative" />
            }
        </div>
    </div>
</div>

@* Dialogs *@
<PartnerDialog @bind-IsVisible="partnerDialogVisible"
               IsEdit="@(!isNewPartner)"
               Model="@partnerDialogModel"
               OwnerEntityDisplay="@(selectedPartner?.OwnerEntityDisplay)"
               OnSave="OnPartnerSaved"
               OnVerifyAnaf="OnVerifyAnafFromDialog"
               IsLoadingAnaf="@isLoadingAnafInDialog"
               AnafMessage="@anafDialogMessage"
               AnafErrorMessage="@anafDialogErrorMessage" />

<PartnerAddressDialog @bind-IsVisible="addressDialogVisible"
                      IsEdit="@(editingAddress?.Id != Guid.Empty)"
                      Model="@(editingAddress ?? new())"
                      OnSave="OnAddressSaved" />

<PartnerContactDialog @bind-IsVisible="contactDialogVisible"
                      IsEdit="@(editingContact?.Id != Guid.Empty)"
                      Model="@(editingContact ?? new())"
                      OnSave="OnContactSaved" />

<PartnerBankAccountDialog @bind-IsVisible="bankAccountDialogVisible"
                          IsEdit="@(editingBankAccount?.Id != Guid.Empty)"
                          Model="@(editingBankAccount ?? new())"
                          OnSave="OnBankAccountSaved" />

<PartnerRepresentativeDialog @bind-IsVisible="representativeDialogVisible"
                             IsEdit="@(editingRepresentative?.Id != Guid.Empty)"
                             Model="@(editingRepresentative ?? new())"
                             OnSave="OnRepresentativeSaved" />

<ConfirmDialog @bind-IsVisible="confirmDialogVisible"
               Title="@confirmDialogTitle"
               Message="@confirmDialogMessage"
               CssClass="delete-confirm-dialog"
               ConfirmButtonClass="e-danger"
               OnConfirm="OnConfirmDialogConfirm" />

@* ANAF Compare Dialog *@
<AnafCompareDialog @bind-IsVisible="anafCompareDialogVisible"
                   IsLoading="@isVerifyingAnaf"
                   ErrorMessage="@anafErrorMessage"
                   AnafData="@anafCacheData"
                   CUI="@anafVerifyCUI"
                   DataSource="@anafDataSource"
                   ErpDenumire="@anafErpDenumire"
                   ErpAdresa="@anafErpAdresa"
                   ErpLocalitate="@anafErpLocalitate"
                   ErpJudet="@anafErpJudet"
                   ErpRegCom="@anafErpRegCom"
                   ErpTelefon="@anafErpTelefon"
                   ErpPlatitorTVA="@anafErpPlatitorTVA"
                   ErpDataTVA="@anafErpDataTVA"
                   ErpSplitTVA="@anafErpSplitTVA"
                   ErpInactiv="@anafErpInactiv"
                   OnApplyData="ApplyAnafDataToPartner"
                   OnRefresh="RefreshAnafData" />
