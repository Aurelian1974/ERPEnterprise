@page "/administrare/societatea-proprie"
@attribute [Authorize]
@rendermode InteractiveServer

@using ValyanERP.Web.Features.Administrare.SocietateaProprie.Models
@using ValyanERP.Web.Features.Administrare.SocietateaProprie.Models.Enums
@using ValyanERP.Web.Features.Administrare.SocietateaProprie.Services
@using ValyanERP.Web.Components.Shared
@using ValyanERP.Web.Components.Pages.Administrare.SocietateaProprieComponents
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Spinner

<PageTitle>Societatea Proprie - ValyanERP</PageTitle>

<div class="organization-page">
    @* Page Header *@
    <div class="page-header">
        <div class="header-content">
            <h3 class="page-title">
                <i class="bi bi-building me-2"></i>Societatea Proprie
            </h3>
            <span class="page-subtitle">Gestionarea structurii organizaționale</span>
        </div>
        <div class="header-actions">
            <SfButton CssClass="e-outline e-primary" IconCss="bi bi-folder-plus" @onclick="ShowAddGroupDialog">
                Grup Nou
            </SfButton>
            <SfButton CssClass="e-primary" IconCss="bi bi-bank" @onclick="() => ShowAddCompanyDialog()">
                Companie Nouă
            </SfButton>
        </div>
    </div>

    @* Main Content *@
    <div class="organization-container">
        @* Left Panel - TreeView *@
        <div class="tree-panel">
            <div class="tree-header">
                <SfTextBox Placeholder="Caută în structură..." 
                           CssClass="tree-search"
                           @bind-Value="searchTerm"
                           ShowClearButton="true" />
                <SfButton CssClass="e-flat e-icon-btn" IconCss="bi bi-arrow-clockwise" 
                          @onclick="RefreshTree" title="Reîncarcă structura">
                </SfButton>
            </div>
            
            <div class="tree-content">
                @if (isLoading)
                {
                    <div class="tree-loading">
                        <SfSpinner Type="SpinnerType.Bootstrap5" />
                        <span>Se încarcă structura...</span>
                    </div>
                }
                else if (treeNodes == null || !treeNodes.Any())
                {
                    <div class="tree-empty">
                        <i class="bi bi-building-x"></i>
                        <p>Nu există date în structura organizațională.</p>
                        <SfButton CssClass="e-primary" @onclick="() => ShowAddCompanyDialog()">
                            Adaugă prima companie
                        </SfButton>
                    </div>
                }
                else
                {
                    <SfTreeView TValue="OrganizationTreeNode"
                                @ref="treeView"
                                ShowCheckBox="false"
                                AllowDragAndDrop="false"
                                AllowEditing="false"
                                ExpandOn="ExpandAction.Click"
                                CssClass="organization-tree">
                        <TreeViewFieldsSettings TValue="OrganizationTreeNode"
                                                Id="NodeId"
                                                ParentID="ParentId"
                                                Text="Denumire"
                                                HasChildren="HasChildren"
                                                Expanded="IsExpanded"
                                                DataSource="@flatTreeNodes">
                        </TreeViewFieldsSettings>
                        <TreeViewTemplates TValue="OrganizationTreeNode">
                            <NodeTemplate>
                                @{
                                    var node = context as OrganizationTreeNode;
                                }
                                <div class="tree-node @node?.NodeClass" @onclick="() => SelectNode(node)" @onclick:stopPropagation="true">
                                    <i class="@node?.Icon node-icon"></i>
                                    <span class="node-text">@node?.Denumire</span>
                                    @if (node?.NodeType == "LOCATION")
                                    {
                                        <span class="node-badges">
                                            @if (node.HasStock)
                                            {
                                                <span class="badge bg-info" title="Gestionează stoc">S</span>
                                            }
                                            @if (node.CanSell)
                                            {
                                                <span class="badge bg-success" title="Vânzare">V</span>
                                            }
                                            @if (node.CanPurchase)
                                            {
                                                <span class="badge bg-warning" title="Achiziție">A</span>
                                            }
                                        </span>
                                    }
                                </div>
                            </NodeTemplate>
                        </TreeViewTemplates>
                        <TreeViewEvents TValue="OrganizationTreeNode"
                                        NodeSelected="OnNodeSelected">
                        </TreeViewEvents>
                    </SfTreeView>
                }
            </div>
        </div>
        
        @* Right Panel - Details *@
        <div class="detail-panel">
            @if (selectedNode == null)
            {
                <div class="empty-state">
                    <i class="bi bi-cursor-fill"></i>
                    <h4>Selectați un element</h4>
                    <p>Alegeți un element din structura organizațională pentru a vedea detaliile</p>
                </div>
            }
            else
            {
                <div class="detail-content">
                    @switch (selectedNode.NodeType)
                    {
                        case "GROUP":
                            <GroupDetailPanel Group="@selectedGroup" 
                                              OnEdit="EditGroup"
                                              OnDelete="DeleteGroup"
                                              OnAddCompany="() => ShowAddCompanyDialog(selectedGroup?.Id)" />
                            break;
                        case "COMPANY":
                            <CompanyDetailPanel Company="@selectedCompany"
                                                OnEdit="EditCompany"
                                                OnDelete="DeleteCompany"
                                                OnAddWorkPlace="() => ShowAddWorkPlaceDialog(selectedCompany?.Id)"
                                                OnAddLocation="() => ShowAddLocationDialog(selectedCompany?.Id, null)" />
                            break;
                        case "WORKPLACE":
                            <WorkPlaceDetailPanel WorkPlace="@selectedWorkPlace"
                                                  OnEdit="EditWorkPlace"
                                                  OnDelete="DeleteWorkPlace"
                                                  OnAddLocation="() => ShowAddLocationDialog(selectedWorkPlace?.CompanyId, selectedWorkPlace?.Id)" />
                            break;
                        case "LOCATION":
                            <LocationDetailPanel Location="@selectedLocation"
                                                 OnEdit="EditLocation"
                                                 OnDelete="DeleteLocation" />
                            break;
                    }
                </div>
            }
        </div>
    </div>
</div>

@* Dialogs *@
<CompanyGroupDialog @bind-IsVisible="groupDialogVisible" 
                    EditModel="@editingGroup"
                    OnSaved="OnGroupSaved" />

<CompanyDialog @bind-IsVisible="companyDialogVisible" 
               EditModel="@editingCompany"
               PreselectedGroupId="@preselectedGroupId"
               AvailableGroups="@groups"
               AvailableParentCompanies="@companies"
               OnSaved="OnCompanySaved" />

<WorkPlaceDialog @bind-IsVisible="workPlaceDialogVisible"
                 EditModel="@editingWorkPlace"
                 PreselectedCompanyId="@preselectedCompanyId"
                 AvailableCompanies="@companies"
                 OnSaved="OnWorkPlaceSaved" />

<LocationDialog @bind-IsVisible="locationDialogVisible"
                EditModel="@editingLocation"
                PreselectedCompanyId="@preselectedCompanyId"
                PreselectedWorkPlaceId="@preselectedWorkPlaceId"
                AvailableCompanies="@companies"
                AvailableWorkPlaces="@workPlaces"
                OnSaved="OnLocationSaved" />

<ConfirmDialog @bind-IsVisible="confirmDialogVisible"
               Title="@confirmDialogTitle"
               Message="@confirmDialogMessage"
               CssClass="@confirmDialogCssClass"
               ConfirmButtonClass="@confirmButtonClass"
               OnConfirm="OnConfirmDialogConfirm" />
