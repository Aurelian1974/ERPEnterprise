@page "/administrare/utilizatori"
@attribute [Authorize]

<PageTitle>Administrare Utilizatori - ValyanERP</PageTitle>

<h3><i class="bi bi-people me-2"></i>Administrare Utilizatori</h3>

<p class="text-muted">Gestionează utilizatorii sistemului.</p>

<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <span>Lista Utilizatori</span>
            <button class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i> Adaugă Utilizator
            </button>
        </div>
    </div>
    <div class="card-body">
        <p class="text-muted">Niciun utilizator de afișat momentan.</p>
    </div>
</div>
