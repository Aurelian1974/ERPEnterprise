@using ValyanERP.Web.Features.Achizitii.Models
@using ValyanERP.Web.Features.Administrare.Parteneri.Models
@using ValyanERP.Web.Features.Administrare.Articole.Models
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Calendars

<SfDialog @ref="dialog"
          Width="900px"
          Height="700px"
          IsModal="true"
          ShowCloseIcon="true"
          AllowDragging="true"
          @bind-Visible="IsVisible">

    <DialogTemplates>
        <Header>
            <div class="dialog-header">
                <i class="bi bi-receipt me-2"></i>
                @(IsEditMode ? "Editare Factură Achiziție" : "Adăugare Factură Achiziție")
            </div>
        </Header>
        <Content>
            @if (invoiceDto != null)
            {
                <EditForm Model="invoiceDto" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-container">
                        <div class="row">
                            <div class="col-md-6">
                                @* Document Section *@
                                <div class="form-section">
                                    <h5 class="section-title">
                                        <i class="bi bi-file-earmark-text me-2"></i>Date Document
                                    </h5>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <SfTextBox @bind-Value="invoiceDto.DocumentNumber"
                                                           Placeholder="Număr document"
                                                           FloatLabelType="FloatLabelType.Auto">
                                                </SfTextBox>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <SfDropDownList TValue="DocumentState"
                                                                TItem="DocumentState"
                                                                @bind-Value="selectedDocumentState"
                                                                DataSource="DocumentStates"
                                                                Placeholder="Stare document"
                                                                FloatLabelType="FloatLabelType.Auto">
                                                    <DropDownListFieldSettings Value="CodStare" Text="DenumireStare"></DropDownListFieldSettings>
                                                </SfDropDownList>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <SfDatePicker @bind-Value="invoiceDto.DocumentDate"
                                                              Placeholder="Data document"
                                                              FloatLabelType="FloatLabelType.Auto">
                                                </SfDatePicker>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <SfDatePicker @bind-Value="invoiceDto.DueDate"
                                                              Placeholder="Data scadență (opțional)"
                                                              FloatLabelType="FloatLabelType.Auto">
                                                </SfDatePicker>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <SfTextBox @bind-Value="invoiceDto.DocumentObservations"
                                                   Placeholder="Observații document"
                                                   Multiline="true"
                                                   FloatLabelType="FloatLabelType.Auto">
                                        </SfTextBox>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                @* Partner Section *@
                                <div class="form-section">
                                    <h5 class="section-title">
                                        <i class="bi bi-building me-2"></i>Partener
                                    </h5>

                                    <div class="form-group">
                                        <SfDropDownList TValue="Partner"
                                                        TItem="Partner"
                                                        Value="selectedPartner"
                                                        ValueChange="OnPartnerChanged"
                                                        DataSource="Partners"
                                                        Placeholder="Selectați partenerul"
                                                        FloatLabelType="FloatLabelType.Auto">
                                            <DropDownListFieldSettings Value="Id" Text="Nume"></DropDownListFieldSettings>
                                            <DropDownListEvents TValue="Partner" TItem="Partner" ValueChange="OnPartnerChanged"></DropDownListEvents>
                                        </SfDropDownList>
                                    </div>

                                    @if (partnerAddressesByType != null && partnerAddressesByType.Any())
                                    {
                                        <div class="addresses-section mb-2">
                                            @foreach (var kv in partnerAddressesByType)
                                            {
                                                var tip = kv.Key;
                                                var list = kv.Value;
                                                <div class="address-group mb-2">
                                                    <label class="form-label">@tip.ToString()</label>
                                                    @if (list.Count == 1)
                                                    {
                                                        <div class="address-line">@list.First().AdresaCompleta</div>
                                                    }
                                                    else
                                                    {
                                                        <SfDropDownList TValue="Guid?"
                                                                        TItem="PartnerAddress"
                                                                        DataSource="list"
                                                                        Value="@(selectedAddressByType.ContainsKey(tip) ? selectedAddressByType[tip] : (Guid?)null)"
                                                                        Placeholder="Selectați adresă">
                                                            <DropDownListFieldSettings Value="Id" Text="AdresaCompleta"></DropDownListFieldSettings>
                                                            <DropDownListEvents TValue="Guid?" TItem="PartnerAddress" ValueChange="@(args => OnAddressSelected(tip, args))"></DropDownListEvents>
                                                        </SfDropDownList>
                                                    }
                                                </div>
                                            }

                                            @* Partner contacts *@
                                            @if (partnerContacts != null && partnerContacts.Any())
                                            {
                                                @if (partnerContacts.Count() == 1)
                                                {
                                                    var only = partnerContacts.First();
                                                    <div class="form-group mt-2">
                                                        <label class="form-label">Contact</label>
                                                        <div class="contact-line">@only.NumeComplet</div>
                                                        <div class="row mt-2">
                                                            <div class="col-md-6">
                                                                <label class="form-label">Email contact</label>
                                                                <SfTextBox Value="@(only.Email ?? string.Empty)" Enabled="false"></SfTextBox>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label">Telefon contact</label>
                                                                <SfTextBox Value="@((only.TelefonMobil ?? only.Telefon) ?? string.Empty)" Enabled="false"></SfTextBox>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="form-group mt-2">
                                                        <label class="form-label">Contact</label>
                                                        <SfDropDownList TValue="Guid?"
                                                                        TItem="PartnerContact"
                                                                        DataSource="partnerContacts"
                                                                        Value="selectedPartnerContactId">
                                                            <DropDownListFieldSettings Value="Id" Text="NumeComplet"></DropDownListFieldSettings>
                                                            <DropDownListEvents TValue="Guid?" TItem="PartnerContact" ValueChange="OnContactSelected"></DropDownListEvents>
                                                        </SfDropDownList>
                                                    </div>

                                                    @if (partnerContacts?.FirstOrDefault(c => c.Id == selectedPartnerContactId) is var selContact && selContact != null)
                                                    {
                                                        <div class="row mt-2">
                                                            <div class="col-md-6">
                                                                <label class="form-label">Email contact</label>
                                                                <SfTextBox Value="@(selContact.Email ?? string.Empty)" Enabled="false"></SfTextBox>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label">Telefon contact</label>
                                                                <SfTextBox Value="@((selContact.TelefonMobil ?? selContact.Telefon) ?? string.Empty)" Enabled="false"></SfTextBox>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            }

                                            @* Partner bank accounts *@
                                            @if (partnerBankAccounts != null && partnerBankAccounts.Any())
                                            {
                                                @if (partnerBankAccounts.Count() == 1)
                                                {
                                                    var onlyBank = partnerBankAccounts.First();
                                                    <div class="form-group mt-2">
                                                        <label class="form-label">Cont bancar</label>
                                                        <div class="bank-line">@onlyBank.IBANFormatat</div>
                                                        <div class="row mt-2">
                                                            <div class="col-md-4">
                                                                <label class="form-label">Banca</label>
                                                                <div class="bank-info">@onlyBank.NumeBanca</div>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <label class="form-label">Sucursala</label>
                                                                <div class="bank-info">@onlyBank.Sucursala</div>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <label class="form-label">Moneda</label>
                                                                <div class="bank-info">@onlyBank.Moneda</div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="form-group mt-2">
                                                        <label class="form-label">Cont bancar</label>
                                                        <SfDropDownList TValue="Guid?"
                                                                        TItem="PartnerBankAccount"
                                                                        DataSource="partnerBankAccounts"
                                                                        Value="selectedPartnerBankAccountId">
                                                            <DropDownListFieldSettings Value="Id" Text="IBANFormatat"></DropDownListFieldSettings>
                                                            <DropDownListEvents TValue="Guid?" TItem="PartnerBankAccount" ValueChange="OnBankAccountSelected"></DropDownListEvents>
                                                        </SfDropDownList>
                                                    </div>

                                                    @if (partnerBankAccounts?.FirstOrDefault(b => b.Id == selectedPartnerBankAccountId) is var selBank && selBank != null)
                                                    {
                                                        <div class="row mt-2">
                                                            <div class="col-md-4">
                                                                <label class="form-label">Banca</label>
                                                                <div class="bank-info">@selBank.NumeBanca</div>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <label class="form-label">Sucursala</label>
                                                                <div class="bank-info">@selBank.Sucursala</div>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <label class="form-label">Moneda</label>
                                                                <div class="bank-info">@selBank.Moneda</div>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            }
                                        </div>
                                    }

                                    <div class="form-group">
                                        <SfTextBox @bind-Value="invoiceDto.InvoiceObservations"
                                                   Placeholder="Observații factură"
                                                   Multiline="true"
                                                   FloatLabelType="FloatLabelType.Auto">
                                        </SfTextBox>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* Line Items Section *@
                        <div class="form-section">
                            <h5 class="section-title">
                                <i class="bi bi-list-ul me-2"></i>Linii Factură
                            </h5>

                            @if (invoiceDto.LineItems.Any())
                            {
                                <div class="line-items-table">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Articol</th>
                                                <th>Cantitate</th>
                                                <th>UM</th>
                                                <th>Preț Unit.</th>
                                                <th>Cota TVA</th>
                                                <th>Total</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var (item, index) in invoiceDto.LineItems.Select((item, i) => (item, i)))
                                            {
                                                <tr>
                                                    <td>
                                                        <SfDropDownList TValue="Guid"
                                                                        TItem="Articol"
                                                                        @bind-Value="item.ItemId"
                                                                        DataSource="Articole"
                                                                        Placeholder="Articol">
                                                            <DropDownListFieldSettings Value="Id" Text="ArticolName"></DropDownListFieldSettings>
                                                        </SfDropDownList>
                                                    </td>
                                                    <td>
                                                        <SfNumericTextBox TValue="decimal"
                                                                          @bind-Value="item.Quantity"
                                                                          Min="0.01m"
                                                                          Decimals="2">
                                                        </SfNumericTextBox>
                                                    </td>
                                                    <td>
                                                        <SfTextBox @bind-Value="item.UnitMeasure"
                                                                   Placeholder="UM">
                                                        </SfTextBox>
                                                    </td>
                                                    <td>
                                                        <SfNumericTextBox TValue="decimal"
                                                                          @bind-Value="item.UnitPrice"
                                                                          Min="0m"
                                                                          Decimals="2">
                                                        </SfNumericTextBox>
                                                    </td>
                                                    <td>
                                                        <SfNumericTextBox TValue="decimal"
                                                                          @bind-Value="item.VATRate"
                                                                          Min="0m"
                                                                          Max="100m"
                                                                          Decimals="2">
                                                        </SfNumericTextBox>
                                                    </td>
                                                    <td>@CalculateLineTotal(item).ToString("N2")</td>
                                                    <td>
                                                        <SfButton @onclick="() => RemoveLineItem(index)"
                                                                  CssClass="e-outline e-danger"
                                                                  Size="ButtonSize.Small">
                                                            <i class="bi bi-trash"></i>
                                                        </SfButton>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            <SfButton @onclick="AddLineItem" CssClass="e-outline e-success">
                                <i class="bi bi-plus-circle me-2"></i>Adaugă Linie
                            </SfButton>
                        </div>
                    </div>
                </EditForm>
            }
        </Content>
        <FooterTemplate>
            <div class="dialog-footer">
                <SfButton @onclick="HandleCancel" CssClass="e-outline">Anulează</SfButton>
                <SfButton @onclick="HandleValidSubmit" CssClass="e-primary" Type="ButtonType.Submit">
                    <i class="bi bi-check-circle me-2"></i>Salvează
                </SfButton>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>
