@rendermode InteractiveServer
@page "/rapoarte/stoc"
@using ValyanERP.Web.Features.Rapoarte.Stoc.Models
@inject Microsoft.JSInterop.IJSRuntime JS

<h3>Raport Stoc</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="Load">Încarcă</button>
    <span class="ms-2 text-muted">(filtre vor fi adăugate ulterior)</span>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<script>
    window.fetchWithCredentials = (url) => {
        return fetch(url, { credentials: 'same-origin' }).then(response => {
            if (!response.ok) throw new Error(response.statusText || 'Network error');
            return response.text();
        });
    };
</script>

@if (items == null)
{
    <p>Apăsați 'Încarcă' pentru a afișa datele.</p>
}
else
{
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                <th>Cod</th>
                <th>Denumire</th>
                <th class="text-end">Cantitate</th>
                <th class="text-end">Valoare</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var it in items)
            {
                <tr>
                    <td>@it.Cod</td>
                    <td>@it.Denumire</td>
                    <td class="text-end">@it.Cantitate</td>
                    <td class="text-end">@it.Valoare</td>
                </tr>
            }
        </tbody>
    </table>
}
