@page "/syncfusion-grid-demo"

<PageTitle>Syncfusion Grid Demo</PageTitle>

<h3>Syncfusion Grid (SfGrid)</h3>

<SfGrid DataSource="orders" AllowPaging="true" Width="100%">
    <GridColumns>
        <GridColumn Field="OrderId" HeaderText="Order ID" Width="120" TextAlign="TextAlign.Center"></GridColumn>
        <GridColumn Field="Customer" HeaderText="Customer" Width="200"></GridColumn>
        <GridColumn Field="Amount" HeaderText="Amount" Format="C2" Width="150" TextAlign="TextAlign.Right"></GridColumn>
    </GridColumns>
</SfGrid>

@code {
    public class Order { public int OrderId { get; set; } public string Customer { get; set; } = ""; public decimal Amount { get; set; } }

    private List<Order> orders = new List<Order>
    {
        new Order { OrderId = 1001, Customer = "Contoso", Amount = 1234.56m },
        new Order { OrderId = 1002, Customer = "Fabrikam", Amount = 789.00m },
        new Order { OrderId = 1003, Customer = "Adventure Co", Amount = 456.78m }
    };
}