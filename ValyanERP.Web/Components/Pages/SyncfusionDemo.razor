@page "/syncfusion-demo"
@attribute [Authorize]
@rendermode InteractiveServer
@using ValyanERP.Web.Infrastructure.Time
@using Microsoft.AspNetCore.Components

<PageTitle>Syncfusion Demo</PageTitle>

<h3>Syncfusion Demo</h3>

<section class="mb-4">
    <h5>SfButton</h5>
    <SfButton CssClass="e-primary" OnClick="OnClick">Click me</SfButton>
    <p>@message</p>
</section>

<section class="mb-4">
    <h5>SfGrid (DataGrid)  Paging & Sorting</h5>
    <div class="mb-2"><small>Rows: <strong>@GridData.Count</strong></small></div>
    <SfGrid DataSource="@GridData" AllowPaging="true" AllowSorting="true" Width="100%" Height="320px">
        <GridPageSettings PageSize="10"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="Id" HeaderText="ID" Width="80" TextAlign="TextAlign.Center" AllowSorting="true"></GridColumn>
            <GridColumn Field="Name" HeaderText="Name" Width="200" AllowSorting="true"></GridColumn>
            <GridColumn Field="Category" HeaderText="Category" Width="150" AllowFiltering="true"></GridColumn>
            <GridColumn Field="Value" HeaderText="Value" Format="C2" Width="120" TextAlign="TextAlign.Right" AllowSorting="true"></GridColumn>
            <GridColumn Field="Date" HeaderText="Date" Format="d" Width="140" TextAlign="TextAlign.Center" AllowSorting="true"></GridColumn>
        </GridColumns>
    </SfGrid>
</section>

<section class="mb-4">
    <h5>SfTreeGrid (sample)</h5>
    <SfTreeGrid DataSource="@TreeData" ChildMapping="Children" TreeColumnIndex="1" Height="320px">
        <TreeGridColumns>
            <TreeGridColumn Field="Id" HeaderText="ID" Width="80"></TreeGridColumn>
            <TreeGridColumn Field="Name" HeaderText="Task Name"></TreeGridColumn>
            <TreeGridColumn Field="Progress" HeaderText="Progress" Width="120" TextAlign="TextAlign.Center"></TreeGridColumn>
        </TreeGridColumns>
    </SfTreeGrid>
</section>

<section class="mb-4">
    <h5>SfChart  Multi-series</h5>
    <div class="mb-2"><small>Series points: <strong>@ChartSeries1.Count</strong> / @ChartSeries2.Count / @ChartSeries3.Count</small></div>
    <SfChart Title="Metrics over Time" Height="360px">
        <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category"></ChartPrimaryXAxis>
        <ChartSeriesCollection>
            <ChartSeries DataSource="@ChartSeries1" XName="Label" YName="Value" Name="Series A" Type="Syncfusion.Blazor.Charts.ChartSeriesType.Line"></ChartSeries>
            <ChartSeries DataSource="@ChartSeries2" XName="Label" YName="Value" Name="Series B" Type="Syncfusion.Blazor.Charts.ChartSeriesType.Line"></ChartSeries>
            <ChartSeries DataSource="@ChartSeries3" XName="Label" YName="Value" Name="Series C" Type="Syncfusion.Blazor.Charts.ChartSeriesType.Line"></ChartSeries>
        </ChartSeriesCollection>
        <ChartLegendSettings Visible="true"></ChartLegendSettings>
    </SfChart>
</section>

<section class="mb-4">
    <h5>SfSchedule (Scheduler)  Events</h5>
    <div class="mb-2"><small>Events: <strong>@Appointments.Count</strong></small></div>
    <SfSchedule TValue="DemoAppointment" Width="100%" Height="500px">
        <ScheduleEventSettings DataSource="@Appointments"></ScheduleEventSettings>
    </SfSchedule>
</section>

<section class="mb-4">
    <h5>SfPivotView  Complete (mock data)</h5>
    <div class="mb-2"><small>Rows: <strong>@PivotData.Count</strong></small></div>
    <SfPivotView TValue="object">
        <PivotViewDataSourceSettings DataSource="@PivotData">
            <PivotViewRows>
                <PivotViewRow Name="Category"></PivotViewRow>
            </PivotViewRows>
            <PivotViewColumns>
                <PivotViewColumn Name="Region"></PivotViewColumn>
            </PivotViewColumns>
            <PivotViewValues>
                <PivotViewValue Name="Sales"></PivotViewValue>
            </PivotViewValues>
        </PivotViewDataSourceSettings>
    </SfPivotView>
</section>

<section class="mb-4">
    <h5>Debug helpers</h5>
    <p class="small">If counts above are zero but you expect data, check the browser console for JS errors and the Network tab for 404s to <code>_content/Syncfusion.Blazor/scripts/*.js</code>. If counts are non-zero but components look empty, paste console logs or screenshots and I'll debug further.</p>
</section>

@code {
    private string message = "Not clicked";
    private void OnClick() => message = "Button clicked at " + ValyanERP.Web.Infrastructure.Time.TimeUtils.NowRomania().ToString("T");

    // Grid data
    public class GridItem { public int Id { get; set; } public string Name { get; set; } = ""; public string Category { get; set; } = ""; public decimal Value { get; set; } public DateTime Date { get; set; } }
    public List<GridItem> GridData { get; set; } = new();

    // TreeGrid data
    public class TreeItem { public int Id { get; set; } public string Name { get; set; } = ""; public int Progress { get; set; } public List<TreeItem>? Children { get; set; } }
    public List<TreeItem> TreeData { get; set; } = new();

    // Chart data
    public class ChartPoint { public string Label { get; set; } = ""; public double Value { get; set; } }
    public List<ChartPoint> ChartSeries1 { get; set; } = new();
    public List<ChartPoint> ChartSeries2 { get; set; } = new();
    public List<ChartPoint> ChartSeries3 { get; set; } = new();

    // Scheduler data
    public class DemoAppointment { public int Id { get; set; } public string Subject { get; set; } = ""; public DateTime StartTime { get; set; } public DateTime EndTime { get; set; } public bool IsAllDay { get; set; } }
    public List<DemoAppointment> Appointments { get; set; } = new();

    // Pivot data
    public List<object> PivotData { get; set; } = new();

    protected override void OnInitialized()
    {
        // Init Grid
        GridData = Enumerable.Range(1, 100).Select(i => new GridItem
        {
            Id = i,
            Name = $"Item {i}",
            Category = i % 5 == 0 ? "Services" : (i % 3 == 0 ? "Hardware" : "Software"),
            Value = Math.Round((decimal)(new Random(i).NextDouble() * 1000), 2),
            Date = DateTime.Today.AddDays(-i)
        }).ToList();

        // Init Tree
        TreeData = new List<TreeItem>
        {
            new TreeItem{ Id = 1, Name = "Project A", Progress = 45, Children = new List<TreeItem>{ new TreeItem{ Id=11, Name="Design", Progress=60}, new TreeItem{ Id=12, Name="Dev", Progress=30}} },
            new TreeItem{ Id = 2, Name = "Project B", Progress = 80 }
        };

        // Init Chart
        ChartSeries1 = Enumerable.Range(1, 100).Select(i => new ChartPoint { Label = i.ToString(), Value = Math.Round(50 + Math.Sin(i / 10.0) * 20 + new Random(i).NextDouble() * 10, 2) }).ToList();
        ChartSeries2 = Enumerable.Range(1, 100).Select(i => new ChartPoint { Label = i.ToString(), Value = Math.Round(30 + Math.Cos(i / 12.0) * 15 + new Random(i + 1).NextDouble() * 8, 2) }).ToList();
        ChartSeries3 = Enumerable.Range(1, 100).Select(i => new ChartPoint { Label = i.ToString(), Value = Math.Round(10 + Math.Sin(i / 8.0) * 10 + new Random(i + 2).NextDouble() * 5, 2) }).ToList();

        // Init Scheduler
        Appointments = GenerateAppointments(100);

        // Init Pivot
        PivotData = Enumerable.Range(1, 100).Select(i => new
        {
            Category = i % 4 == 0 ? "Beverages" : (i % 3 == 0 ? "Snacks" : "Office"),
            Region = (i % 5 == 0) ? "South" : (i % 2 == 0 ? "North" : "East"),
            Sales = Math.Round(new Random(i).NextDouble() * 1000, 2),
            Quantity = new Random(i + 1).Next(1, 20)
        }).Cast<object>().ToList();
    }

    private static List<DemoAppointment> GenerateAppointments(int count)
    {
        var list = new List<DemoAppointment>();
        var rand = new Random(12345);
        for (int i = 1; i <= count; i++)
        {
            var offset = rand.Next(0, 30);
            var start = DateTime.Today.AddDays(offset).AddHours(rand.Next(8, 17)).AddMinutes(rand.Next(0, 60));
            list.Add(new DemoAppointment { Id = i, Subject = $"Event {i}", StartTime = start, EndTime = start.AddHours(1), IsAllDay = false });
        }
        return list;
    }
}
